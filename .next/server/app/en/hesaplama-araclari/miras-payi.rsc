12:["$","$L27",null,{"formats":{"dateTime":{"long":{"day":"numeric","month":"long","year":"numeric","numberingSystem":"latn"},"short":{"day":"2-digit","month":"2-digit","year":"numeric","numberingSystem":"latn"}}},"locale":"en","messages":{"site":{"attorney":"Burak Uğur Öztürk, Attorney at Law","attorneyShort":"Burak Uğur Öztürk","role":"Attorney at Law","monogramLabel":"Burak Uğur Öztürk — home"},"nav":{"primary":"Main menu","home":"Home","practiceAreas":"Practice Areas","profile":"Profile","articles":"Articles","contact":"Contact","openMenu":"Open menu","closeMenu":"Close menu","skipToContent":"Skip to content","tools":"Tools","faq":"FAQ","regions":"Regions"},"locale":{"label":"Language","change":"Change language","current":"Selected language"},"home":{"meta":{"title":"Burak Uğur Öztürk, Attorney at Law","homeTitle":"Burak Uğur Öztürk, Attorney at Law | Esenyurt & Büyükçekmece Law Office","description":"A law practice in labour law, enforcement and bankruptcy, divorce and family law, tenancy, inheritance and corporate law; based in Esenyurt, serving Büyükçekmece and Beylikdüzü, in Turkish, English and Arabic."},"hero":{"label":"Esenyurt · Büyükçekmece · Beylikdüzü","title":"Legal support for individual and corporate disputes in and around Büyükçekmece.","registrationLabel":"Admission","languagesLabel":"Working Languages","languages":"Turkish · English · Arabic","focusLabel":"Practice Focus","focus":"Labour Law, Enforcement Law, Divorce and Family Law","regionsLabel":"Areas Served","lead":"Legal advice and litigation in labour law, enforcement and bankruptcy, divorce and family law, tenancy, inheritance and corporate law - based in Esenyurt, in Turkish, English and Arabic.","contact":"Contact","appointment":"Request an appointment"},"practice":{"label":"Practice Areas","title":"Fields of work","lead":"The headings below indicate the areas in which the practice works regularly.","all":"All practice areas"},"profile":{"label":"Profile","title":"About the practice","body":"The practice is built on working directly on a limited number of matters. Each instruction begins with an examination of the applicable legislation and current judicial practice; the assessment given to the client sets out the available options and the risks attaching to each of them plainly.","link":"View profile"},"articles":{"label":"Articles","title":"Recent writing","lead":"Notes on legislation and practice, written for general information.","all":"All articles"},"contact":{"label":"Contact","title":"Requesting a meeting","body":"To request a meeting about your matter, you may use the form on the contact page or reach the office directly.","link":"Contact page"}},"practiceAreas":{"is-hukuku":{"name":"Labour Law","summary":"Dismissal and reinstatement disputes, severance and notice pay, overtime and leave entitlements, and compensation claims arising from workplace accidents.","body":["The practice covers litigation and mediation on behalf of employees and employers in disputes over termination of the employment contract, and the calculation and pursuit of severance pay, notice pay, overtime, annual leave and other employee entitlements.","Support is also provided in material and non-material damages claims arising from workplace accidents and occupational disease, reinstatement lawsuits, and collective redundancy procedures.","For an employee's reinstatement claim on grounds of unjust dismissal, an application to mediation is mandatory within the statutory period after the termination notice is served; if no settlement is reached, litigation may follow. On the employer's side, care is needed to observe procedural requirements such as taking the employee's defence, keeping minutes, and serving a proper termination notice.","Proof of overtime, annual leave and other employee entitlements generally rests on written records, witness statements and workplace records; the severance, annual leave, overtime and unemployment-benefit calculators on this site can be used for an initial estimate of the amounts involved."]},"icra-hukuku":{"name":"Enforcement Law","summary":"Judgment-based and judgment-free enforcement proceedings, objections and their annulment, seizure procedures, and bankruptcy and composition proceedings.","body":["For both creditors and debtors, the practice covers initiating judgment-based and judgment-free enforcement proceedings, objecting to a payment order, and actions for the removal or annulment of an objection.","It also covers seizure and sale procedures, actions for negative declaration and restitution, and bankruptcy and composition (concordat) proceedings.","On the debtor's side, objecting to the enforcement office within the statutory period after service of the payment order halts the proceeding; the creditor may then pursue either removal of the objection (before the enforcement court) or its annulment (before the general court) to continue enforcement.","Seizure generally applies to the debtor's attachable movable and immovable property and receivables; certain assets and rights listed in law are exempt. Preparing the documents underlying the claim (contract, invoice, cheque/promissory note, judgment, etc.) in full at the outset is recommended."]},"bosanma-aile-hukuku":{"name":"Divorce and Family Law","summary":"Uncontested and contested divorce proceedings, alimony and compensation claims, division of matrimonial property, and custody and contact arrangements.","body":["The practice covers uncontested and contested divorce proceedings, drafting the divorce protocol, and pursuing alimony and material/moral compensation claims.","Support is also provided in claims for a participation receivable arising from the division of the matrimonial property regime, custody and contact arrangements, and actions to increase alimony.","In an uncontested divorce, the court must approve the protocol agreed between the parties on custody, alimony, compensation and property division; in a contested divorce, the claims must be supported by written evidence, witness statements and any other available evidence.","Custody and contact arrangements are decided in the child's best interest; the participation-receivable calculation in dividing the matrimonial property regime is based on assets acquired during the marriage. Drafting a power of attorney specific to the divorce process and planning the process in advance are recommended."]},"miras-hukuku":{"name":"Inheritance Law","summary":"Certificates of inheritance, identifying and dividing the estate, recovering an heir's share, and actions for abatement or disinheritance.","body":["The practice covers obtaining a certificate of inheritance, identifying and dividing the estate, and pursuing an heir's share against the other heirs.","It also covers actions for abatement, disinheritance, and disputes arising from inheritance contracts.","Disclaiming an inheritance is possible by applying to the civil court of peace within three months of learning of one's status as an heir; if that period is missed, the inheritance is, as a rule, deemed accepted unconditionally by the legal heirs.","Claims of collusive transfer to circumvent inheritance rights (\"muris muvazaası\"), actions for abatement, and requests among heirs for termination of co-ownership are also handled within this scope; the competent court and time limits depend on the specific facts of the file."]},"kira-hukuku":{"name":"Tenancy Law","summary":"Rent determination and increase disputes, eviction proceedings, enforcement based on a vacation commitment, and drafting lease agreements.","body":["The practice covers determining and adjusting the rent, disputes over the rate of rent increase, and drafting and reviewing lease agreements.","Support is also provided in enforcement proceedings based on a vacation commitment, eviction for default, and eviction actions based on the landlord's own housing need or reconstruction.","Eviction may be sought through enforcement, by first putting the tenant in default or relying on a vacation commitment, or through litigation on grounds set out in law such as the landlord's or a close relative's need for housing, or reconstruction/redevelopment - each ground has its own procedure and time limits.","In rent-adjustment and rent-determination cases, the twelve-month average CPI for the preceding period is assessed together with the lease terms; the rent-increase calculator on this site can be used to work out the applicable rate."]},"sirketler-hukuku":{"name":"Corporate Law","summary":"Incorporation and conversion, articles of association, capital increases, share transfers, shareholders' agreements and general assembly procedure.","body":["Work in this area begins at incorporation: choice of corporate form, drafting the articles of association, structuring share capital and completing registration.","After incorporation, the practice covers capital increases and reductions, share transfers, shareholders' agreements, general assembly and board procedures, and corporate conversions and mergers."]},"tahkim-ve-uyusmazlik-cozumu":{"name":"Arbitration and Dispute Resolution","summary":"Drafting arbitration clauses, institutional and ad hoc arbitration proceedings, enforcement of foreign arbitral awards, mediation and litigation.","body":["The practice covers drafting arbitration clauses, determining the seat and language of arbitration, and following institutional or ad hoc arbitration proceedings.","It also covers the enforcement of foreign arbitral awards in Türkiye, mediation, and dispute resolution through litigation."]},"kisisel-verilerin-korunmasi":{"name":"Data Protection","summary":"KVKK compliance work, information notices and explicit consent texts, data inventories, transfers abroad and data breach notifications.","body":["Under Law No. 6698, the practice covers identifying data controller obligations, preparing a data inventory, and drafting privacy notices and explicit consent texts.","Support is provided in structuring cross-border data transfers in line with the legislation and in data breach notification procedures."]}},"practiceAreasPage":{"meta":{"title":"Fields of Work","description":"Work is carried out in labour law, enforcement law, divorce and family law, inheritance law, tenancy law, corporate law, arbitration and dispute resolution, and data protection."},"label":"Fields of Work","title":"Fields of work","lead":"The headings below show the fields the practice regularly works in.","cta":"View details"},"practiceAreaDetail":{"back":"All fields of work","relatedLabel":"Related Articles","relatedEmpty":"No articles have been published in this field yet.","relatedToolsLabel":"Related Calculators","contactCta":"Get in touch"},"serviceRegions":{"buyukcekmece":{"name":"Büyükçekmece","summary":"Court process, the most common case types, and the documents worth preparing before a meeting, for disputes in and around Büyükçekmece.","body":["For many legal disputes arising in Esenyurt, Beylikdüzü, Çatalca and Büyükçekmece itself, the court with jurisdiction is generally the Büyükçekmece Courthouse; the competent court can vary by case type, so this is always confirmed for the specific matter.","The most common disputes from this area include employee entitlement and reinstatement claims, objections to enforcement proceedings and seizure, divorce and custody cases, rent-determination and eviction claims, and disputes arising from inheritance division.","Before a meeting, having identification, any existing contract or notice document, employment-related records (payslips, entry/exit declarations), or matter-specific documents such as title deeds or lease agreements ready makes the initial assessment faster."],"relatedAreas":["is-hukuku","icra-hukuku","bosanma-aile-hukuku","kira-hukuku","miras-hukuku"]},"beylikduzu":{"name":"Beylikdüzü","summary":"Disputes arising from residential and workplace relationships in Beylikdüzü, and meeting options.","body":["With its dense residential and workplace population, Beylikdüzü is an area where tenancy relationships, employment contract disputes and family-law matters are frequently seen; disputes arising here are also generally within the jurisdiction of the Büyükçekmece Courthouse.","As a tenant or landlord: eviction, rent-determination and deposit disputes; as an employee or employer: severance/notice pay and overtime claims; and objections to enforcement proceedings and seizure are among the matters most often raised from this area.","Meetings can be arranged in person at the office or remotely by video/phone call, depending on preference; preparing the relevant documents (lease agreement, payment records, employment contract, etc.) before the first meeting improves efficiency."],"relatedAreas":["kira-hukuku","is-hukuku","bosanma-aile-hukuku","icra-hukuku"]},"esenyurt":{"name":"Esenyurt","summary":"The office's actual Esenyurt address, access information, and individual and corporate client intake across every practice area.","body":["The office operates from Cumhuriyet Mahallesi, 1991. Sokak, Beycenter Residence, Esenyurt/Istanbul; individual and corporate clients are received by appointment, in person at the office or, on request, by video/phone call.","Across labour law, enforcement law, divorce and family law, tenancy law, inheritance law, corporate law, arbitration and data protection alike, both individual and corporate/foreign clients are served in Turkish, English and Arabic.","The address is reachable by public transport and by car; for the exact appointment time and directions, contacting the office beforehand by phone or WhatsApp (see the contact page) is recommended."],"relatedAreas":["is-hukuku","icra-hukuku","bosanma-aile-hukuku","kira-hukuku","miras-hukuku","sirketler-hukuku"]}},"serviceRegionsPage":{"meta":{"title":"Areas Served","description":"Legal support in Esenyurt, Büyükçekmece and Beylikdüzü, in labour law, enforcement law, divorce and family law, tenancy law and inheritance law."},"label":"Regions","title":"Areas served","lead":"The office's actual address is in Esenyurt; clients in Büyükçekmece and Beylikdüzü are served in the same practice areas."},"serviceRegionDetail":{"back":"All regions","relatedAreasLabel":"Related Practice Areas","contactCta":"Get in touch"},"profilePage":{"meta":{"title":"Profile","description":"Burak Uğur Öztürk, Attorney at Law — admitted to the Istanbul Bar Association. Working languages: Turkish, English and Arabic."},"label":"Profile","title":"Burak Uğur Öztürk, Attorney at Law","intro":"Burak Uğur Öztürk practises independently, admitted to the Istanbul Bar Association. The working languages are Turkish, English and Arabic, allowing direct communication with foreign investors and multinational parties.","portraitAlt":"Burak Uğur Öztürk, Attorney at Law","admissionLabel":"Bar Admission","languagesLabel":"Working Languages","languages":"Turkish, English, Arabic","approachTitle":"Approach","approachBody":["Every matter begins with a review of the applicable legislation and current case law. The assessment shared with the client sets out the available options, the risks attached to each, and the likely timeframes, in plain terms.","The number of open files is kept limited so that each matter receives adequate attention. Communication with the client follows a policy of regular updates at every stage of the process."],"scopeTitle":"Fields of Work","scopeLinkText":"View fields of work","contactCta":"Get in touch"},"articlesPage":{"meta":{"title":"Articles","description":"General informational articles on corporate law, foreign investment, real estate, commercial contracts, arbitration and data protection."},"label":"Articles","title":"Latest writing","lead":"General informational articles on legislation and practice. Filter the list below by category.","filterAll":"All","filterLabel":"Category","searchLabel":"Search articles","searchPlaceholder":"Keyword","searchSubmit":"Search","empty":"No articles match this filter.","prevPage":"Previous","nextPage":"Next","pageLabel":"Page {page} of {totalPages}"},"articleDetail":{"back":"Back to all articles","tocLabel":"Contents","relatedLabel":"Related Articles"},"toolsPage":{"meta":{"title":"Calculation Tools","description":"Informational calculators for severance pay, annual leave, overtime, unemployment benefit, rent increases, alimony, sentence execution and inheritance shares under Turkish law."},"label":"Tools","title":"Legal Calculation Tools","lead":"Informational calculators based on the legislation in force. What you type stays in your browser: nothing is stored or transmitted. The results do not replace an assessment of your own circumstances.","back":"All calculation tools","otherToolsLabel":"Other Tools"},"tools":{"form":{"inputsLabel":"Details","resultLabel":"Result","submit":"Calculate","reset":"Clear","idle":"Fill in the fields and press Calculate. What you type stays in your browser.","parametersUnverified":"The statutory figures used by this tool have not yet been checked against the current period. Confirm them against the official amounts before relying on the result.","privacyNote":"What you enter is processed in your browser only; no data is stored or sent."},"parameters":{"severanceCeilingPerYear":"Severance ceiling","minimumWageGrossMonthly":"Gross minimum wage","stampDutyRate":"Stamp duty rate"},"errors":{"missingFields":"Please complete all required fields.","invalidAmount":"The amount or number entered is not valid.","endBeforeStart":"The end date must fall after the start date.","serviceTooShort":"Severance pay requires at least one full year of service.","leaveNotYetAccrued":"Annual paid leave requires at least one full year of service.","invalidContractHours":"Contractual weekly hours must be between 1 and 45.","noOvertime":"The hours entered do not exceed the contractual working week, so no overtime arises.","premiumDaysTooLow":"At least 600 premium days in the last three years are required.","invalidRatio":"The ratio must be between 0 and 100.","invalidPeriod":"The period entered is not valid.","noHeirsInOrder":"The details entered leave no heir in this order of succession.","estateEscheats":"With no heir in any order and no surviving spouse, the estate passes to the State (TCC art. 501)."},"kidem-tazminati":{"name":"Severance Pay Calculator","summary":"Calculates severance pay from the dates of employment and the all-in gross wage, applying the ceiling in force and stamp duty.","intro":"Severance pay is calculated under article 14 of Labour Act no. 1475, kept in force by provisional article 6 of Act no. 4857. Thirty days of the all-in gross wage is payable for each completed year of service, with part years apportioned. The payment is exempt from income tax; stamp duty is the only withholding. The calculation assumes the contract ended for a reason that entitles the employee to severance.","fields":{"startDate":"Start of employment","endDate":"End of employment","grossMonthlyWage":"Gross monthly wage","annualBenefits":"Total annual benefits","annualBenefitsHint":"The yearly total of regular benefits such as travel, meals, fuel and bonuses. Added to the all-in wage; leave blank if there are none."},"results":{"serviceDuration":"Length of service (full years / extra days)","dressedWage":"All-in gross monthly wage","appliedBase":"Thirty-day amount applied","gross":"Gross severance pay","stampDuty":"Stamp duty withheld","net":"Net severance pay"},"notes":{"ceilingApplied":"The all-in wage exceeds the severance ceiling in force, so the calculation has been made on the ceiling.","incomeTaxExempt":"Severance pay is exempt from income tax; amounts paid above the ceiling fall outside that exemption."}},"infaz-hesaplama":{"name":"Sentence Execution Calculator","summary":"Shows the period to conditional release, the supervised release period and the estimated time in prison, by offence date, offence type and recidivism.","intro":"The calculation follows articles 105/A and 107 of the Execution of Sentences Act no. 5275, and article 108 where the offender is a recidivist. The result is an estimate only: credit for time spent in pre-trial detention, aggregation of sentences, aggravated life and life imprisonment, the separate regimes for juvenile and ill prisoners, and offences under Act no. 3713 are not modelled here.","fields":{"sentenceYears":"Sentence — years","sentenceMonths":"Sentence — months","sentenceDays":"Sentence — days","offencePeriod":"Date of the offence","offencePeriodHint":"For offences committed before 30 March 2020 the supervised release period is three years under provisional article 6.","offenceType":"Type of offence","offenceTypeHint":"For listed offences such as intentional homicide, sexual offences and drug trafficking the conditional release ratio is two thirds.","repeatOffender":"Recidivism"},"options":{"offencePeriod_before2020":"Before 30 March 2020","offencePeriod_after2020":"On or after 30 March 2020","offenceType_general":"Offence under the general rule","offenceType_aggravated":"Listed offence (two-thirds ratio)","repeatOffender_no":"Not a recidivist","repeatOffender_yes":"Recidivist"},"results":{"totalSentence":"Total sentence (years / months / days)","appliedRatio":"Conditional release ratio","paroleDuration":"Until conditional release (years / months / days)","supervisedRelease":"Supervised release (years)","estimatedTimeServed":"Estimated time in prison (years / months / days)"},"notes":{"paroleScopeLimits":"Aggregation of sentences, aggravated life and life imprisonment, and the special regimes for juvenile, elderly and ill prisoners are not included.","paroleNoRemandCredit":"Credit for time already spent in custody is not taken into account; it shortens the actual time served.","paroleSeekCounsel":"Calculating execution requires the judgment and the offence date to be examined. This result is not an official execution calculation."}},"kira-artis-orani":{"name":"Rent Increase Calculator","summary":"Calculates the maximum lawful rent increase on renewal, based on the twelve-month average change in the consumer price index.","intro":"Under article 344 of the Code of Obligations no. 6098, an increase in rent may not exceed the change in the twelve-month averages of the consumer price index in the previous lease year. Where the contract sets a higher rate, that rate is void to the extent it exceeds the index. The 25% ceiling on residential rents was a temporary measure and expired on 1 July 2024.","fields":{"currentRent":"Current monthly rent","cpiRate":"Twelve-month average CPI change (%)","cpiRateHint":"Take the rate for the month of renewal from the official TurkStat series. It changes every month, which is why it is not built into this tool.","agreedRate":"Rate agreed in the contract (%)","agreedRateHint":"Enter the rate in your contract, if any. Below the index that rate applies; above it, the index does. Leave blank if there is none."},"results":{"currentRent":"Current rent","appliedRate":"Rate applied","increase":"Monthly increase","newRent":"New monthly rent","legalMaximum":"Maximum lawful rent","annualDifference":"Annual difference"},"notes":{"rentCapBasis":"The calculation treats the twelve-month CPI average as the ceiling under article 344. The same ceiling applies to commercial leases.","agreedRateCapped":"The rate agreed in the contract exceeds the index, so the index rate has been applied instead."}},"nafaka-artirim":{"name":"Alimony Increase Calculator","summary":"Calculates the current alimony, the monthly increase and the annual difference from the increase clause in the judgment.","intro":"Judgments commonly order alimony to rise by a set rate each year. The increase compounds: each year's uplift applies to the amount produced by the previous year's uplift. Where the judgment refers to an index rather than a rate, enter the official figure for the period. Re-setting alimony because circumstances have changed (article 176/4 of the Civil Code) is a separate action and falls outside this calculation.","fields":{"currentAlimony":"Current monthly alimony","annualRate":"Annual increase rate (%)","annualRateHint":"Enter the rate stated in the judgment. Where it refers to CPI or PPI, use the official figure for the period.","years":"Number of years to apply"},"results":{"currentAlimony":"Current alimony","appliedRate":"Annual increase rate","years":"Years","updatedAlimony":"Current monthly alimony","monthlyIncrease":"Monthly increase","annualDifference":"Annual difference"},"notes":{"alimonyCompounding":"The increase compounds: over several years the rate applies each year to the previous year's amount."}},"is-kazasi-tazminat":{"name":"Work Accident Damages Calculator","summary":"Calculates pecuniary loss from permanent incapacity across the known, active and passive periods, with contributory fault and the SGK deduction.","intro":"Damages for permanent incapacity are calculated by splitting the loss into the known period (from the accident to the date of calculation), the active period (to the end of working life) and the passive period (to the end of the remaining lifespan). The active period uses the progressive rent method applied by the Court of Cassation; a 10% annual increase and a 10% discount cancel out, so each active year corresponds to one year's earnings. The remaining lifespan comes from the TRH-2010 mortality table and is entered here by hand.","fields":{"monthlyEarning":"Net monthly earnings","monthlyEarningHint":"Net monthly earnings at the date of the accident. The known and active periods are calculated on this figure.","disabilityRatio":"Permanent incapacity ratio (%)","disabilityRatioHint":"The incapacity ratio set out in the SGK or forensic medicine report.","faultRatio":"Claimant's contributory fault (%)","faultRatioHint":"The share attributed to the injured party in the expert report. Damages are reduced by this proportion.","knownPeriodMonths":"Known period (months)","activePeriodYears":"Active period (years)","activePeriodYearsHint":"Years remaining from the date of calculation to the end of working life.","passivePeriodYears":"Passive period (years)","passivePeriodYearsHint":"Years from the end of working life to the end of the remaining lifespan in the TRH-2010 table.","sgkCapitalValue":"Capital value of the SGK income","sgkCapitalValueHint":"The capital value of the permanent incapacity income awarded by SGK is deducted from the damages. Leave blank if there is none."},"results":{"knownLoss":"Known period loss","activeLoss":"Active period loss","passiveLoss":"Passive period loss","grossLoss":"Total loss before fault reduction","liabilityShare":"Share of liability","afterFault":"After fault reduction","sgkDeduction":"SGK deduction","net":"Estimated pecuniary damages"},"notes":{"trh2010Source":"The remaining lifespan comes from the TRH-2010 mortality table; it varies by age and sex and is therefore not built into this tool.","progressiveRentMethod":"The active period uses the progressive rent method (10% increase, 10% discount).","expertReportRequired":"This result is not an actuarial report. In proceedings the loss is calculated by a court-appointed expert."}},"yillik-izin":{"name":"Annual Leave Calculator","summary":"Calculates annual paid leave entitlement and the accrued balance from the date employment began.","intro":"Under article 53 of Labour Act no. 4857, annual paid leave may not be less than fourteen days for service of one to five years, twenty days for more than five and less than fifteen years, and twenty-six days for fifteen years or more. For workers under eighteen or over fifty it may not fall below twenty days. Entitlement arises only after one full year of service.","fields":{"startDate":"Start of employment","referenceDate":"Calculation date","usedDays":"Leave days taken","ageGroup":"Worker's category","ageGroupHint":"For workers under eighteen or over fifty, annual leave may not fall below twenty days."},"options":{"ageGroup_standard":"Aged between 18 and 50","ageGroup_protected":"Under 18 or over 50"},"results":{"completedYears":"Completed years of service","currentEntitlement":"Entitlement for this year (days)","accrued":"Total accrued leave (days)","used":"Leave taken (days)","balance":"Leave balance (days)"},"notes":{"leaveIsMinimum":"The statutory periods are minimums and may be increased by the employment or collective agreement.","usedExceedsAccrued":"The leave taken appears to exceed the leave accrued. Please check the values entered."}},"fazla-mesai":{"name":"Overtime Pay Calculator","summary":"Calculates gross pay for hours beyond forty-five a week at 150%, and hours beyond a shorter contractual week at 125%.","intro":"Under article 41 of Labour Act no. 4857, work beyond forty-five hours a week is overtime and is paid at 150% of the hourly rate. Where the contract sets a working week shorter than forty-five hours, work between that figure and forty-five is \"extra time\" and is paid at 125%. Overtime may not exceed 270 hours a year. The hourly rate is the gross monthly wage divided by 225.","fields":{"grossMonthlyWage":"Gross monthly wage","contractWeeklyHours":"Contractual weekly hours","contractWeeklyHoursHint":"Enter a figure only if the contract sets fewer than forty-five hours. Otherwise leave it at 45.","actualWeeklyHours":"Hours actually worked per week","weeks":"Number of weeks"},"results":{"hourlyRate":"Gross hourly rate","overtimeHours":"Overtime (hours)","overtimePay":"Overtime pay (150%)","extraTimeHours":"Extra time (hours)","extraTimePay":"Extra time pay (125%)","total":"Total gross entitlement"},"notes":{"grossFigures":"The figures are gross; tax and social security deductions have not been applied.","overtimeCapExceeded":"The overtime calculated exceeds the annual cap of 270 hours. Exceeding the cap does not extinguish the right to payment."}},"issizlik-maasi":{"name":"Unemployment Benefit Calculator","summary":"Calculates the monthly unemployment benefit from earnings over the last four months and premium days, with the ceiling and the payment period.","intro":"Under article 50 of Unemployment Insurance Act no. 4447, the daily benefit is 40% of the average daily gross earnings subject to premium over the last four months. It may not exceed 80% of the gross minimum wage. The payment period is 180, 240 or 300 days according to premium days in the last three years. Stamp duty is the only deduction from the benefit.","fields":{"averageGrossMonthly":"Average monthly gross earnings, last four months","averageGrossMonthlyHint":"The monthly average of gross earnings subject to premium over the last four months.","premiumDays":"Premium days in the last three years","premiumDaysHint":"Entitlement requires at least 600 premium days in the last three years and 120 days of continuous service."},"results":{"grossMonthly":"Gross monthly benefit","stampDuty":"Stamp duty withheld","netMonthly":"Net monthly benefit","benefitDays":"Payment period (days)","benefitMonths":"Payment period (months)","totalBenefit":"Total net benefit"},"notes":{"benefitConditions":"Entitlement depends on the contract having ended for one of the reasons listed in the Act and on applying within the time limit.","benefitCeilingApplied":"The calculated benefit exceeds 80% of the gross minimum wage, so the ceiling has been applied."}},"miras-payi":{"name":"Inheritance Share Calculator","summary":"Calculates the statutory shares and reserved portions of the surviving spouse, descendants, parents and siblings under the parentela system.","intro":"Under articles 495 to 501 of the Turkish Civil Code the estate is divided by orders of succession. The first order is the descendants, the second the parents and their descendants, the third the grandparents. An heir in a nearer order excludes every more remote order. The surviving spouse inherits alongside whichever order is called, at a fraction that rises with its remoteness. Reserved portions are set out in article 506; the reserved portion of siblings was abolished in 2007.","fields":{"estateValue":"Net value of the estate","estateValueHint":"The net estate after the matrimonial property regime has been settled and debts deducted.","spouse":"Surviving spouse","childCount":"Number of children (descendants)","parentsAlive":"Number of surviving parents","parentsAliveHint":"Relevant only where there are no descendants. A predeceased parent's share passes to that parent's own descendants, that is, to the siblings.","siblingCount":"Number of siblings"},"options":{"spouse_yes":"Yes","spouse_no":"No","parentsAlive_0":"Neither surviving","parentsAlive_1":"One surviving","parentsAlive_2":"Both surviving"},"results":{"spouseShare":"Surviving spouse's share","perChildShare":"Share per child","childrenTotal":"Children's total share","perParentShare":"Share per parent","parentsTotal":"Parents' total share","perSiblingShare":"Share per sibling","siblingsTotal":"Siblings' total share","reservedTotal":"Total reserved portion","disposable":"Disposable portion"},"notes":{"inheritanceMaritalRegime":"The calculation runs on the net estate after the matrimonial property regime is settled. The surviving spouse's participation claim is separated before the estate is divided and is often larger than the inheritance share.","inheritanceScopeLimits":"Disinheritance, disclaimer, adoption, gifts subject to abatement and representation through a sibling's descendants are not included.","inheritanceSiblingsNoReserve":"The reserved portion of siblings was abolished by Act no. 5650 in 2007.","inheritanceSpouseAloneAssumption":"With no descendants, parents or siblings, no heir in the third order has been assumed either, so the whole estate passes to the surviving spouse."}}},"contactPage":{"meta":{"title":"Contact","description":"Contact details and a form for requesting a consultation are set out below."},"label":"Contact","title":"Request a Consultation","formLabel":"Request Form","requiredNo