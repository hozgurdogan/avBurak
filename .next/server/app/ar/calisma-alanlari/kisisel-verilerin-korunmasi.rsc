12:["$","$L21",null,{"formats":{"dateTime":{"long":{"day":"numeric","month":"long","year":"numeric","numberingSystem":"latn"},"short":{"day":"2-digit","month":"2-digit","year":"numeric","numberingSystem":"latn"}}},"locale":"ar","messages":{"site":{"attorney":"المحامي بوراك أوغور أوزتورك","attorneyShort":"بوراك أوغور أوزتورك","role":"محامٍ","monogramLabel":"بوراك أوغور أوزتورك — الصفحة الرئيسية"},"nav":{"primary":"القائمة الرئيسية","home":"الرئيسية","practiceAreas":"مجالات العمل","profile":"نبذة","articles":"المقالات","contact":"اتصل بنا","openMenu":"فتح القائمة","closeMenu":"إغلاق القائمة","skipToContent":"الانتقال إلى المحتوى","tools":"الأدوات","faq":"الأسئلة الشائعة","regions":"المناطق"},"locale":{"label":"اللغة","change":"تغيير اللغة","current":"اللغة المختارة"},"home":{"meta":{"title":"المحامي بوراك أوغور أوزتورك","homeTitle":"المحامي بوراك أوغور أوزتورك | مكتب محاماة في إسنيورت وبيوك تشكمجة","description":"مكتب محاماة في قانون العمل والتنفيذ والإفلاس وقانون الطلاق والأسرة والإيجار والإرث والشركات؛ مقرّه إسنيورت، يخدم بيوك تشكمجة وبيليك دوزو، باللغات التركية والإنجليزية والعربية."},"hero":{"label":"إسنيورت · بيوك تشكمجة · بيليك دوزو","title":"دعم قانوني للمنازعات الفردية والمؤسسية في بيوك تشكمجة وما حولها.","registrationLabel":"القيد","languagesLabel":"لغات العمل","languages":"التركية · الإنجليزية · العربية","focusLabel":"مجالات العمل","focus":"قانون العمل، قانون التنفيذ، قانون الطلاق والأسرة","regionsLabel":"المناطق التي نخدمها","lead":"استشارات قانونية ومتابعة قضايا في قانون العمل والتنفيذ والإفلاس وقانون الطلاق والأسرة والإيجار والإرث والشركات - مقرّنا في إسنيورت، باللغات التركية والإنجليزية والعربية.","contact":"اتصل بنا","appointment":"طلب موعد"},"practice":{"label":"مجالات العمل","title":"المجالات القانونية","lead":"تبيّن العناوين الآتية المجالات التي يعمل فيها المكتب بصفة منتظمة.","all":"جميع مجالات العمل"},"profile":{"label":"نبذة","title":"عن المكتب","body":"يقوم المكتب على العمل المباشر في عدد محدود من الملفات. ويبدأ كل تكليف بفحص التشريعات الواجبة التطبيق والاجتهاد القضائي الجاري؛ ويتضمن التقييم المقدَّم إلى الموكّل عرضًا واضحًا للخيارات المتاحة وللمخاطر المرتبطة بكل خيار منها.","link":"عرض النبذة"},"articles":{"label":"المقالات","title":"أحدث الكتابات","lead":"ملاحظات في التشريع والتطبيق، محرَّرة على سبيل الإعلام العام.","all":"جميع المقالات"},"contact":{"label":"اتصل بنا","title":"طلب اجتماع","body":"لطلب اجتماع بشأن ملفكم، يمكنكم استعمال النموذج الوارد في صفحة الاتصال أو التواصل مع المكتب مباشرةً.","link":"صفحة الاتصال"}},"practiceAreas":{"is-hukuku":{"name":"قانون العمل","summary":"منازعات الفسخ وإعادة العمل، وتعويضات نهاية الخدمة والإخطار، ومستحقات العمل الإضافي والإجازات، ومطالبات التعويض الناشئة عن إصابات العمل.","body":["يشمل العمل متابعة الدعاوى وإجراءات الوساطة لصالح العامل وصاحب العمل في منازعات إنهاء عقد العمل، واحتساب ومتابعة تعويض نهاية الخدمة وتعويض الإخطار والعمل الإضافي والإجازة السنوية وسائر مستحقات العامل.","يُقدَّم الدعم أيضًا في مطالبات التعويض المادي والمعنوي الناشئة عن إصابات العمل والأمراض المهنية، ودعاوى إعادة العمل، وإجراءات إنهاء الخدمة الجماعي.","بالنسبة لطلب إعادة العمل بدعوى الفسخ غير المشروع من جانب العامل، يجب التقدم بطلب للوساطة خلال المدة المنصوص عليها قانونًا من تاريخ تبليغ إشعار الفسخ؛ وفي حال عدم التوصل إلى تسوية يمكن اللجوء إلى الدعوى القضائية. أما من جانب صاحب العمل، فينبغي مراعاة الشروط الإجرائية مثل أخذ إفادة الدفاع وتحرير المحضر وتبليغ إشعار الفسخ.","يعتمد إثبات العمل الإضافي والإجازة السنوية وسائر مستحقات العامل بشكل أساسي على المستندات الكتابية وأقوال الشهود وسجلات مكان العمل؛ ويمكن الاستعانة بأدوات حساب تعويض نهاية الخدمة والإجازة السنوية والعمل الإضافي وإعانة البطالة المتوفرة في هذا الموقع لتقدير المبالغ المستحقة بشكل أولي."]},"icra-hukuku":{"name":"قانون التنفيذ","summary":"إجراءات التنفيذ المستندة إلى حكم وغير المستندة إليه، والاعتراض وإبطاله، وإجراءات الحجز، وإجراءات الإفلاس والصلح الواقي.","body":["بالنسبة للدائن والمدين على حد سواء، يشمل العمل بدء إجراءات التنفيذ المستندة إلى حكم وغير المستندة إليه، والاعتراض على أمر الدفع، ودعاوى رفع الاعتراض أو إبطاله.","كما يشمل متابعة إجراءات الحجز والبيع، ودعاوى النفي والاسترداد، وإجراءات الإفلاس والصلح الواقي (الكونكورداتو).","من جانب المدين، يؤدي الاعتراض لدى دائرة التنفيذ خلال المدة القانونية من تاريخ تبليغ أمر الدفع إلى إيقاف الإجراءات؛ ومن جانب الدائن، يمكن اللجوء إلى رفع الاعتراض (أمام محكمة التنفيذ) أو إبطاله (أمام المحكمة العامة) لمواصلة التنفيذ.","يُطبَّق الحجز كقاعدة عامة على الأموال المنقولة وغير المنقولة والمستحقات القابلة للحجز والعائدة للمدين؛ وتُستثنى بعض الأموال والحقوق المنصوص عليها في القانون. يُنصح بتجهيز المستندات المثبتة للدين (العقد، الفاتورة، الشيك/السند، الحكم القضائي، إلخ) بشكل كامل في بداية العملية."]},"bosanma-aile-hukuku":{"name":"قانون الطلاق والأسرة","summary":"دعاوى الطلاق بالتراضي والمتنازع عليه، ومطالبات النفقة والتعويض، وتصفية النظام المالي الزوجي، وترتيبات الحضانة والزيارة.","body":["يشمل العمل متابعة دعاوى الطلاق بالتراضي والمتنازع عليه، وإعداد بروتوكول الطلاق، والمطالبة بالنفقة والتعويض المادي والمعنوي.","يُقدَّم الدعم أيضًا في دعاوى المشاركة في الأموال الناشئة عن تصفية النظام المالي الزوجي، وترتيبات الحضانة والزيارة، ودعاوى زيادة النفقة.","في الطلاق بالتراضي، يُشترط موافقة المحكمة على البروتوكول المتفق عليه بين الطرفين بشأن الحضانة والنفقة والتعويض وتقسيم الأموال؛ أما في الطلاق المتنازع عليه، فيجب دعم الادعاءات بمستندات كتابية وأقوال شهود وأي أدلة أخرى متوفرة.","تُراعى المصلحة الفضلى للطفل في ترتيبات الحضانة والزيارة؛ ويُحتسب مطلب المشاركة في الأموال عند تصفية النظام المالي الزوجي بناءً على الأموال المكتسبة خلال فترة الزواج. يُنصح بتحرير وكالة خاصة بإجراءات الطلاق والتخطيط المسبق لمراحل العملية."]},"miras-hukuku":{"name":"قانون الإرث","summary":"وثيقة حصر الإرث، وتحديد التركة وتقسيمها، وتحصيل نصيب الإرث، ودعاوى التنقيص والحرمان من الإرث.","body":["يشمل العمل الحصول على وثيقة حصر الإرث، وتحديد التركة وتقسيمها، ومتابعة إجراءات تحصيل نصيب الوريث من الورثة الآخرين.","كما يشمل دعاوى التنقيص، والحرمان من الإرث، والمنازعات الناشئة عن عقود الإرث.","يمكن التنازل عن الإرث (رفض الإرث) بالتقدم بطلب إلى محكمة الصلح المدنية خلال ثلاثة أشهر من تاريخ العلم بصفة الوريث؛ وفي حال فوات هذه المدة، يُعتبر الإرث - كقاعدة عامة - مكتسبًا دون قيد أو شرط من قبل الورثة الشرعيين.","تُعالَج ضمن هذا النطاق أيضًا دعاوى ادعاء المورّث بالتحايل (تهريب أموال الإرث)، ودعاوى التنقيص، وطلبات إنهاء الشيوع بين الورثة؛ وتُحدَّد المحكمة المختصة والمهل وفقًا للطبيعة الملموسة للملف."]},"kira-hukuku":{"name":"قانون الإيجار","summary":"منازعات تحديد وزيادة بدل الإيجار، ودعاوى الإخلاء، والتنفيذ المستند إلى تعهد الإخلاء، وإعداد عقود الإيجار.","body":["يشمل العمل تحديد بدل الإيجار وتكييفه، والمنازعات المتعلقة بنسبة زيادة الإيجار، وإعداد عقود الإيجار ومراجعتها.","يُقدَّم الدعم أيضًا في إجراءات التنفيذ المستندة إلى تعهد الإخلاء، والإخلاء بسبب التأخر في السداد، ودعاوى الإخلاء المستندة إلى حاجة المالك للسكن أو إعادة البناء.","يمكن طلب الإخلاء عن طريق التنفيذ - بإعذار المستأجر أو استنادًا إلى تعهد الإخلاء - كما يمكن طلبه عن طريق الدعوى القضائية للأسباب المنصوص عليها في القانون، مثل حاجة المالك أو أحد أقاربه للسكن، أو إعادة البناء/التطوير العمراني؛ ولكل سبب إجراءات ومهل خاصة به.","في دعاوى تكييف بدل الإيجار وتحديده، يُراعى معدل مؤشر أسعار المستهلك (TÜFE) لاثني عشر شهرًا عن الفترة السابقة إلى جانب أحكام العقد؛ ويمكن استخدام أداة حساب نسبة زيادة الإيجار المتوفرة في هذا الموقع لتحديد النسبة المطبقة."]},"sirketler-hukuku":{"name":"قانون الشركات","summary":"تأسيس الشركات وتغيير شكلها، وتحرير النظام الأساسي، وزيادة رأس المال، والتنازل عن الحصص، واتفاقات الشركاء، وإجراءات الجمعية العامة.","body":["يشمل العمل في هذا المجال ابتداءً من مرحلة التأسيس: اختيار الشكل القانوني للشركة، وإعداد النظام الأساسي، وتحديد هيكل رأس المال، وإتمام إجراءات القيد.","وبعد التأسيس، تشمل الممارسة زيادة رأس المال وتخفيضه، والتنازل عن الحصص، وإعداد اتفاقات الشركاء، ومتابعة إجراءات الجمعية العامة ومجلس الإدارة، وكذلك عمليات تغيير الشكل والاندماج."]},"tahkim-ve-uyusmazlik-cozumu":{"name":"التحكيم وتسوية المنازعات","summary":"صياغة شروط التحكيم، وإجراءات التحكيم المؤسَّسي والحر، وتنفيذ أحكام التحكيم الأجنبية، والوساطة والتقاضي.","body":["يشمل العمل صياغة شروط التحكيم، وتحديد مقر ولغة التحكيم، ومتابعة إجراءات التحكيم المؤسسي أو الحر.","كما يشمل تنفيذ أحكام التحكيم الأجنبية في تركيا، والوساطة، وتسوية المنازعات عن طريق التقاضي."]},"kisisel-verilerin-korunmasi":{"name":"حماية البيانات الشخصية","summary":"أعمال الامتثال لقانون حماية البيانات الشخصية، ونصوص الإعلام والموافقة الصريحة، وسجل البيانات، والنقل إلى الخارج، وبلاغات خرق البيانات.","body":["في إطار القانون رقم 6698، يشمل العمل تحديد التزامات المتحكم بالبيانات، وإعداد سجل جرد البيانات، وصياغة نصوص الإعلام والموافقة الصريحة.","يُقدَّم الدعم في هيكلة عمليات نقل البيانات إلى خارج البلاد بما يتوافق مع التشريعات، وفي إجراءات الإخطار بخرق البيانات."]}},"practiceAreasPage":{"meta":{"title":"مجالات العمل","description":"يعمل المكتب في قانون العمل، وقانون التنفيذ، وقانون الطلاق والأسرة، وقانون الإرث، وقانون الإيجار، وقانون الشركات، والتحكيم وتسوية المنازعات، وحماية البيانات الشخصية."},"label":"مجالات العمل","title":"المجالات القانونية","lead":"تبيّن العناوين أدناه المجالات التي يعمل فيها المكتب بصفة منتظمة.","cta":"عرض التفاصيل"},"practiceAreaDetail":{"back":"جميع مجالات العمل","relatedLabel":"مقالات ذات صلة","relatedEmpty":"لم يُنشر بعد أي مقال في هذا المجال.","relatedToolsLabel":"أدوات الحساب ذات الصلة","contactCta":"تواصل معنا"},"serviceRegions":{"buyukcekmece":{"name":"بيوك تشكمجة","summary":"إجراءات المحكمة، وأنواع القضايا الأكثر شيوعًا، والمستندات التي يُفضَّل تجهيزها قبل الموعد، للمنازعات في بيوك تشكمجة وما حولها.","body":["بالنسبة للعديد من المنازعات القانونية الناشئة في إسنيورت وبيليك دوزو وتشاتالجا وبيوك تشكمجة نفسها، تكون الجهة المختصة عادةً محكمة بيوك تشكمجة؛ وقد تختلف المحكمة المختصة بحسب نوع القضية، لذا يجب التحقق من ذلك في كل حالة على حدة.","من أكثر المنازعات شيوعًا في المنطقة: مطالبات مستحقات العمال وإعادة العمل، والاعتراض على إجراءات التنفيذ والحجز، وقضايا الطلاق والحضانة، ودعاوى تحديد بدل الإيجار والإخلاء، والمنازعات الناشئة عن تقسيم الإرث.","قبل الموعد، يُفضَّل تجهيز الهوية، وأي عقد أو مستند تبليغ قائم، والمستندات المتعلقة بعلاقة العمل (كشوف الرواتب، إشعارات بدء/انتهاء العمل)، أو مستندات خاصة بالملف مثل سند الملكية أو عقد الإيجار، لتسريع التقييم الأولي."],"relatedAreas":["is-hukuku","icra-hukuku","bosanma-aile-hukuku","kira-hukuku","miras-hukuku"]},"beylikduzu":{"name":"بيليك دوزو","summary":"المنازعات الناشئة عن علاقات السكن والعمل في بيليك دوزو، وخيارات المقابلة.","body":["بيليك دوزو منطقة ذات كثافة سكانية وعمالية عالية، وتشهد بكثرة منازعات علاقات الإيجار وعقود العمل ومسائل قانون الأسرة؛ والمنازعات الناشئة فيها تقع أيضًا في الغالب ضمن اختصاص محكمة بيوك تشكمجة.","من أبرز المواضيع التي ترد من هذه المنطقة: بصفة مستأجر أو مؤجر - دعاوى الإخلاء وتحديد بدل الإيجار ومنازعات التأمين؛ وبصفة عامل أو صاحب عمل - تعويضات نهاية الخدمة والإخطار والعمل الإضافي؛ إضافة إلى الاعتراض على إجراءات التنفيذ والحجز.","يمكن ترتيب المقابلات حضوريًا في المكتب أو عن بُعد عبر مكالمة فيديو/هاتفية بحسب الرغبة؛ ويساعد تجهيز المستندات ذات الصلة (عقد الإيجار، إيصالات الدفع، عقد العمل، إلخ) قبل المقابلة الأولى في زيادة كفاءة العملية."],"relatedAreas":["kira-hukuku","is-hukuku","bosanma-aile-hukuku","icra-hukuku"]},"esenyurt":{"name":"إسنيورت","summary":"عنوان المكتب الفعلي في إسنيورت، ومعلومات الوصول، واستقبال الموكلين الأفراد والشركات في جميع مجالات العمل.","body":["يقدّم المكتب خدماته من عنوان: حي جمهورية، شارع 1991، بيسنتر ريزيدنس، إسنيورت/إسطنبول؛ ويتم استقبال الموكلين الأفراد والشركات بموعد مسبق، حضوريًا في المكتب أو عبر مكالمة فيديو/هاتفية عند الطلب.","في جميع مجالات قانون العمل والتنفيذ والطلاق والأسرة والإيجار والإرث والشركات والتحكيم وحماية البيانات الشخصية، يُقدَّم الدعم للموكلين الأفراد والمؤسسات/الأجانب على حد سواء باللغات التركية والإنجليزية والعربية.","يمكن الوصول إلى العنوان عبر وسائل النقل العام أو بالسيارة الخاصة؛ ويُنصح بالتواصل مسبقًا عبر الهاتف أو واتساب (راجعوا صفحة الاتصال) لتحديد موعد دقيق والحصول على إرشادات الوصول."],"relatedAreas":["is-hukuku","icra-hukuku","bosanma-aile-hukuku","kira-hukuku","miras-hukuku","sirketler-hukuku"]}},"serviceRegionsPage":{"meta":{"title":"المناطق التي نخدمها","description":"دعم قانوني في إسنيورت وبيوك تشكمجة وبيليك دوزو، في قانون العمل والتنفيذ والطلاق والأسرة والإيجار والإرث."},"label":"المناطق","title":"المناطق التي نخدمها","lead":"عنوان المكتب الفعلي في إسنيورت؛ ويُقدَّم للموكلين في بيوك تشكمجة وبيليك دوزو نفس مجالات العمل."},"serviceRegionDetail":{"back":"جميع المناطق","relatedAreasLabel":"مجالات العمل ذات الصلة","contactCta":"تواصل معنا"},"profilePage":{"meta":{"title":"نبذة","description":"المحامي بوراك أوغور أوزتورك — مقيَّد لدى نقابة محامي إسطنبول. لغات العمل: التركية والإنجليزية والعربية."},"label":"نبذة","title":"المحامي بوراك أوغور أوزتورك","intro":"يمارس المحامي بوراك أوغور أوزتورك المحاماة بشكل مستقل، وهو مقيَّد لدى نقابة محامي إسطنبول. لغات العمل هي التركية والإنجليزية والعربية، مما يتيح التواصل المباشر مع المستثمرين الأجانب والأطراف متعددة الجنسيات.","portraitAlt":"المحامي بوراك أوغور أوزتورك","admissionLabel":"القيد لدى النقابة","languagesLabel":"لغات العمل","languages":"التركية، الإنجليزية، العربية","approachTitle":"منهج العمل","approachBody":["يبدأ كل ملف بفحص التشريعات الواجبة التطبيق والاجتهاد القضائي الجاري. ويُعَدّ التقييم الذي يُقدَّم للموكّل بحيث يوضح بعبارات واضحة الخيارات المتاحة، والمخاطر المرتبطة بكل خيار، والآجال المتوقعة.","يُحافَظ على عدد الملفات المفتوحة ضمن حدود معقولة لضمان تخصيص وقت كافٍ لكل ملف. ويقوم التواصل مع الموكّل على أساس التحديث المنتظم في كل مرحلة من مراحل العملية."],"scopeTitle":"مجالات العمل","scopeLinkText":"عرض مجالات العمل","contactCta":"تواصل معنا"},"articlesPage":{"meta":{"title":"المقالات","description":"مقالات ذات طابع إعلامي عام حول قانون الشركات، والاستثمار الأجنبي، والعقارات، والعقود التجارية، والتحكيم، وحماية البيانات."},"label":"المقالات","title":"أحدث الكتابات","lead":"مقالات ذات طابع إعلامي عام حول التشريعات والتطبيق. يمكن تصفية القائمة أدناه حسب التصنيف.","filterAll":"الكل","filterLabel":"التصنيف","searchLabel":"البحث في المقالات","searchPlaceholder":"كلمة مفتاحية","searchSubmit":"بحث","empty":"لا توجد مقالات مطابقة لهذا الفلتر.","prevPage":"السابق","nextPage":"التالي","pageLabel":"صفحة {page} من {totalPages}"},"articleDetail":{"back":"العودة إلى جميع المقالات","tocLabel":"المحتويات","relatedLabel":"مقالات ذات صلة"},"toolsPage":{"meta":{"title":"أدوات الحساب","description":"أدوات حسابية لأغراض المعلومات العامة: تعويض نهاية الخدمة، الإجازة السنوية، العمل الإضافي، بدل البطالة، زيادة الأجرة، النفقة، تنفيذ العقوبة وأنصبة الميراث وفق القانون التركي."},"label":"الأدوات","title":"أدوات الحساب القانوني","lead":"أدوات حسابية لأغراض المعلومات العامة، تستند إلى التشريعات النافذة. ما تُدخله يبقى في متصفحك؛ لا يُحفظ أي بيان ولا يُرسل. النتائج لا تُغني عن دراسة وقائع حالتك.","back":"جميع أدوات الحساب","otherToolsLabel":"أدوات أخرى"},"tools":{"form":{"inputsLabel":"البيانات","resultLabel":"النتيجة","submit":"احسب","reset":"مسح","idle":"املأ الحقول ثم اضغط احسب. ما تُدخله يبقى في متصفحك.","parametersUnverified":"لم يتم بعد التحقق من تحديث المقادير القانونية المستخدمة في هذه الأداة. قارنها بالمبالغ الرسمية للفترة الجارية قبل الاعتماد على النتيجة.","privacyNote":"تُعالَج البيانات التي تُدخلها في متصفحك فقط؛ ولا يُحفظ أي بيان ولا يُرسل."},"parameters":{"severanceCeilingPerYear":"الحد الأعلى لتعويض نهاية الخدمة","minimumWageGrossMonthly":"الحد الأدنى للأجر الإجمالي","stampDutyRate":"نسبة رسم الطابع"},"errors":{"missingFields":"يرجى إكمال جميع الحقول الإلزامية.","invalidAmount":"المبلغ أو الرقم المُدخل غير صالح.","endBeforeStart":"يجب أن يكون تاريخ الانتهاء لاحقًا لتاريخ البدء.","serviceTooShort":"يشترط لاستحقاق تعويض نهاية الخدمة مضيّ سنة كاملة من الخدمة على الأقل.","leaveNotYetAccrued":"يشترط لاستحقاق الإجازة السنوية مدفوعة الأجر مضيّ سنة كاملة من الخدمة على الأقل.","invalidContractHours":"يجب أن تكون ساعات العمل الأسبوعية في العقد بين 1 و 45 ساعة.","noOvertime":"الساعات المُدخلة لا تتجاوز مدة العمل المتفق عليها، فلا ينشأ أجر عمل إضافي.","premiumDaysTooLow":"يشترط سداد 600 يوم اشتراك على الأقل خلال السنوات الثلاث الأخيرة.","invalidRatio":"يجب أن تكون النسبة بين 0 و 100.","invalidPeriod":"المدة المُدخلة غير صالحة.","noHeirsInOrder":"لا يوجد وارث في هذه الطبقة وفق البيانات المُدخلة.","estateEscheats":"عند انتفاء الوارث في جميع الطبقات وانتفاء الزوج الباقي على قيد الحياة تؤول التركة إلى الدولة (المادة 501 من القانون المدني)."},"kidem-tazminati":{"name":"حساب تعويض نهاية الخدمة","summary":"يحسب تعويض نهاية الخدمة استنادًا إلى تاريخي بدء العمل وانتهائه والأجر الإجمالي الشامل، مع تطبيق الحد الأعلى النافذ ورسم الطابع.","intro":"يُحسب تعويض نهاية الخدمة وفق المادة 14 من قانون العمل رقم 1475، المبقاة نافذة بالمادة المؤقتة 6 من القانون رقم 4857. يُستحق عن كل سنة خدمة كاملة أجر ثلاثين يومًا من الأجر الإجمالي الشامل، وتُحتسب المدد الجزئية بالتناسب. التعويض معفى من ضريبة الدخل، ولا يُقتطع منه سوى رسم الطابع. يفترض الحساب أن عقد العمل انتهى لسبب يوجب استحقاق التعويض.","fields":{"startDate":"تاريخ بدء العمل","endDate":"تاريخ انتهاء العمل","grossMonthlyWage":"الأجر الشهري الإجمالي","annualBenefits":"مجموع المزايا السنوية","annualBenefitsHint":"المجموع السنوي للمزايا المنتظمة كالمواصلات والوجبات والوقود والمكافآت. يُضاف إلى الأجر الشامل؛ اتركه فارغًا إن لم توجد."},"results":{"serviceDuration":"مدة الخدمة (سنوات كاملة / أيام إضافية)","dressedWage":"الأجر الشهري الإجمالي الشامل","appliedBase":"مبلغ الثلاثين يومًا المطبَّق","gross":"التعويض الإجمالي","stampDuty":"رسم الطابع المقتطع","net":"صافي تعويض نهاية الخدمة"},"notes":{"ceilingApplied":"تجاوز الأجر الشامل الحد الأعلى النافذ للتعويض، فأُجري الحساب على أساس الحد الأعلى.","incomeTaxExempt":"تعويض نهاية الخدمة معفى من ضريبة الدخل؛ ولا يشمل الإعفاء ما يُدفع فوق الحد الأعلى."}},"infaz-hesaplama":{"name":"حساب تنفيذ العقوبة","summary":"يبيّن مدة الإفراج المشروط ومدة الإفراج تحت المراقبة والمدة التقديرية في السجن، بحسب تاريخ الجريمة ونوعها وحالة العَوْد.","intro":"يستند الحساب إلى المادتين 105/أ و 107 من قانون تنفيذ العقوبات والتدابير الأمنية رقم 5275، وإلى المادة 108 في حال العَوْد. النتيجة تقديرية فقط: لم تُحتسب مدة الحبس الاحتياطي، ولا ضمّ العقوبات، ولا السجن المؤبد والمؤبد المشدد، ولا الأنظمة الخاصة بالأحداث والمرضى، ولا الجرائم الخاضعة للقانون رقم 3713.","fields":{"sentenceYears":"العقوبة — سنوات","sentenceMonths":"العقوبة — أشهر","sentenceDays":"العقوبة — أيام","offencePeriod":"تاريخ ارتكاب الجريمة","offencePeriodHint":"في الجرائم المرتكبة قبل 30.03.2020 تكون مدة الإفراج تحت المراقبة ثلاث سنوات وفق المادة المؤقتة 6.","offenceType":"نوع الجريمة","offenceTypeHint":"في جرائم القائمة كالقتل العمد والجرائم الجنسية والاتجار بالمخدرات تكون نسبة الإفراج المشروط الثلثين.","repeatOffender":"العَوْد"},"options":{"offencePeriod_before2020":"قبل 30.03.2020","offencePeriod_after2020":"في 30.03.2020 أو بعده","offenceType_general":"جريمة خاضعة للقاعدة العامة","offenceType_aggravated":"جريمة من القائمة (نسبة الثلثين)","repeatOffender_no":"لا يوجد عَوْد","repeatOffender_yes":"يوجد عَوْد"},"results":{"totalSentence":"مجموع العقوبة (سنة / شهر / يوم)","appliedRatio":"نسبة الإفراج المشروط","paroleDuration":"حتى الإفراج المشروط (سنة / شهر / يوم)","supervisedRelease":"الإفراج تحت المراقبة (سنوات)","estimatedTimeServed":"المدة التقديرية في السجن (سنة / شهر / يوم)"},"notes":{"paroleScopeLimits":"لا يشمل الحساب ضمّ العقوبات ولا السجن المؤبد والمؤبد المشدد ولا الأنظمة الخاصة بالأحداث ومن تجاوز الخامسة والستين والمرضى.","paroleNoRemandCredit":"لم تُحتسب مدة الحبس الاحتياطي أو التوقيف، وهي تُقصّر مدة التنفيذ الفعلية.","paroleSeekCounsel":"يستلزم حساب التنفيذ فحص الحكم وتاريخ الجريمة على وجه محدد. هذه النتيجة ليست وثيقة حساب تنفيذ."}},"kira-artis-orani":{"name":"حساب نسبة زيادة الأجرة","summary":"يحسب الحد الأقصى القانوني لزيادة الأجرة عند التجديد، استنادًا إلى متوسط التغير في مؤشر أسعار المستهلك لاثني عشر شهرًا.","intro":"وفق المادة 344 من قانون الالتزامات رقم 6098، لا يجوز أن تتجاوز الزيادة في الأجرة نسبة التغير في متوسطات اثني عشر شهرًا لمؤشر أسعار المستهلك في سنة الإيجار السابقة. وإذا اتُّفق في العقد على نسبة أعلى فهي باطلة في القدر الزائد على المؤشر. أما سقف 25% في إيجارات المساكن فكان تدبيرًا مؤقتًا وانتهى العمل به في 1 تموز/يوليو 2024.","fields":{"currentRent":"الأجرة الشهرية الحالية","cpiRate":"متوسط التغير في مؤشر أسعار المستهلك لاثني عشر شهرًا (%)","cpiRateHint":"خذ النسبة الخاصة بشهر التجديد من السلسلة الرسمية لمعهد الإحصاء التركي. تتغير شهريًا، ولذلك ليست مضمَّنة في الأداة.","agreedRate":"النسبة المتفق عليها في العقد (%)","agreedRateHint":"أدخل النسبة الواردة في عقدك إن وجدت. إن كانت دون المؤشر طُبِّقت، وإن كانت فوقه طُبِّق المؤشر. اتركه فارغًا إن لم توجد."},"results":{"currentRent":"الأجرة الحالية","appliedRate":"النسبة المطبَّقة","increase":"مقدار الزيادة الشهرية","newRent":"الأجرة الشهرية الجديدة","legalMaximum":"الحد الأقصى القانوني للأجرة","annualDifference":"الفرق السنوي"},"notes":{"rentCapBasis":"يعتمد الحساب متوسط اثني عشر شهرًا للمؤشر حدًّا أعلى وفق المادة 344. ويسري الحد ذاته على إيجارات المحال التجارية.","agreedRateCapped":"تجاوزت النسبة المتفق عليها في العقد المؤشرَ، فطُبِّقت نسبة المؤشر بدلًا منها."}},"nafaka-artirim":{"name":"حساب زيادة النفقة","summary":"يحسب مقدار النفقة الحالي والزيادة الشهرية والفرق السنوي استنادًا إلى شرط الزيادة الوارد في الحكم.","intro":"كثيرًا ما تقضي الأحكام بزيادة النفقة سنويًا بنسبة معينة. والزيادة مركَّبة: تُطبَّق زيادة كل سنة على المبلغ الناتج عن زيادة السنة السابقة. وإذا أحال الحكم إلى مؤشر بدل نسبة، فأدخل الرقم الرسمي للفترة المعنية. أما إعادة تقدير النفقة لتغيّر الظروف (المادة 176/4 من القانون المدني) فدعوى مستقلة خارجة عن نطاق هذا الحساب.","fields":{"currentAlimony":"النفقة الشهرية الحالية","annualRate":"نسبة الزيادة السنوية (%)","annualRateHint":"أدخل النسبة الواردة في الحكم. وإن أحال إلى مؤشر أسعار المستهلك أو المنتجين فاستخدم الرقم الرسمي للفترة.","years":"عدد السنوات المطبَّقة"},"results":{"currentAlimony":"النفقة الحالية","appliedRate":"نسبة الزيادة السنوية","years":"عدد السنوات","updatedAlimony":"النفقة الشهرية المحدَّثة","monthlyIncrease":"مقدار الزيادة الشهرية","annualDifference":"الفرق السنوي"},"notes":{"alimonyCompounding":"طُبِّقت الزيادة تركيبيًا؛ فعند تعدد السنوات تُحتسب النسبة كل سنة على مبلغ السنة السابقة."}},"is-kazasi-tazminat":{"name":"حساب تعويض العجز عن حادث عمل","summary":"يحسب الضرر المادي الناشئ عن العجز الدائم عبر الفترات المعلومة والنشطة والخاملة، مع نسبة الخطأ وخصم مؤسسة الضمان الاجتماعي.","intro":"يُحسب تعويض العجز الدائم بتقسيم الضرر إلى فترة معلومة (من الحادث إلى تاريخ الحساب) وفترة نشطة (حتى نهاية الحياة العملية) وفترة خاملة (حتى نهاية العمر المتبقي). وتُعتمد في الفترة النشطة طريقة الإيراد التصاعدي المطبَّقة في اجتهاد محكمة التمييز؛ إذ تتعادل الزيادة السنوية بنسبة 10% مع الخصم بنسبة 10%، فتقابل كل سنة نشطة دخل سنة واحدة. أما العمر المتبقي فيُؤخذ من جدول الحياة TRH-2010 ويُدخل هنا يدويًا.","fields":{"monthlyEarning":"صافي الدخل الشهري","monthlyEarningHint":"صافي الدخل الشهري بتاريخ الحادث. تُحتسب الفترتان المعلومة والنشطة على أساسه.","disabilityRatio":"نسبة العجز الدائم (%)","disabilityRatioHint":"نسبة العجز المحددة في تقرير الضمان الاجتماعي أو الطب الشرعي.","faultRatio":"نسبة خطأ المضرور (%)","faultRatioHint":"النسبة المنسوبة إلى المضرور في تقرير الخبرة. يُخفَّض التعويض بمقدارها.","knownPeriodMonths":"الفترة المعلومة (أشهر)","activePeriodYears":"الفترة النشطة (سنوات)","activePeriodYearsHint":"عدد السنوات المتبقية من تاريخ الحساب حتى نهاية الحياة العملية.","passivePeriodYears":"الفترة الخاملة (سنوات)","passivePeriodYearsHint":"عدد السنوات من نهاية الحياة العملية حتى نهاية العمر المتبقي في جدول TRH-2010.","sgkCapitalValue":"القيمة الرأسمالية لإيراد الضمان الاجتماعي","sgkCapitalValueHint":"تُخصم من التعويض القيمة الرأسمالية لإيراد العجز الدائم المقرَّر من مؤسسة الضمان الاجتماعي. اتركه فارغًا إن لم يوجد."},"results":{"knownLoss":"ضرر الفترة المعلومة","activeLoss":"ضرر الفترة النشطة","passiveLoss":"ضرر الفترة الخاملة","grossLoss":"مجموع الضرر قبل خصم الخطأ","liabilityShare":"نسبة المسؤولية","afterFault":"بعد خصم الخطأ","sgkDeduction":"خصم الضمان الاجتماعي","net":"التعويض المادي التقديري"},"notes":{"trh2010Source":"يُؤخذ العمر المتبقي من جدول الحياة TRH-2010؛ وهو يختلف بحسب السن والجنس، ولذلك ليس مضمَّنًا في الأداة.","progressiveRentMethod":"طُبِّقت في الفترة النشطة طريقة الإيراد التصاعدي (زيادة 10% وخصم 10%).","expertReportRequired":"هذه النتيجة ليست تقريرًا اكتواريًا. ويُحسب الضرر في الدعوى بخبير تعيّنه المحكمة."}},"yillik-izin":{"name":"حساب الإجازة السنوية","summary":"يحسب مدة الإجازة السنوية مدفوعة الأجر المستحقة ورصيدها المتراكم استنادًا إلى تاريخ بدء العمل.","intro":"وفق المادة 53 من قانون العمل رقم 4857، لا تقل الإجازة السنوية مدفوعة الأجر عن أربعة عشر يومًا لمن كانت خدمته من سنة إلى خمس سنوات، وعشرين يومًا لمن تجاوزت خدمته خمس سنوات ودون خمس عشرة سنة، وستة وعشرين يومًا لمن بلغت خدمته خمس عشرة سنة فأكثر. ولا تقل عن عشرين يومًا لمن هم دون الثامنة عشرة أو فوق الخمسين. ولا ينشأ الاستحقاق إلا بعد سنة خدمة كاملة.","fields":{"startDate":"تاريخ بدء العمل","referenceDate":"تاريخ الحساب","usedDays":"أيام الإجازة المستخدمة","ageGroup":"حالة العامل","ageGroupHint":"بالنسبة لمن هم دون الثامنة عشرة أو فوق الخمسين لا تقل الإجازة السنوية عن عشرين يومًا."},"options":{"ageGroup_standard":"بين 18 و 50 سنة","ageGroup_protected":"دون 18 سنة أو فوق 50 سنة"},"results":{"completedYears":"سنوات الخدمة المكتملة","currentEntitlement":"المستحق عن هذه السنة (أيام)","accrued":"مجموع الإجازة المستحقة (أيام)","used":"الإجازة المستخدمة (أيام)","balance":"رصيد الإجازة (أيام)"},"notes":{"leaveIsMinimum":"المدد الواردة في القانون حدود دنيا، ويجوز زيادتها بعقد العمل أو باتفاقية العمل الجماعية.","usedExceedsAccrued":"يبدو أن الإجازة المستخدمة تتجاوز المستحقة. يرجى مراجعة القيم المُدخلة."}},"fazla-mesai":{"name":"حساب أجر العمل الإضافي","summary":"يحسب الأجر الإجمالي للساعات التي تتجاوز خمسًا وأربعين ساعة أسبوعيًا بنسبة 150%، والساعات التي تتجاوز أسبوع عمل تعاقديًا أقصر بنسبة 125%.","intro":"وفق المادة 41 من قانون العمل رقم 4857، يُعدّ العمل الذي يتجاوز خمسًا وأربعين ساعة أسبوعيًا عملًا إضافيًا ويُدفع بنسبة 150% من أجر الساعة. وإذا حدَّد العقد أسبوع عمل أقل من خمس وأربعين ساعة، فإن العمل بين ذلك الحد وخمس وأربعين ساعة يُعدّ عملًا لمدد إضافية ويُدفع بنسبة 125%. ولا يجوز أن يتجاوز العمل الإضافي مئتين وسبعين ساعة في السنة. ويُستخرج أجر الساعة بقسمة الأجر الشهري الإجمالي على 225.","fields":{"grossMonthlyWage":"الأجر الشهري الإجمالي","contractWeeklyHours":"ساعات العمل الأسبوعية في العقد","contractWeeklyHoursHint":"أدخل رقمًا فقط إذا حدَّد العقد أقل من خمس وأربعين ساعة. وإلا فاتركه 45.","actualWeeklyHours":"الساعات المؤداة فعليًا أسبوعيًا","weeks":"عدد الأسابيع"},"results":{"hourlyRate":"أجر الساعة الإجمالي","overtimeHours":"العمل الإضافي (ساعات)","overtimePay":"أجر العمل الإضافي (150%)","extraTimeHours":"العمل لمدد إضافية (ساعات)","extraTimePay":"أجر العمل لمدد إضافية (125%)","total":"مجموع المستحق الإجمالي"},"notes":{"grossFigures":"المبالغ إجمالية؛ لم تُخصم منها الضرائب ولا اشتراكات الضمان الاجتماعي.","overtimeCapExceeded":"يتجاوز العمل الإضافي المحسوب الحد السنوي البالغ مئتين وسبعين ساعة. وتجاوز الحد لا يُسقط الحق في الأجر."}},"issizlik-maasi":{"name":"حساب بدل البطالة","summary":"يحسب بدل البطالة الشهري استنادًا إلى دخل الأشهر الأربعة الأخيرة وأيام الاشتراك، مع الحد الأعلى ومدة الصرف.","intro":"وفق المادة 50 من قانون تأمين البطالة رقم 4447، يبلغ البدل اليومي 40% من متوسط الدخل اليومي الإجمالي الخاضع للاشتراك عن الأشهر الأربعة الأخيرة. ولا يجوز أن يتجاوز 80% من الحد الأدنى للأجر الإجمالي. ومدة الصرف 180 أو 240 أو 300 يوم بحسب أيام الاشتراك في السنوات الثلاث الأخيرة. ولا يُقتطع من البدل سوى رسم الطابع.","fields":{"averageGrossMonthly":"متوسط الدخل الشهري الإجمالي للأشهر الأربعة الأخيرة","averageGrossMonthlyHint":"المتوسط الشهري للدخل الإجمالي الخاضع للاشتراك خلال الأشهر الأربعة الأخيرة.","premiumDays":"أيام الاشتراك خلال السنوات الثلاث الأخيرة","premiumDaysHint":"يشترط للاستحقاق 600 يوم اشتراك على الأقل خلال السنوات الثلاث الأخيرة و 120 يومًا من الخدمة المتصلة."},"results":{"grossMonthly":"البدل الشهري الإجمالي","stampDuty":"رسم الطابع المقتطع","netMonthly":"صافي البدل الشهري","benefitDays":"مدة الصرف (أيام)","benefitMonths":"مدة الصرف (أشهر)","totalBenefit":"مجموع البدل الصافي"},"notes":{"benefitConditions":"يتوقف الاستحقاق على انتهاء عقد العمل لأحد الأسباب الواردة في القانون وعلى تقديم الطلب في الميعاد.","benefitCeilingApplied":"تجاوز البدل المحسوب 80% من الحد الأدنى للأجر الإجمالي، فطُبِّق الحد الأعلى."}},"miras-payi":{"name":"حساب أنصبة الميراث","summary":"يحسب الأنصبة القانونية والأنصبة المحفوظة للزوج الباقي والفروع والوالدين والإخوة وفق نظام الطبقات.","intro":"وفق المواد 495 إلى 501 من القانون المدني التركي تُقسَّم التركة بنظام الطبقات. الطبقة الأولى الفروع، والثانية الوالدان وفروعهما، والثالثة الأجداد. ووجود وارث في طبقة أقرب يحجب كل طبقة أبعد. ويرث الزوج الباقي مع أي طبقة تُستدعى بنصيب يزداد كلما بعُدت الطبقة. والأنصبة المحفوظة منظَّمة في المادة 506؛ وقد أُلغي النصيب المحفوظ للإخوة سنة 2007.","fields":{"estateValue":"صافي قيمة التركة","estateValueHint":"صافي التركة بعد تصفية نظام الأموال بين الزوجين وخصم الديون.","spouse":"الزوج الباقي على قيد الحياة","childCount":"عدد الأولاد (الفروع)","parentsAlive":"عدد الوالدين على قيد الحياة","parentsAliveHint":"يُعتدّ به فقط عند انتفاء الفروع. ونصيب الوالد المتوفى ينتقل إلى فروعه، أي إلى الإخوة.","siblingCount":"عدد الإخوة"},"options":{"spouse_yes":"موجود","spouse_no":"غير موجود","parentsAlive_0":"كلاهما متوفى","parentsAlive_1":"أحدهما على قيد الحياة","parentsAlive_2":"كلاهما على قيد الحياة"},"results":{"spouseShare":"نصيب الزوج الباقي","perChildShare":"نصيب كل ولد","childrenTotal":"مجموع نصيب الأولاد","perParentShare":"نصيب كل من الوالدين","parentsTotal":"مجموع نصيب الوالدين","perSiblingShare":"نصيب كل أخ","siblingsTotal":"مجموع نصيب الإخوة","reservedTotal":"مجموع النصيب المحفوظ","disposable":"القدر القابل للتصرف"},"notes":{"inheritanceMaritalRegime":"يجري الحساب على صافي التركة بعد تصفية نظام الأموال بين الزوجين. ويُفرز حق المشاركة للزوج الباقي قبل قسمة التركة، وهو في الغالب أكبر من نصيبه في الميراث.","inheritanceScopeLimits":"لا يشمل الحساب الحرمان من الإرث ولا رد التركة ولا علاقة التبني ولا التبرعات الخاضعة للإنقاص ولا حلول فروع الأخ محلّه.","inheritanceSiblingsNoReserve":"أُلغي النصيب المحفوظ للإخوة بالقانون رقم 5650 سنة 2007.","inheritanceSpouseAloneAssumption":"لانتفاء الفروع والوالدين والإخوة، افتُرض كذلك انتفاء الوارث في الطبقة الثالثة، فآلت التركة بكاملها إلى الزوج الباقي."}}},"contactPage":{"meta":{"title":"اتصل بنا","description":"بيانات التواصل ونموذج طلب موعد أدناه."},"label":"اتصل بنا","title":"طلب موعد","lead":"يمكنكم استخدام النموذج أدناه لطلب موعد بخصوص ملفكم، أو التواصل مع المكتب مباشرة. تُستخدم المعلومات المُرسَلة عبر النموذج فقط لتقييم طلبكم.","formLabel":"نموذج الطلب","requiredNote":"الحقول المؤشَّر عليها بعلامة نجمية إلزامية.","directLabel":"التواصل المباشر","officeLabel":"عنوان المكتب","mapLabel":"الموقع","mapTitle":"موقع المكتب — خرائط جوجل","serviceAreasLabel":"المناطق التي نخدمها","serviceAreasBody":"نقدّم خدماتنا في قانون العمل وقانون التنفيذ وقانون الطلاق والأسرة وقانون الإرث وقانون الإيجار، وذلك بشكل أساسي في {districts} والمناطق المجاورة لها.","reviewsLabel":"تقييمات جوجل","reviewRating":"{rating} من 5 نجوم","form":{"name":"الاسم الكامل","email":"البريد الإلكتروني","phone":"الهاتف (اختياري)","subject":"الموضوع","message":"رسالتكم","consent":"لقد قرأت <link>نص الإعلام بشأن حماية البيانات الشخصية (KVKK)</link> وأوافق على معالجة بياناتي الشخصية على هذا الأساس.","submit":"إرسال","submitting":"جارٍ الإرسال…","success":"تم استلام رسالتكم. سيتم التواصل معكم في أقرب وقت ممكن.","errorGeneric":"تعذّر إرسال رسالتكم. يرجى المحاولة لاحقاً.","errorValidation":"يرجى تعبئة النموذج بالكامل وبشكل صحيح.","errorRateLimit":"عدد محاولات كبير خلال وقت قصير. يرجى المحاولة لاحقاً.","errorConsent":"يجب الموافقة على نص الإعلام بشأن حماية البيانات الشخصية (KVKK) للمتابعة.","errorTooShort":"هذا الحقل قصير جدًا.","errorTooLong":"هذا الحقل طويل جدًا.","errorRequired":"هذا الحقل إلزامي.","errorInvalidEmail":"أدخل بريدًا إلكترونيًا صالحًا."}},"legalPages":{"kvkk":{"nav":"نص الإعلام بشأن حماية البيانات الشخصية"},"gizlilik":{"nav":"سياسة الخصوصية"}},"article":{"readingTime":"قراءة {minutes} دقيقة","publishedOn":"تاريخ النشر: {date}","updatedOn":"آخر تحديث: {date}","byAuthor":"الكاتب: {name}","categoryLabel":"التصنيف"},"footer":{"navTitle":"الموقع","officeTitle":"المكتب","contactTitle":"الاتصال","legalTitle":"تنبيه قانوني","barRegistration":"{bar} — رقم القيد: {registryNo}","kvkk":"نص الإعلام بشأن حماية البيانات الشخصية","privacy":"سياسة الخصوصية","rights":"© {year} بوراك أوغور أوزتورك. جميع الحقوق محفوظة.","phone":"الهاتف","email":"البريد الإلكتروني","whatsapp":"واتساب","serviceAreasNote":"نقدّم خدماتنا القانونية في سيليفري وتشاتالجا وبيوك تشكمجة وبيليك دوزو وإسنيورت وأفجلار والمناطق المجاورة لها، في مجالات قانون العمل وقانون التنفيذ وقانون الطلاق والأسرة وقانون الإرث وقانون الإيجار."},"disclaimer":{"title":"تنبيه قانوني","body":"المحتوى الوارد في هذا الموقع مقدَّم على سبيل الإعلام العام؛ وهو لا يشكّل استشارة قانونية ولا ينشئ علاقة بين المحامي وموكّله. وقبل اتخاذ أي قرار بشأن نزاع أو معاملة بعينها، يتعيّن الحصول على رأي قانوني يخص وضعكم الخاص. ولمّا كانت التشريعات والاجتهاد القضائي عرضة للتغيّر، فإن حداثة المحتوى غير مضمونة."},"cookieConsent":{"label":"تفضيلات ملفات تعريف الارتباط","body":"هل تسمحون لنا باستخدام ملف تعريف ارتباط لتسجيل إحصائيات زيارة أساسية؟ في حال الرفض، لن يتم تسجيل أي بيانات زيارة. للتفاصيل، يمكنكم مراجعة <link>نص الإعلام الخاص بحماية البيانات الشخصية (KVKK)</link>.","accept":"قبول","decline":"رفض"},"notFound":{"label":"خطأ 404","title":"الصفحة المطلوبة غير موجودة","body":"قد يكون الرابط قد نُقل أو أُزيل. ويمكنكم المتابعة من الصفحة الرئيسية.","home":"العودة إلى الصفحة الرئيسية"},"error":{"label":"خطأ","title":"حدث خطأ غير متوقع","body":"تعذّر إتمام العملية. يمكنكم إعادة تحميل الصفحة.","retry":"إعادة المحاولة"},"admin":{"login":{"meta":{"title":"تسجيل دخول الإدارة"},"eyebrow":"لوحة الإدارة","title":"تسجيل الدخول","email":"البريد الإلكتروني","password":"كلمة المرور","submit":"تسجيل الدخول","submitting":"جارٍ تسجيل الدخول…","errorValidation":"يرجى إدخال البريد الإلكتروني وكلمة المرور.","errorRateLimit":"عدد محاولات كبير. يرجى المحاولة لاحقاً.","errorInvalid":"البريد الإلكتروني أو كلمة المرور غير صحيحة."},"nav":{"dashboard":"نظرة عامة","messages":"الرسائل","articles":"المقالات","analytics":"تحليل الزيارات","password":"تغيير كلمة المرور","logout":"تسجيل الخروج","viewSite":"عرض الموقع"},"dashboard":{"title":"نظرة عامة","welcome":"مرحباً، {name}.","messagesStat":"رسائل غير مقروءة","articlesStat":"مقالات منشورة","translationTitle":"حالة الترجمة","translationLead":"تُظهر اللغات التي نُشرت بها كل مجموعة مقالات.","statusPublished":"منشور","statusDraft":"مسودة","statusMissing":"غير موجود","articlesComingSoon":"استخدموا صفحة \"المقالات\" في القائمة الجانبية لإضافة المقالات وتعديلها وحذفها."},"articlesPage":{"title":"المقالات","newArticle":"مقالة جديدة","titleColumn":"العنوان","localeColumn":"اللغة","statusColumn":"الحالة","updatedColumn":"آخر تحديث","statusPublished":"منشورة","statusDraft":"مسودة","empty":"لا توجد مقالات بعد."},"articleForm":{"back":"جميع المقالات","newTitle":"مقالة جديدة","editTitle":"تعديل المقالة","locale":"اللغة","status":"الحالة","statusDraft":"مسودة","statusPublished":"منشورة","title":"العنوان","slug":"الرابط (Slug)","slugHint":"الجزء الذي يظهر في عنوان الصفحة. يتم تصحيح الأحرف التركية تلقائيًا (ş→s، ğ→g، إلخ)؛ أما للعناوين العربية فاكتبوا الرابط بأنفسكم بأحرف لاتينية.","summary":"الملخص","content":"المحتوى (Markdown)","contentHint":"يمكن استخدام تنسيق Markdown - # للعناوين، **غامق** للنص الغامق، وما شابه.","categories":"الفئات","create":"إنشاء المقالة","save":"حفظ","submitting":"جارٍ الحفظ…","delete":"حذف المقالة","deleteConfirm":"سيتم حذف هذه المقالة نهائيًا. لا يمكن التراجع عن هذا الإجراء. هل تريد المتابعة؟","errorGeneric":"تعذّر الحفظ. يرجى المحاولة لاحقًا.","errorValidation":"يرجى تعبئة النموذج بشكل كامل وصحيح.","errorTooShort":"هذا الحقل قصير جدًا.","errorTooLong":"هذا الحقل طويل جدًا.","errorRequired":"هذا الحقل إلزامي.","errorSlugTaken":"هذا الرابط مستخدم بالفعل من قبل مقالة أخرى بهذه اللغة."},"analytics":{"title":"تحليل الزيارات","lead":"هذه الأرقام محفوظة في قاعدة بيانات الموقع الخاصة، وتخص فقط الزوار الذين وافقوا على استخدام ملفات تعريف الارتباط. لا يُستخدم Google Analytics أو أي طرف ثالث آخر.","totalVisitors":"إجمالي الزوار","newVisitorsToday":"زوار جدد اليوم","newVisitorsWeek":"زوار جدد هذا الأسبوع","newVisitorsMonth":"زوار جدد هذا الشهر","pageViewsToday":"مشاهدات الصفحات اليوم","pageViewsWeek":"مشاهدات الصفحات هذا الأسبوع","pageViewsMonth":"مشاهدات الصفحات هذا الشهر","filterLabel":"الفترة الزمنية","filter7":"آخر 7 أيام","filter30":"آخر 30 يومًا","filter90":"آخر 90 يومًا","visitorsChartTitle":"الزوار الفريدون يوميًا (آخر {days} يومًا)","pageViewsChartTitle":"مشاهدات الصفحات يوميًا (آخر {days} يومًا)","localeChartTitle":"توزيع الزيارات حسب اللغة (آخر {days} يومًا)","chartEmpty":"لا توجد بيانات بعد.","topPagesTitle":"الصفحات الأكثر مشاهدة (آخر {days} يومًا)","topPagesEmpty":"لا توجد بيانات بعد.","pathColumn":"الصفحة","viewsColumn":"المشاهدات","resetButton":"إعادة تعيين البيانات","resetConfirm":"سيتم حذف جميع إحصائيات الزيارات (الزوار ومشاهدات الصفحات) نهائيًا. لا يمكن التراجع عن هذا الإجراء. هل تريد المتابعة؟"},"messages":{"title":"الرسائل","empty":"لا توجد رسائل بعد.","statusNew":"جديدة","statusRead":"مقروءة","statusArchived":"مؤرشفة","markRead":"تعليم كمقروءة","archive":"أرشفة","delete":"حذف","back":"جميع الرسائل","from":"من","subject":"الموضوع","receivedOn":"تاريخ الاستلام","consentGiven":"تمت الموافقة على KVKK بتاريخ: {date}","deleteConfirm":"سيتم حذف هذه الرسالة نهائياً."},"password":{"title":"تغيير كلمة المرور","current":"كلمة المرور الحالية","new":"كلمة المرور الجديدة","confirm":"كلمة المرور الجديدة (تأكيد)","submit":"تحديث كلمة المرور","submitting":"جارٍ التحديث…","success":"تم تحديث كلمة المرور الخاصة بكم.","errorValidation":"يجب أن تتكون كلمة المرور الجديدة من 12 حرفاً على الأقل وأن تطابق حقل التأكيد.","errorCurrent":"كلمة المرور الحالية غير صحيحة.","errorGeneric":"تعذّر تحديث كلمة المرور."}}},"now":"$undefined","timeZone":"Europe/Istanbul","children":["$L22","$L23"]}]
