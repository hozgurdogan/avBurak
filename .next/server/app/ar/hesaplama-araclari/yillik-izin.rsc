12:["$","$L2c",null,{"formats":{"dateTime":{"long":{"day":"numeric","month":"long","year":"numeric","numberingSystem":"latn"},"short":{"day":"2-digit","month":"2-digit","year":"numeric","numberingSystem":"latn"}}},"locale":"ar","messages":{"site":{"attorney":"المحامي بوراك أوغور أوزتورك","attorneyShort":"بوراك أوغور أوزتورك","role":"محامٍ","monogramLabel":"بوراك أوغور أوزتورك — الصفحة الرئيسية"},"nav":{"primary":"القائمة الرئيسية","home":"الرئيسية","practiceAreas":"مجالات العمل","profile":"نبذة","articles":"المقالات","contact":"اتصل بنا","openMenu":"فتح القائمة","closeMenu":"إغلاق القائمة","skipToContent":"الانتقال إلى المحتوى","tools":"الأدوات","faq":"الأسئلة الشائعة","regions":"المناطق","getInTouch":"تواصل معنا","breadcrumb":"مسار التنقل"},"locale":{"label":"اللغة","change":"تغيير اللغة","current":"اللغة المختارة"},"home":{"meta":{"title":"المحامي بوراك أوغور أوزتورك","homeTitle":"المحامي بوراك أوغور أوزتورك | الاستشارات القانونية ومتابعة الدعاوى","description":"مكتب محاماة في إسنيورت: قانون العمل والتنفيذ والطلاق والأسرة والإيجار والإرث والشركات. استشارات ومتابعة قضايا بالتركية والإنجليزية والعربية."},"hero":{"label":"إسنيورت · بيوك تشكمجة · بيليك دوزو · ميمار أوبا","title":"المحامي بوراك أوغور أوزتورك","registrationLabel":"القيد","languagesLabel":"لغات العمل","languages":"التركية · الإنجليزية · العربية","focusLabel":"مجالات العمل","focus":"محامٍ في إسنيورت: قانون العمل والتنفيذ والأسرة","regionsLabel":"المناطق التي نخدمها","lead":"يعمل مكتبنا القانوني، ومقرّه إسنيورت، في مجالات قانون العمل، وقانون التنفيذ والإفلاس، وقانون الأسرة والطلاق، وقانون الإيجار، وقانون الإرث، وقانون حماية المستهلك، والاستملاك، وقانون التعويضات، والقانون الإداري، وقانون الشركات.","contact":"اتصل بنا","appointment":"طلب موعد","leadSecondary":"نقدّم لموكلينا، باللغات التركية والإنجليزية والعربية، خدمة قانونية دقيقة وشفافة وموجهة نحو الحلول، ترتكز على حماية الحقوق والمصالح، في مجالات الاستشارات القانونية وحل النزاعات ومتابعة إجراءات التقاضي."},"practice":{"label":"مجالات العمل","title":"المجالات القانونية","lead":"تبيّن العناوين الآتية المجالات التي يعمل فيها المكتب بصفة منتظمة.","all":"جميع مجالات العمل"},"profile":{"label":"نبذة","title":"عن المكتب","body":"يقوم المكتب على العمل المباشر في عدد محدود من الملفات. ويبدأ كل تكليف بفحص التشريعات الواجبة التطبيق والاجتهاد القضائي الجاري؛ ويتضمن التقييم المقدَّم إلى الموكّل عرضًا واضحًا للخيارات المتاحة وللمخاطر المرتبطة بكل خيار منها.","link":"عرض النبذة"},"articles":{"label":"المقالات","title":"أحدث الكتابات","lead":"ملاحظات في التشريع والتطبيق، محرَّرة على سبيل الإعلام العام.","all":"جميع المقالات"},"contact":{"label":"اتصل بنا","title":"طلب اجتماع","body":"لطلب اجتماع بشأن ملفكم، يمكنكم استعمال النموذج الوارد في صفحة الاتصال أو التواصل مع المكتب مباشرةً.","link":"صفحة الاتصال"}},"practiceAreas":{"is-hukuku":{"name":"قانون العمل","summary":"منازعات الفسخ وإعادة العمل، وتعويضات نهاية الخدمة والإخطار، ومستحقات العمل الإضافي والإجازات، ومطالبات التعويض الناشئة عن إصابات العمل.","body":["يشمل العمل متابعة الدعاوى وإجراءات الوساطة لصالح العامل وصاحب العمل في منازعات إنهاء عقد العمل، واحتساب ومتابعة تعويض نهاية الخدمة وتعويض الإخطار والعمل الإضافي والإجازة السنوية وسائر مستحقات العامل.","يُقدَّم الدعم أيضًا في مطالبات التعويض المادي والمعنوي الناشئة عن إصابات العمل والأمراض المهنية، ودعاوى إعادة العمل، وإجراءات إنهاء الخدمة الجماعي.","بالنسبة لطلب إعادة العمل بدعوى الفسخ غير المشروع من جانب العامل، يجب التقدم بطلب للوساطة خلال المدة المنصوص عليها قانونًا من تاريخ تبليغ إشعار الفسخ؛ وفي حال عدم التوصل إلى تسوية يمكن اللجوء إلى الدعوى القضائية. أما من جانب صاحب العمل، فينبغي مراعاة الشروط الإجرائية مثل أخذ إفادة الدفاع وتحرير المحضر وتبليغ إشعار الفسخ.","يعتمد إثبات العمل الإضافي والإجازة السنوية وسائر مستحقات العامل بشكل أساسي على المستندات الكتابية وأقوال الشهود وسجلات مكان العمل؛ ويمكن الاستعانة بأدوات حساب تعويض نهاية الخدمة والإجازة السنوية والعمل الإضافي وإعانة البطالة المتوفرة في هذا الموقع لتقدير المبالغ المستحقة بشكل أولي."]},"icra-hukuku":{"name":"قانون التنفيذ","summary":"إجراءات التنفيذ المستندة إلى حكم وغير المستندة إليه، والاعتراض وإبطاله، وإجراءات الحجز، وإجراءات الإفلاس والصلح الواقي.","body":["بالنسبة للدائن والمدين على حد سواء، يشمل العمل بدء إجراءات التنفيذ المستندة إلى حكم وغير المستندة إليه، والاعتراض على أمر الدفع، ودعاوى رفع الاعتراض أو إبطاله.","كما يشمل متابعة إجراءات الحجز والبيع، ودعاوى النفي والاسترداد، وإجراءات الإفلاس والصلح الواقي (الكونكورداتو).","من جانب المدين، يؤدي الاعتراض لدى دائرة التنفيذ خلال المدة القانونية من تاريخ تبليغ أمر الدفع إلى إيقاف الإجراءات؛ ومن جانب الدائن، يمكن اللجوء إلى رفع الاعتراض (أمام محكمة التنفيذ) أو إبطاله (أمام المحكمة العامة) لمواصلة التنفيذ.","يُطبَّق الحجز كقاعدة عامة على الأموال المنقولة وغير المنقولة والمستحقات القابلة للحجز والعائدة للمدين؛ وتُستثنى بعض الأموال والحقوق المنصوص عليها في القانون. يُنصح بتجهيز المستندات المثبتة للدين (العقد، الفاتورة، الشيك/السند، الحكم القضائي، إلخ) بشكل كامل في بداية العملية."]},"bosanma-aile-hukuku":{"name":"قانون الطلاق والأسرة","summary":"دعاوى الطلاق بالتراضي والمتنازع عليه، ومطالبات النفقة والتعويض، وتصفية النظام المالي الزوجي، وترتيبات الحضانة والزيارة.","body":["يشمل العمل متابعة دعاوى الطلاق بالتراضي والمتنازع عليه، وإعداد بروتوكول الطلاق، والمطالبة بالنفقة والتعويض المادي والمعنوي.","يُقدَّم الدعم أيضًا في دعاوى المشاركة في الأموال الناشئة عن تصفية النظام المالي الزوجي، وترتيبات الحضانة والزيارة، ودعاوى زيادة النفقة.","في الطلاق بالتراضي، يُشترط موافقة المحكمة على البروتوكول المتفق عليه بين الطرفين بشأن الحضانة والنفقة والتعويض وتقسيم الأموال؛ أما في الطلاق المتنازع عليه، فيجب دعم الادعاءات بمستندات كتابية وأقوال شهود وأي أدلة أخرى متوفرة.","تُراعى المصلحة الفضلى للطفل في ترتيبات الحضانة والزيارة؛ ويُحتسب مطلب المشاركة في الأموال عند تصفية النظام المالي الزوجي بناءً على الأموال المكتسبة خلال فترة الزواج. يُنصح بتحرير وكالة خاصة بإجراءات الطلاق والتخطيط المسبق لمراحل العملية."]},"miras-hukuku":{"name":"قانون الإرث","summary":"وثيقة حصر الإرث، وتحديد التركة وتقسيمها، وتحصيل نصيب الإرث، ودعاوى التنقيص والحرمان من الإرث.","body":["يشمل العمل الحصول على وثيقة حصر الإرث، وتحديد التركة وتقسيمها، ومتابعة إجراءات تحصيل نصيب الوريث من الورثة الآخرين.","كما يشمل دعاوى التنقيص، والحرمان من الإرث، والمنازعات الناشئة عن عقود الإرث.","يمكن التنازل عن الإرث (رفض الإرث) بالتقدم بطلب إلى محكمة الصلح المدنية خلال ثلاثة أشهر من تاريخ العلم بصفة الوريث؛ وفي حال فوات هذه المدة، يُعتبر الإرث - كقاعدة عامة - مكتسبًا دون قيد أو شرط من قبل الورثة الشرعيين.","تُعالَج ضمن هذا النطاق أيضًا دعاوى ادعاء المورّث بالتحايل (تهريب أموال الإرث)، ودعاوى التنقيص، وطلبات إنهاء الشيوع بين الورثة؛ وتُحدَّد المحكمة المختصة والمهل وفقًا للطبيعة الملموسة للملف."]},"kira-hukuku":{"name":"قانون الإيجار","summary":"منازعات تحديد وزيادة بدل الإيجار، ودعاوى الإخلاء، والتنفيذ المستند إلى تعهد الإخلاء، وإعداد عقود الإيجار.","body":["يشمل العمل تحديد بدل الإيجار وتكييفه، والمنازعات المتعلقة بنسبة زيادة الإيجار، وإعداد عقود الإيجار ومراجعتها.","يُقدَّم الدعم أيضًا في إجراءات التنفيذ المستندة إلى تعهد الإخلاء، والإخلاء بسبب التأخر في السداد، ودعاوى الإخلاء المستندة إلى حاجة المالك للسكن أو إعادة البناء.","يمكن طلب الإخلاء عن طريق التنفيذ - بإعذار المستأجر أو استنادًا إلى تعهد الإخلاء - كما يمكن طلبه عن طريق الدعوى القضائية للأسباب المنصوص عليها في القانون، مثل حاجة المالك أو أحد أقاربه للسكن، أو إعادة البناء/التطوير العمراني؛ ولكل سبب إجراءات ومهل خاصة به.","في دعاوى تكييف بدل الإيجار وتحديده، يُراعى معدل مؤشر أسعار المستهلك (TÜFE) لاثني عشر شهرًا عن الفترة السابقة إلى جانب أحكام العقد؛ ويمكن استخدام أداة حساب نسبة زيادة الإيجار المتوفرة في هذا الموقع لتحديد النسبة المطبقة."]},"tazminat-hukuku":{"name":"قانون التعويضات","summary":"مطالبات التعويض المادي والمعنوي الناشئة عن الفعل غير المشروع والإخلال بالعقد، وقضايا حوادث السير والأضرار الجسدية.","body":["عندما يتعرض شخص لضرر نتيجة فعل غير مشروع أو إخلال بعقد، يجوز للمتضرر المطالبة بالتعويض المادي والمعنوي بموجب أحكام الفعل غير المشروع والإخلال بالعقد في قانون الالتزامات التركي رقم 6098.","في حوادث السير والأضرار الجسدية وفقدان الدعم نتيجة الوفاة والمنافسة غير المشروعة والتعدي على الحقوق الشخصية، يتطلب تحديد مبلغ التعويض إثبات الرابط السببي بين الخطأ والضرر ونطاق الضرر بأدلة ملموسة.","في دعاوى التعويض، يؤثر خطأ المتضرر المشترك وواجب تخفيف الضرر ونطاق التغطية التأمينية بشكل مباشر على مبلغ التعويض؛ لذلك من المهم توثيق بنود الضرر بالتفصيل قبل تقديم المطالبة.","تختلف مهل التقادم في دعاوى التعويض بحسب نوع الواقعة، ويجب تقديم المطالبة خلال المهلة المحددة تجنبًا لسقوط الحق؛ ولتقدير تعويضات حوادث العمل يمكن الاستفادة من أداة حساب تعويض حادث العمل المتوفرة في هذا الموقع."]},"kentsel-donusum-hukuku":{"name":"قانون التحول العمراني","summary":"تحديد المباني المعرّضة للخطر بموجب القانون رقم 6306، وإجراءات التحول العمراني، وحل النزاعات بين الأطراف المعنية.","body":["يشمل قانون التحول العمراني تحديد مبنى كمبنى معرّض للخطر بموجب القانون رقم 6306 بشأن تحويل المناطق المعرّضة لخطر الكوارث، وإجراءات الإخلاء والهدم، وإعداد عقود البناء مقابل الشقق أو تقاسم العائد.","من بين النزاعات الشائعة: الاعتراض على تحديد المبنى كمبنى معرّض للخطر، والإجراء المطبّق في حال عدم توصل الملاك إلى الأغلبية القانونية المطلوبة للاتفاق، وشروط الاستفادة من مساعدة الإيجار والدعم الحكومي الآخر.","في عقود البناء مقابل الشقق الموقّعة بين المتعهد والملاك، يُعدّ التحديد الواضح لحصص كل مالك وتاريخ التسليم والشرط الجزائي والتكاليف الإضافية أمرًا مهمًا لتجنب النزاعات التي قد تظهر في مراحل لاحقة من العملية.","كما يُقدَّم الدعم للملاك أو المستأجرين أو أصحاب الحقوق العينية المحدودة الذين يكونون طرفًا في عملية التحول العمراني، في مسائل الإخلاء وإبطال/إعادة تسجيل الطابو ومطالبات التعويض."]},"tuketici-hukuku":{"name":"قانون حماية المستهلك","summary":"المطالبات الناشئة عن السلع والخدمات المعيبة، وإجراءات لجنة تحكيم المستهلك ومحكمة المستهلك، وعقود الاشتراك والبيع عن بُعد.","body":["بموجب القانون رقم 6502 بشأن حماية المستهلك، يشمل هذا المجال السلع أو الخدمات المعيبة، وحق التراجع عن عقود البيع عن بُعد، وفسخ عقود الاشتراك، والتعويض عن الضرر الذي يتعرض له المستهلك بسبب الشروط التعاقدية غير العادلة.","تُقدَّم النزاعات التي تقل عن الحد النقدي المحدد إلى لجنة تحكيم المستهلك؛ أما النزاعات التي تتجاوز هذا الحد، أو التي يُطعن فيها بقرار اللجنة، فتكون محكمة المستهلك هي المختصة (وفي الأماكن التي لا توجد فيها محكمة مستهلك، تتولى محكمة الحقوق العامة الابتدائية هذه الصفة).","في بيع السلع المعيبة، يتعين على المستهلك تحديد أي من الحقوق الاختيارية سيستخدم - الإصلاح المجاني، أو الاستبدال بسلعة مماثلة سليمة، أو تخفيض السعر، أو فسخ العقد - وفي البيع عن بُعد، تُعد مدة حق التراجع وكيفية استخدامه من النقاط الأكثر شيوعًا في النزاعات.","الحفاظ على العقد والفاتورة ووثيقة الضمان والمراسلات قبل التقديم يسهّل بشكل كبير إثبات المطالبة في كل من إجراءات لجنة التحكيم والمحكمة."]},"sirketler-hukuku":{"name":"قانون الشركات","summary":"تأسيس الشركات وتغيير شكلها، وتحرير النظام الأساسي، وزيادة رأس المال، والتنازل عن الحصص، واتفاقات الشركاء، وإجراءات الجمعية العامة.","body":["يشمل العمل في هذا المجال ابتداءً من مرحلة التأسيس: اختيار الشكل القانوني للشركة، وإعداد النظام الأساسي، وتحديد هيكل رأس المال، وإتمام إجراءات القيد.","وبعد التأسيس، تشمل الممارسة زيادة رأس المال وتخفيضه، والتنازل عن الحصص، وإعداد اتفاقات الشركاء، ومتابعة إجراءات الجمعية العامة ومجلس الإدارة، وكذلك عمليات تغيير الشكل والاندماج."]},"tahkim-ve-uyusmazlik-cozumu":{"name":"التحكيم وتسوية المنازعات","summary":"صياغة شروط التحكيم، وإجراءات التحكيم المؤسَّسي والحر، وتنفيذ أحكام التحكيم الأجنبية، والوساطة والتقاضي.","body":["يشمل العمل صياغة شروط التحكيم، وتحديد مقر ولغة التحكيم، ومتابعة إجراءات التحكيم المؤسسي أو الحر.","كما يشمل تنفيذ أحكام التحكيم الأجنبية في تركيا، والوساطة، وتسوية المنازعات عن طريق التقاضي."]},"kisisel-verilerin-korunmasi":{"name":"حماية البيانات الشخصية","summary":"أعمال الامتثال لقانون حماية البيانات الشخصية، ونصوص الإعلام والموافقة الصريحة، وسجل البيانات، والنقل إلى الخارج، وبلاغات خرق البيانات.","body":["في إطار القانون رقم 6698، يشمل العمل تحديد التزامات المتحكم بالبيانات، وإعداد سجل جرد البيانات، وصياغة نصوص الإعلام والموافقة الصريحة.","يُقدَّم الدعم في هيكلة عمليات نقل البيانات إلى خارج البلاد بما يتوافق مع التشريعات، وفي إجراءات الإخطار بخرق البيانات."]}},"practiceAreasPage":{"meta":{"title":"مجالات العمل","description":"يعمل المكتب في قانون العمل، وقانون التنفيذ، وقانون الطلاق والأسرة، وقانون الإرث، وقانون الإيجار، وقانون الشركات، والتحكيم وتسوية المنازعات، وحماية البيانات الشخصية."},"label":"مجالات العمل","title":"المجالات القانونية","lead":"تبيّن العناوين أدناه المجالات التي يعمل فيها المكتب بصفة منتظمة.","cta":"عرض التفاصيل"},"practiceAreaDetail":{"back":"جميع مجالات العمل","relatedLabel":"مقالات ذات صلة","relatedEmpty":"لم يُنشر بعد أي مقال في هذا المجال.","relatedToolsLabel":"أدوات الحساب ذات الصلة","contactCta":"تواصل معنا"},"serviceRegions":{"esenyurt":{"name":"إسنيورت","pageTitle":"محامٍ في إسنيورت | بوراك أوغور أوزتورك","h1":"إسنيورت · المحامي بوراك أوغور أوزتورك","summary":"استشارات ومتابعة دعاوى العمل والتنفيذ والأسرة والإيجار والإرث المتعلقة بإسنيورت. المحامي بوراك أوغور أوزتورك.","body":["تُقيّم ملفات العمل والتنفيذ والأسرة والإيجار والإرث والشركات المتعلقة بإسنيورت على أساس الوثائق وطلبات الأطراف والمسارات القانونية الممكنة. يمكن إجراء الاجتماعات بالتركية والإنجليزية والعربية."],"relatedAreas":["is-hukuku","icra-hukuku","bosanma-aile-hukuku","miras-hukuku","kira-hukuku","tazminat-hukuku","kentsel-donusum-hukuku","tuketici-hukuku","sirketler-hukuku","tahkim-ve-uyusmazlik-cozumu","kisisel-verilerin-korunmasi"],"cardSummary":"المستحقات العمالية والتنفيذ ونزاعات الأسرة.","sections":[{"id":"is-icra-aile","title":"نزاعات العمل والتنفيذ والأسرة","paragraphs":["تساعد عقود العمل وكشوف الأجور وسجلات الدفع ووثائق إنهاء العمل في التقييم. وفي ملفات التنفيذ والأسرة تُجهّز الإشعارات كاملة وتاريخ التبليغ ورقم الملف والقرارات السابقة."]},{"id":"kira-miras-kurumsal","title":"ملفات الإيجار والإرث والشركات","paragraphs":["تساعد عقود الإيجار والمدفوعات، وسجلات العقار وحصر الإرث، أو وثائق الشركة والتفويض في تحديد موضوع الملف بحسب نوعه."]},{"id":"belge-hazirligi","title":"الوثائق اللازمة قبل الاجتماع","paragraphs":["رتّب التبليغات والعقود وسجلات الدفع والمراسلات بحسب التاريخ. تُحدّد الوثائق الناقصة والمهل الخاصة بكل ملف على حدة."]}],"faq":[{"question":"ضمن أي دائرة قضائية تقع إسنيورت؟","answer":"تقع ضمن دائرة محكمة بيوك تشكمجة، مع ضرورة تقييم الاختصاص في الدعوى المحددة بشكل منفصل."},{"question":"ماذا أجهّز عند وصول أمر دفع؟","answer":"جهّز الأمر كاملاً ومعلومات التبليغ والعقد إن وجد وسجلات الدفع. تُحدّد المهلة بحسب نوع إجراءات التنفيذ."}],"guideLink":"اطّلع على الدليل القانوني لمنطقة إسنيورت","jurisdictionTitle":"ضمن أي دائرة قضائية تقع إسنيورت؟"},"buyukcekmece":{"name":"بيوك تشكمجة","pageTitle":"محامٍ في بيوك تشكمجة | بوراك أوغور أوزتورك","h1":"بيوك تشكمجة · المحامي بوراك أوغور أوزتورك","summary":"استشارات وتقييم وثائق ومتابعة دعاوى الإيجار والإرث والعمل والأسرة المتعلقة ببيوك تشكمجة.","body":["تُراجع طلبات الإيجار والإرث والعمل والأسرة المتعلقة ببيوك تشكمجة من خلال العقود وسجلات العقار والمدفوعات ووثائق الدعاوى القائمة."],"relatedAreas":["is-hukuku","icra-hukuku","bosanma-aile-hukuku","kira-hukuku","miras-hukuku"],"cardSummary":"إجراءات الإيجار والإرث والأسرة.","sections":[{"id":"kira-miras","title":"التقييم الأولي للإيجار والإرث","paragraphs":["جهّز عقد الإيجار وسجل المدفوعات والإشعارات، أو وثيقة حصر الإرث وسجلات العقار والنقل. افصل وثائق العقارات المختلفة."]},{"id":"aile-is","title":"إجراءات الأسرة والعمل","paragraphs":["تُراجع القرارات السابقة والاتفاقات وسجلات الممتلكات في ملفات الأسرة، ووثائق العمل والأجر في ملفات العمل. يُحدّد المسار والمهل لكل ملف."]}],"faq":[{"question":"ما السجلات المهمة في نزاع الأجرة؟","answer":"يُراجع العقد وسجل الدفع واتفاقات التجديد والإنذارات معاً.","articleRef":"tr-makaleler-kira-bedelinin-tespiti-davasi"},{"question":"هل يوجد دليل خاص بميمار أوبا؟","answer":"يتناول دليل ميمار أوبا إعداد وثائق إدارة المجمعات والإيجار والإرث، ويوجد رابطه في هذه الصفحة."}],"guideLink":"اطّلع على الدليل القانوني لمنطقة بيوك تشكمجة","jurisdictionTitle":"ضمن أي دائرة قضائية تقع بيوك تشكمجة؟"},"beylikduzu":{"name":"بيليك دوزو","pageTitle":"محامٍ في بيليك دوزو | بوراك أوغور أوزتورك","h1":"بيليك دوزو · المحامي بوراك أوغور أوزتورك","summary":"استشارات ومتابعة دعاوى الإيجار والعمل والتنفيذ والأسرة المتعلقة ببيليك دوزو. المحامي بوراك أوغور أوزتورك.","body":["تُقيّم طلبات الإيجار والعمل والتنفيذ والأسرة المتعلقة ببيليك دوزو على أساس العقود والتبليغات والمدفوعات والأدلة الخاصة بكل ملف."],"relatedAreas":["kira-hukuku","is-hukuku","bosanma-aile-hukuku","icra-hukuku"],"cardSummary":"وثائق الإيجار والعمل وإدارة المجمعات.","sections":[{"id":"kira-is","title":"نزاعات الإيجار والعمل","paragraphs":["تُراجع العقود وسجلات التسليم والدفع في طلبات الإخلاء المبكر والأجرة والتأمين. وتشمل ملفات العمل مدة العمل والأجر والإنهاء ووثائق الوساطة إن وجدت."]},{"id":"site-belgeleri","title":"وثائق المجمعات والمباني","paragraphs":["جهّز اسم المجمع والمبنى والوحدة ومراسلات الإدارة وخطة الإدارة والقرارات وكشوف الحساب. وتُضاف كشوف الأجر والعقد ووثائق الإنهاء في ملفات العمل."]}],"faq":[{"question":"هل يدفع المستأجر جميع الأجور المتبقية عند الخروج مبكراً؟","answer":"لا يمكن تحديد مبلغ قطعي قبل مراجعة العقد وسجلات التسليم.","articleRef":"kiraci-erken-cikarsa-kalan-kira"},{"question":"ما وثائق الاعتراض على قرار لجنة المستهلك؟","answer":"جهّز القرار كاملاً ومعلومات التبليغ وملف الطلب ووثائق المعاملة، ويُراجع المسار والمهلة بحسب الملف.","articleRef":"tuketici-hakem-heyeti-kararina-itiraz"}],"guideLink":"اطّلع على الدليل القانوني لمنطقة بيليك دوزو","jurisdictionTitle":"ضمن أي دائرة قضائية تقع بيليك دوزو؟"},"avcilar":{"name":"أفجلار","pageTitle":"محامٍ في أفجلار | بوراك أوغور أوزتورك","h1":"أفجلار · المحامي بوراك أوغور أوزتورك","summary":"مراجعة عقود واستشارات ومتابعة دعاوى التحول العمراني والإيجار والعمل والتنفيذ المتعلقة بأفجلار.","body":["تُقيّم طلبات أفجلار المتعلقة باتفاقات التحول العمراني والإيجار ونزاعات الدفع أو التسليم من خلال وثائق الملف. وتُراجع ملفات العمل والتنفيذ بحسب إجراءاتها الخاصة."],"relatedAreas":["is-hukuku","icra-hukuku","bosanma-aile-hukuku","kira-hukuku","miras-hukuku"],"cardSummary":"التحول العمراني وعقود الإيجار.","sections":[{"id":"donusum-sozlesme","title":"التحول العمراني ومراجعة العقود","paragraphs":["جهّز بيانات العقار والوحدة وملحقات العقد وقرارات الشركاء والإشعارات. تُراجع مسائل التسليم والدفع والتفويض والالتزامات في إطار العقد كاملاً."]},{"id":"kira-icra","title":"وثائق الإيجار والتنفيذ","paragraphs":["عند التسليم المبكر أو تعهد الإخلاء أو أمر الدفع، جهّز المستند ومعلومات التبليغ والمدفوعات. لا تُفترض مهلة واحدة لجميع الإجراءات."]}],"faq":[{"question":"هل تكفي صفحة توقيع اتفاق التحول العمراني؟","answer":"ينبغي مراجعة الاتفاق كاملاً وملحقاته وبيانات العقار والقرارات ذات الصلة."},{"question":"كيف يُقيّم تعهد الإخلاء؟","answer":"تُراجع ظروف إعداده وتسليمه وتواريخه وعلاقة الإيجار معاً.","articleRef":"tahliye-taahhudu-ne-zaman-gecerlidir"}],"guideLink":"اطّلع على الدليل القانوني لمنطقة أفجلار","jurisdictionTitle":"ضمن أي دائرة قضائية تقع أفجلار؟"},"kucukcekmece":{"name":"كوتشوك تشكمجة","pageTitle":"محامٍ في كوتشوك تشكمجة | بوراك أوغور أوزتورك","h1":"كوتشوك تشكمجة · المحامي بوراك أوغور أوزتورك","summary":"استشارات ومسارات متابعة دعاوى إيجار السكن والعمل ونزاعات المستهلك والتنفيذ المتعلقة بكوتشوك تشكمجة.","body":["تُقيّم ملفات الإيجار السكني والتجاري ومعاملات المستهلك والتنفيذ المتعلقة بكوتشوك تشكمجة بحسب مستندات المعاملة والتبليغات والقرارات القائمة."],"relatedAreas":["is-hukuku","icra-hukuku","bosanma-aile-hukuku","kira-hukuku","miras-hukuku"],"cardSummary":"طلبات المستهلك والإيجار والتنفيذ.","sections":[{"id":"tuketici","title":"معاملات المستهلك والقرارات","paragraphs":["جهّز الفاتورة أو العقد وسجلات الطلب والتسليم ومراسلات البائع ووثائق الصيانة وقرار اللجنة إن وجد مع معلومات تبليغه."]},{"id":"kira-odeme","title":"الإيجار والتأمين والمدفوعات","paragraphs":["تُراجع عقود الإيجار وسجلات التأمين والأجرة ومحضر التسليم والمراسلات معاً. عند بدء التنفيذ تُضاف أوراق الملف ورقمه."]}],"faq":[{"question":"ما مستندات طلب المنتج المعيب؟","answer":"تُجهّز وثائق الشراء والتسليم وما يثبت العيب ومراسلات البائع أو الصيانة.","articleRef":"ayipli-mal-tuketici-haklari"},{"question":"أي تاريخ يُراجع عند الاعتراض على قرار لجنة المستهلك؟","answer":"تُجهّز سجلات التبليغ ويُراجع المسار والمهلة بحسب القرار المحدد.","articleRef":"tuketici-hakem-heyeti-kararina-itiraz"}],"guideLink":"اطّلع على الدليل القانوني لمنطقة كوتشوك تشكمجة","jurisdictionTitle":"ضمن أي دائرة قضائية تقع كوتشوك تشكمجة؟"},"silivri":{"name":"سيليفري","pageTitle":"محامٍ في سيليفري | بوراك أوغور أوزتورك","h1":"سيليفري · المحامي بوراك أوغور أوزتورك","summary":"تقييم وثائق واستشارات ومتابعة دعاوى الإرث والعقارات المشتركة والإيجار والعمل المتعلقة بسيليفري.","body":["تشمل ملفات الإرث والعقارات المشتركة المتعلقة بسيليفري سجلات الملكية والحصص والاستعمال والمعاملات السابقة. وتتطلب ملفات الإيجار والعمل عقودها وإشعاراتها الخاصة."],"relatedAreas":["is-hukuku","icra-hukuku","bosanma-aile-hukuku","kira-hukuku","miras-hukuku"],"cardSummary":"العقارات المشتركة وقسمة الإرث.","sections":[{"id":"paydas-tasinmaz","title":"تنظيم وثائق العقار المشترك","paragraphs":["جهّز بيانات الطابو وقائمة الشركاء وسجلات الاستعمال أو الإيجار والاتفاقات السابقة لكل عقار. تختلف شروط إنهاء الشيوع عن المطالب المتعلقة بالاستعمال."]},{"id":"miras-paylasim","title":"قسمة الإرث ونقل الحصص","paragraphs":["تُراجع وثيقة حصر الإرث وسجلات العقار والنقل معاً. عند بيع حصة أو استعمال العقار منفرداً تُجهّز التواريخ والإشعارات ذات الصلة."]}],"faq":[{"question":"كيف تُرتّب وثائق عدة عقارات؟","answer":"افصل بيانات الطابو والاستعمال لكل عقار مع وثيقة حصر الإرث ووثائق النقل.","articleRef":"ortakligin-giderilmesi-davasi"},{"question":"هل يُقيّم بيع الحصة والاستعمال المنفرد بصورة منفصلة؟","answer":"قد تتعلق هذه الوقائع بمطالب مختلفة، لذلك تُراجع كل معاملة على حدة.","articleRef":"sufa-onalim-hakki-davasi"}],"guideLink":"اطّلع على الدليل القانوني لمنطقة سيليفري","jurisdictionTitle":"ضمن أي دائرة قضائية تقع سيليفري؟"},"catalca":{"name":"تشاتالجا","pageTitle":"محامٍ في تشاتالجا | بوراك أوغور أوزتورك","h1":"تشاتالجا · المحامي بوراك أوغور أوزتورك","summary":"استشارات وتقييم ملفات ومتابعة دعاوى الأراضي والإرث ونزع الملكية والإيجار المتعلقة بتشاتالجا.","body":["تُراجع طلبات الأراضي والإرث ونزع الملكية والإيجار المتعلقة بتشاتالجا من خلال بيانات القطع وتاريخ الملكية والوثائق الإدارية أو التعاقدية. تُحدّد الجهة المختصة بحسب نوع الطلب."],"relatedAreas":["is-hukuku","icra-hukuku","bosanma-aile-hukuku","kira-hukuku","miras-hukuku"],"cardSummary":"الأراضي والإرث وملفات نزع الملكية.","sections":[{"id":"arazi-kamulastirma","title":"وثائق الأراضي ونزع الملكية","paragraphs":["جهّز سجلات العقار والقطع والقرارات الإدارية والتبليغات وأدلة الاستعمال أو التدخل. لا يُفترض تطابق الإجراء الإداري والتدخل المادي."]},{"id":"miras-kira","title":"طلبات الإرث والإيجار","paragraphs":["تُراجع وثيقة حصر الإرث وسجلات الحصص أو النقل وعقود الإيجار معاً. يساعد ترتيب الوثائق بحسب الحوض والقطعة على تجنب الخلط بين العقارات."]}],"faq":[{"question":"هل يكفي اسم الحي لتحديد الأرض؟","answer":"ينبغي تجهيز بيانات الحوض والقطعة والطابو ووثائق المعاملة."},{"question":"ما الذي يُراجع في طلب الاستيلاء دون نزع ملكية؟","answer":"تُراجع الملكية وطبيعة التدخل والوثائق الإدارية والاستعمال، ويُحدّد المسار والمهل بحسب الملف.","articleRef":"kamulastirmasiz-el-atma-fiili-hukuki-el-atma"}],"guideLink":"اطّلع على الدليل القانوني لمنطقة تشاتالجا","jurisdictionTitle":"ضمن أي دائرة قضائية تقع تشاتالجا؟"},"mimaroba":{"name":"ميماروبا","pageTitle":"محامٍ في ميماروبا | بوراك أوغور أوزتورك","h1":"ميماروبا · المحامي بوراك أوغور أوزتورك","summary":"استشارات ومتابعة دعاوى الإيجار وإدارة المجمعات والإرث والأسرة المتعلقة بميمار أوبا. المحامي بوراك أوغور أوزتورك.","body":["تُقدّم الاستشارات ومتابعة الدعاوى المتعلقة بالإيجار وإدارة المجمعات والإرث والعمل والأسرة للأشخاص الباحثين عن مساعدة قانونية بشأن ميمار أوبا. يشمل التقييم الأولي موضوع النزاع والوثائق والمسارات القانونية الممكنة."],"relatedAreas":["is-hukuku","icra-hukuku","bosanma-aile-hukuku","kira-hukuku","miras-hukuku"],"cardSummary":"نزاعات إدارة المجمعات والإيجار والإرث.","sections":[{"id":"site-kira","title":"إدارة المجمعات والإيجار في ميمار أوبا","paragraphs":["تختلف مستندات الاشتراكات والمصاريف المشتركة وقرارات الإدارة والأجرة والإخلاء. تُراجع خطة الإدارة والقرارات وكشوف الحساب والمدفوعات، وفي ملفات الإيجار يُراجع العقد والإيصالات والإنذارات إن وجدت."]},{"id":"belge-hazirligi","title":"ما الوثائق التي ينبغي تجهيزها؟","paragraphs":["جهّز اسم المجمع والمبنى والوحدة والمراسلات والتبليغات. تفيد وثيقة حصر الإرث وسجلات العقار في ملفات الميراث، والعقود وكشوف الأجر ووثائق الإنهاء في ملفات العمل."]}],"faq":[{"question":"كيف يُقيّم طلب اشتراكات المجمع؟","answer":"يُراجع أساس الطلب وخطة الإدارة والقرارات وكشوف الحساب معاً."},{"question":"هل تُدفع جميع الأجور بعد الإخلاء المبكر؟","answer":"لا يمكن تحديد مبلغ قطعي دون مراجعة العقد ومعلومات التسليم.","articleRef":"kiraci-erken-cikarsa-kalan-kira"},{"question":"ما أول وثائق العقار الموروث؟","answer":"تُجهّز وثيقة حصر الإرث وبيانات الطابو ووثائق القسمة أو النقل إن وجدت.","articleRef":"miras-kalan-ev-ecrimisil-davasi"}],"guideLink":"اطّلع على الدليل القانوني لمنطقة ميماروبا","jurisdictionTitle":"ضمن أي دائرة قضائية تقع ميماروبا؟"}},"serviceRegionsPage":{"meta":{"title":"المناطق التي نخدمها","description":"أدلة قانونية للمناطق مع المجالات والمقالات ذات الصلة بإسنيورت وبيليك دوزو وبيوك تشكمجة وميمار أوبا وأفجلار وكوتشوك تشكمجة وسيليفري وتشاتالجا."},"label":"المناطق","title":"المناطق التي تشملها المتابعة","lead":"يقدم المحامي بوراك أوغور أوزتورك الاستشارات ومتابعة الدعاوى المتعلقة بإسنيورت وبيليك دوزو وبيوك تشكمجة وميمار أوبا وأفجلار وكوتشوك تشكمجة وسيليفري وتشاتالجا. توضح أدلة المناطق المجالات القانونية والوثائق اللازمة وإجراءات التقييم."},"serviceRegionDetail":{"back":"جميع المناطق","relatedAreasLabel":"مجالات العمل ذات الصلة","contactCta":"تواصل معنا","tocLabel":"محتويات الصفحة","faqTitle":"أسئلة شائعة","articlesTitle":"مقالات ذات صلة","articlesLead":"تتناول الأدلة المنشورة التالية موضوعات ذات صلة بالطلبات المتعلقة بهذه المنطقة.","toolsTitle":"أدوات حساب ذات صلة","regionsTitle":"أدلة مناطق ذات صلة","jurisdictionText":"تقع إسنيورت ضمن الدائرة القضائية لمحكمة بيوك تشكمجة التي تشمل بيوك تشكمجة وبيليك دوزو وإسنيورت. ومع ذلك، تُحدّد المحكمة المختصة في كل ملف بشكل منفصل بحسب نوع النزاع والتنظيمات الخاصة للدائرة القضائية وقواعد الاختصاص القانونية.","jurisdictionCaveat":"لا يعني ذلك أن جميع قضايا العمل أو المستهلك أو التجارة أو الجنايات تُنظر بالضرورة في المحكمة نفسها. يجب التمييز بين الدائرة القضائية العامة وقواعد الاختصاص المتعلقة بنوع الدعوى.","jurisdictionSource":"المصدر الرسمي: تقرير أنشطة محكمة باكيركوي لعام 2025، مارس 2026، ص 3 (بالتركية)","mimarobaJurisdictionIntro":"ميمار أوبا حي تابع لبيوك تشكمجة ويقع ضمن الدائرة القضائية لمحكمة بيوك تشكمجة."},"profilePage":{"meta":{"title":"نبذة","description":"المحامي بوراك أوغور أوزتورك — مقيَّد لدى نقابة محامي إسطنبول. لغات العمل: التركية والإنجليزية والعربية."},"label":"نبذة","title":"المحامي بوراك أوغور أوزتورك","intro":"يمارس المحامي بوراك أوغور أوزتورك المحاماة بشكل مستقل، وهو مقيَّد لدى نقابة محامي إسطنبول. لغات العمل هي التركية والإنجليزية والعربية، مما يتيح التواصل المباشر مع المستثمرين الأجانب والأطراف متعددة الجنسيات.","portraitAlt":"المحامي بوراك أوغور أوزتورك","admissionLabel":"القيد لدى النقابة","languagesLabel":"لغات العمل","languages":"التركية، الإنجليزية، العربية","approachTitle":"منهج العمل","approachBody":["يبدأ كل ملف بفحص التشريعات الواجبة التطبيق والاجتهاد القضائي الجاري. ويُعَدّ التقييم الذي يُقدَّم للموكّل بحيث يوضح بعبارات واضحة الخيارات المتاحة، والمخاطر المرتبطة بكل خيار، والآجال المتوقعة.","يُحافَظ على عدد الملفات المفتوحة ضمن حدود معقولة لضمان تخصيص وقت كافٍ لكل ملف. ويقوم التواصل مع الموكّل على أساس التحديث المنتظم في كل مرحلة من مراحل العملية."],"scopeTitle":"مجالات العمل","scopeLinkText":"عرض مجالات العمل","contactCta":"تواصل معنا"},"articlesPage":{"meta":{"title":"المقالات","description":"مقالات توعوية من المحامي بوراك أوغور أوزتورك حول الأسئلة الأكثر شيوعًا في قانون العمل والتنفيذ والطلاق والأسرة والإيجار والإرث والتعويضات والشركات."},"label":"المقالات","title":"أحدث الكتابات","lead":"مقالات ذات طابع إعلامي عام حول التشريعات والتطبيق. يمكن تصفية القائمة أدناه حسب التصنيف.","filterAll":"الكل","filterLabel":"التصنيف","searchLabel":"البحث في المقالات","searchPlaceholder":"كلمة مفتاحية","searchSubmit":"بحث","empty":"لا توجد مقالات مطابقة لهذا الفلتر.","prevPage":"السابق","nextPage":"التالي","pageLabel":"صفحة {page} من {totalPages}"},"articleDetail":{"back":"العودة إلى جميع المقالات","tocLabel":"المحتويات","relatedLabel":"مقالات ذات صلة","authorLabel":"الكاتب","authorDescription":"نقابة المحامين في إسطنبول · رقم القيد: 84442 · لغات العمل: التركية والإنجليزية والعربية.","sourcesLabel":"المصادر التشريعية الرسمية (بالتركية)","regionsLabel":"أدلة مناطق ذات صلة"},"toolsPage":{"meta":{"title":"أدوات الحساب","description":"أدوات حسابية لأغراض المعلومات العامة: تعويض نهاية الخدمة، الإجازة السنوية، العمل الإضافي، بدل البطالة، زيادة الأجرة، النفقة، تنفيذ العقوبة وأنصبة الميراث وفق القانون التركي."},"label":"الأدوات","title":"أدوات الحساب القانوني","lead":"أدوات حسابية لأغراض المعلومات العامة، تستند إلى التشريعات النافذة. ما تُدخله يبقى في متصفحك؛ لا يُحفظ أي بيان ولا يُرسل. النتائج لا تُغني عن دراسة وقائع حالتك.","back":"جميع أدوات الحساب","otherToolsLabel":"أدوات أخرى"},"tools":{"form":{"inputsLabel":"البيانات","resultLabel":"النتيجة","submit":"احسب","reset":"مسح","idle":"املأ الحقول ثم اضغط احسب. ما تُدخله يبقى في متصفحك.","parametersUnverified":"لم يتم بعد التحقق من تحديث المقادير القانونية المستخدمة في هذه الأداة. قارنها بالمبالغ الرسمية للفترة الجارية قبل الاعتماد على النتيجة.","privacyNote":"تُعالَج البيانات التي تُدخلها في متصفحك فقط؛ ولا يُحفظ أي بيان ولا يُرسل."},"parameters":{"severanceCeilingPerYear":"الحد الأعلى لتعويض نهاية الخدمة","minimumWageGrossMonthly":"الحد الأدنى للأجر الإجمالي","stampDutyRate":"نسبة رسم الطابع"},"errors":{"missingFields":"يرجى إكمال جميع الحقول الإلزامية.","invalidAmount":"المبلغ أو الرقم المُدخل غير صالح.","endBeforeStart":"يجب أن يكون تاريخ الانتهاء لاحقًا لتاريخ البدء.","serviceTooShort":"يشترط لاستحقاق تعويض نهاية الخدمة مضيّ سنة كاملة من الخدمة على الأقل.","leaveNotYetAccrued":"يشترط لاستحقاق الإجازة السنوية مدفوعة الأجر مضيّ سنة كاملة من الخدمة على الأقل.","invalidContractHours":"يجب أن تكون ساعات العمل الأسبوعية في العقد بين 1 و 45 ساعة.","noOvertime":"الساعات المُدخلة لا تتجاوز مدة العمل المتفق عليها، فلا ينشأ أجر عمل إضافي.","premiumDaysTooLow":"يشترط سداد 600 يوم اشتراك على الأقل خلال السنوات الثلاث الأخيرة.","invalidRatio":"يجب أن تكون النسبة بين 0 و 100.","invalidPeriod":"المدة المُدخلة غير صالحة.","noHeirsInOrder":"لا يوجد وارث في هذه الطبقة وفق البيانات المُدخلة.","estateEscheats":"عند انتفاء الوارث في جميع الطبقات وانتفاء الزوج الباقي على قيد الحياة تؤول التركة إلى الدولة (المادة 501 من القانون المدني)."},"kidem-tazminati":{"name":"حساب تعويض نهاية الخدمة","summary":"يحسب تعويض نهاية الخدمة استنادًا إلى تاريخي بدء العمل وانتهائه والأجر الإجمالي الشامل، مع تطبيق الحد الأعلى النافذ ورسم الطابع.","intro":"يُحسب تعويض نهاية الخدمة وفق المادة 14 من قانون العمل رقم 1475، المبقاة نافذة بالمادة المؤقتة 6 من القانون رقم 4857. يُستحق عن كل سنة خدمة كاملة أجر ثلاثين يومًا من الأجر الإجمالي الشامل، وتُحتسب المدد الجزئية بالتناسب. التعويض معفى من ضريبة الدخل، ولا يُقتطع منه سوى رسم الطابع. يفترض الحساب أن عقد العمل انتهى لسبب يوجب استحقاق التعويض.","fields":{"startDate":"تاريخ بدء العمل","endDate":"تاريخ انتهاء العمل","grossMonthlyWage":"الأجر الشهري الإجمالي","annualBenefits":"مجموع المزايا السنوية","annualBenefitsHint":"المجموع السنوي للمزايا المنتظمة كالمواصلات والوجبات والوقود والمكافآت. يُضاف إلى الأجر الشامل؛ اتركه فارغًا إن لم توجد."},"results":{"serviceDuration":"مدة الخدمة (سنوات كاملة / أيام إضافية)","dressedWage":"الأجر الشهري الإجمالي الشامل","appliedBase":"مبلغ الثلاثين يومًا المطبَّق","gross":"التعويض الإجمالي","stampDuty":"رسم الطابع المقتطع","net":"صافي تعويض نهاية الخدمة"},"notes":{"ceilingApplied":"تجاوز الأجر الشامل الحد الأعلى النافذ للتعويض، فأُجري الحساب على أساس الحد الأعلى.","incomeTaxExempt":"تعويض نهاية الخدمة معفى من ضريبة الدخل؛ ولا يشمل الإعفاء ما يُدفع فوق الحد الأعلى."}},"infaz-hesaplama":{"name":"حساب تنفيذ العقوبة","summary":"يبيّن مدة الإفراج المشروط ومدة الإفراج تحت المراقبة والمدة التقديرية في السجن، بحسب تاريخ الجريمة ونوعها وحالة العَوْد.","intro":"يستند الحساب إلى المادتين 105/أ و 107 من قانون تنفيذ العقوبات والتدابير الأمنية رقم 5275، وإلى المادة 108 في حال العَوْد. النتيجة تقديرية فقط: لم تُحتسب مدة الحبس الاحتياطي، ولا ضمّ العقوبات، ولا السجن المؤبد والمؤبد المشدد، ولا الأنظمة الخاصة بالأحداث والمرضى، ولا الجرائم الخاضعة للقانون رقم 3713.","fields":{"sentenceYears":"العقوبة — سنوات","sentenceMonths":"العقوبة — أشهر","sentenceDays":"العقوبة — أيام","offencePeriod":"تاريخ ارتكاب الجريمة","offencePeriodHint":"في الجرائم المرتكبة قبل 30.03.2020 تكون مدة الإفراج تحت المراقبة ثلاث سنوات وفق المادة المؤقتة 6.","offenceType":"نوع الجريمة","offenceTypeHint":"في جرائم القائمة كالقتل العمد والجرائم الجنسية والاتجار بالمخدرات تكون نسبة الإفراج المشروط الثلثين.","repeatOffender":"العَوْد"},"options":{"offencePeriod_before2020":"قبل 30.03.2020","offencePeriod_after2020":"في 30.03.2020 أو بعده","offenceType_general":"جريمة خاضعة للقاعدة العامة","offenceType_aggravated":"جريمة من القائمة (نسبة الثلثين)","repeatOffender_no":"لا يوجد عَوْد","repeatOffender_yes":"يوجد عَوْد"},"results":{"totalSentence":"مجموع العقوبة (سنة / شهر / يوم)","appliedRatio":"نسبة الإفراج المشروط","paroleDuration":"حتى الإفراج المشروط (سنة / شهر / يوم)","supervisedRelease":"الإفراج تحت المراقبة (سنوات)","estimatedTimeServed":"المدة التقديرية في السجن (سنة / شهر / يوم)"},"notes":{"paroleScopeLimits":"لا يشمل الحساب ضمّ العقوبات ولا السجن المؤبد والمؤبد المشدد ولا الأنظمة الخاصة بالأحداث ومن تجاوز الخامسة والستين والمرضى.","paroleNoRemandCredit":"لم تُحتسب مدة الحبس الاحتياطي أو التوقيف، وهي تُقصّر مدة التنفيذ الفعلية.","paroleSeekCounsel":"يستلزم حساب التنفيذ فحص الحكم وتاريخ الجريمة على وجه محدد. هذه النتيجة ليست وثيقة حساب تنفيذ."}},"kira-artis-orani":{"name":"حساب نسبة زيادة الأجرة","summary":"يحسب الحد الأقصى القانوني لزيادة الأجرة عند التجديد، استنادًا إلى متوسط التغير في مؤشر أسعار المستهلك لاثني عشر شهرًا.","intro":"وفق المادة 344 من قانون الالتزامات رقم 6098، لا يجوز أن تتجاوز الزيادة في الأجرة نسبة التغير في متوسطات اثني عشر شهرًا لمؤشر أسعار المستهلك في سنة الإيجار السابقة. وإذا اتُّفق في العقد على نسبة أعلى فهي باطلة في القدر الزائد على المؤشر. أما سقف 25% في إيجارات المساكن فكان تدبيرًا مؤقتًا وانتهى العمل به في 1 تموز/يوليو 2024.","fields":{"currentRent":"الأجرة الشهرية الحالية","cpiRate":"متوسط التغير في مؤشر أسعار المستهلك لاثني عشر شهرًا (%)","cpiRateHint":"خذ النسبة الخاصة بشهر التجديد من السلسلة الرسمية لمعهد الإحصاء التركي. تتغير شهريًا، ولذلك ليست مضمَّنة في الأداة.","agreedRate":"النسبة المتفق عليها في العقد (%)","agreedRateHint":"أدخل النسبة الواردة في عقدك إن وجدت. إن كانت دون المؤشر طُبِّقت، وإن كانت فوقه طُبِّق المؤشر. اتركه فارغًا إن لم توجد."},"results":{"currentRent":"الأجرة الحالية","appliedRate":"النسبة المطبَّقة","increase":"مقدار الزيادة الشهرية","newRent":"الأجرة الشهرية الجديدة","legalMaximum":"الحد الأقصى القانوني للأجرة","annualDifference":"الفرق السنوي"},"notes":{"rentCapBasis":"يعتمد الحساب متوسط اثني عشر شهرًا للمؤشر حدًّا أعلى وفق المادة 344. ويسري الحد ذاته على إيجارات المحال التجارية.","agreedRateCapped":"تجاوزت النسبة المتفق عليها في العقد المؤشرَ، فطُبِّقت نسبة المؤشر بدلًا منها."}},"nafaka-artirim":{"name":"حساب زيادة النفقة","summary":"يحسب مقدار النفقة الحالي والزيادة الشهرية والفرق السنوي استنادًا إلى شرط الزيادة الوارد في الحكم.","intro":"كثيرًا ما تقضي الأحكام بزيادة النفقة سنويًا بنسبة معينة. والزيادة مركَّبة: تُطبَّق زيادة كل سنة على المبلغ الناتج عن زيادة السنة السابقة. وإذا أحال الحكم إلى مؤشر بدل نسبة، فأدخل الرقم الرسمي للفترة المعنية. أما إعادة تقدير النفقة لتغيّر الظروف (المادة 176/4 من القانون المدني) فدعوى مستقلة خارجة عن نطاق هذا الحساب.","fields":{"currentAlimony":"النفقة الشهرية الحالية","annualRate":"نسبة الزيادة السنوية (%)","annualRateHint":"أدخل النسبة الواردة في الحكم. وإن أحال إلى مؤشر أسعار المستهلك أو المنتجين فاستخدم الرقم الرسمي للفترة.","years":"عدد السنوات المطبَّقة"},"results":{"currentAlimony":"النفقة الحالية","appliedRate":"نسبة الزيادة السنوية","years":"عدد السنوات","updatedAlimony":"النفقة الشهرية المحدَّثة","monthlyIncrease":"مقدار الزيادة الشهرية","annualDifference":"الفرق السنوي"},"notes":{"alimonyCompounding":"طُبِّقت الزيادة تركيبيًا؛ فعند تعدد السنوات تُحتسب النسبة كل سنة على مبلغ السنة السابقة."}},"is-kazasi-tazminat":{"name":"حساب تعويض العجز عن حادث عمل","summary":"يحسب الضرر المادي الناشئ عن العجز الدائم عبر الفترات المعلومة والنشطة والخاملة، مع نسبة الخطأ وخصم مؤسسة الضمان الاجتماعي.","intro":"يُحسب تعويض العجز الدائم بتقسيم الضرر إلى فترة معلومة (من الحادث إلى تاريخ الحساب) وفترة نشطة (حتى نهاية الحياة العملية) وفترة خاملة (حتى نهاية العمر المتبقي). وتُعتمد في الفترة النشطة طريقة الإيراد التصاعدي المطبَّقة في اجتهاد محكمة التمييز؛ إذ تتعادل الزيادة السنوية بنسبة 10% مع الخصم بنسبة 10%، فتقابل كل سنة نشطة دخل سنة واحدة. أما العمر المتبقي فيُؤخذ من جدول الحياة TRH-2010 ويُدخل هنا يدويًا.","fields":{"monthlyEarning":"صافي الدخل الشهري","monthlyEarningHint":"صافي الدخل الشهري بتاريخ الحادث. تُحتسب الفترتان المعلومة والنشطة على أساسه.","disabilityRatio":"نسبة العجز الدائم (%)","disabilityRatioHint":"نسبة العجز المحددة في تقرير الضمان الاجتماعي أو الطب الشرعي.","faultRatio":"نسبة خطأ المضرور (%)","faultRatioHint":"النسبة المنسوبة إلى المضرور في تقرير الخبرة. يُخفَّض التعويض بمقدارها.","knownPeriodMonths":"الفترة المعلومة (أشهر)","activePeriodYears":"الفترة النشطة (سنوات)","activePeriodYearsHint":"عدد السنوات المتبقية من تاريخ الحساب حتى نهاية الحياة العملية.","passivePeriodYears":"الفترة الخاملة (سنوات)","passivePeriodYearsHint":"عدد السنوات من نهاية الحياة العملية حتى نهاية العمر المتبقي في جدول TRH-2010.","sgkCapitalValue":"القيمة الرأسمالية لإيراد الضمان الاجتماعي","sgkCapitalValueHint":"تُخصم من التعويض القيمة الرأسمالية لإيراد العجز الدائم المقرَّر من مؤسسة الضمان الاجتماعي. اتركه فارغًا إن لم يوجد."},"results":{"knownLoss":"ضرر الفترة المعلومة","activeLoss":"ضرر الفترة النشطة","passiveLoss":"ضرر الفترة الخاملة","grossLoss":"مجموع الضرر قبل خصم الخطأ","liabilityShare":"نسبة المسؤولية","afterFault":"بعد خصم الخطأ","sgkDeduction":"خصم الضمان الاجتماعي","net":"التعويض المادي التقديري"},"notes":{"trh2010Source":"يُؤخذ العمر المتبقي من جدول الحياة TRH-2010؛ وهو يختلف بحسب السن والجنس، ولذلك ليس مضمَّنًا في الأداة.","progressiveRentMethod":"طُبِّقت في الفترة النشطة طريقة الإيراد التصاعدي (زيادة 10% وخصم 10%).","expertReportRequired":"هذه النتيجة ليست تقريرًا اكتواريًا. ويُحسب الضرر في الدعوى بخبير تعيّنه المحكمة."}},"yillik-izin":{"name":"حساب الإجازة السنوية","summary":"يحسب مدة الإجازة السنوية مدفوعة الأجر المستحقة ورصيدها المتراكم استنادًا إلى تاريخ بدء العمل.","intro":"وفق المادة 53 من قانون العمل رقم 4857، لا تقل الإجازة السنوية مدفوعة الأجر عن أربعة عشر يومًا لمن كانت خدمته من سنة إلى خمس سنوات، وعشرين يومًا لمن تجاوزت خدمته خمس سنوات ودون خمس عشرة سنة، وستة وعشرين يومًا لمن بلغت خدمته خمس عشرة سنة فأكثر. ولا تقل عن عشرين يومًا لمن هم دون الثامنة عشرة أو فوق الخمسين. ولا ينشأ الاستحقاق إلا بعد سنة خدمة كاملة.","fields":{"startDate":"تاريخ بدء العمل","referenceDate":"تاريخ الحساب","usedDays":"أيام الإجازة المستخدمة","ageGroup":"حالة العامل","ageGroupHint":"بالنسبة لمن هم دون الثامنة عشرة أو فوق الخمسين لا تقل الإجازة السنوية عن عشرين يومًا."},"options":{"ageGroup_standard":"بين 18 و 50 سنة","ageGroup_protected":"دون 18 سنة أو فوق 50 سنة"},"results":{"completedYears":"سنوات الخدمة المكتملة","currentEntitlement":"المستحق عن هذه السنة (أيام)","accrued":"مجموع الإجازة المستحقة (أيام)","used":"الإجازة المستخدمة (أيام)","balance":"رصيد الإجازة (أيام)"},"notes":{"leaveIsMinimum":"المدد الواردة في القانون حدود دنيا، ويجوز زيادتها بعقد العمل أو باتفاقية العمل الجماعية.","usedExceedsAccrued":"يبدو أن الإجازة المستخدمة تتجاوز المستحقة. يرجى مراجعة القيم المُدخلة."}},"fazla-mesai":{"name":"حساب أجر العمل الإضافي","summary":"يحسب الأجر الإجمالي للساعات التي تتجاوز خمسًا وأربعين ساعة أسبوعيًا بنسبة 150%، والساعات التي تتجاوز أسبوع عمل تعاقديًا أقصر بنسبة 125%.","intro":"وفق المادة 41 من قانون العمل رقم 4857، يُعدّ العمل الذي يتجاوز خمسًا وأربعين ساعة أسبوعيًا عملًا إضافيًا ويُدفع بنسبة 150% من أجر الساعة. وإذا حدَّد العقد أسبوع عمل أقل من خمس وأربعين ساعة، فإن العمل بين ذلك الحد وخمس وأربعين ساعة يُعدّ عملًا لمدد إضافية ويُدفع بنسبة 125%. ولا يجوز أن يتجاوز العمل الإضافي مئتين وسبعين ساعة في السنة. ويُستخرج أجر الساعة بقسمة الأجر الشهري الإجمالي على 225.","fields":{"grossMonthlyWage":"الأجر الشهري الإجمالي","contractWeeklyHours":"ساعات العمل الأسبوعية في العقد","contractWeeklyHoursHint":"أدخل رقمًا فقط إذا حدَّد العقد أقل من خمس وأربعين ساعة. وإلا فاتركه 45.","actualWeeklyHours":"الساعات المؤداة فعليًا أسبوعيًا","weeks":"عدد الأسابيع"},"results":{"hourlyRate":"أجر الساعة الإجمالي","overtimeHours":"العمل الإضافي (ساعات)","overtimePay":"أجر العمل الإضافي (150%)","extraTimeHours":"العمل لمدد إضافية (ساعات)","extraTimePay":"أجر العمل لمدد إضافية (125%)","total":"مجموع المستحق الإجمالي"},"notes":{"grossFigures":"المبالغ إجمالية؛ لم تُخصم منها الضرائب ولا اشتراكات الضمان الاجتماعي.","overtimeCapExceeded":"يتجاوز العمل الإضافي المحسوب الحد السنوي البالغ مئتين وسبعين ساعة. وتجاوز الحد لا يُسقط الحق في الأجر."}},"issizlik-maasi":{"name":"حساب بدل البطالة","summary":"يحسب بدل البطالة الشهري استنادًا إلى دخل الأشهر الأربعة الأخيرة وأيام الاشتراك، مع الحد الأعلى ومدة الصرف.","intro":"وفق المادة 50 من قانون تأمين البطالة رقم 4447، يبلغ البدل اليومي 40% من متوسط الدخل اليومي الإجمالي الخاضع للاشتراك عن الأشهر الأربعة الأخيرة. ولا يجوز أن يتجاوز 80% من الحد الأدنى للأجر الإجمالي. ومدة الصرف 180 أو 240 أو 300 يوم بحسب أيام الاشتراك في السنوات الثلاث الأخيرة. ولا يُقتطع من البدل سوى رسم الطابع.","fields":{"averageGrossMonthly":"متوسط الدخل الشهري الإجمالي للأشهر الأربعة الأخيرة","averageGrossMonthlyHint":"المتوسط الشهري للدخل الإجمالي الخاضع للاشتراك خلال الأشهر الأربعة الأخيرة.","premiumDays":"أيام الاشتراك خلال السنوات الثلاث الأخيرة","premiumDaysHint":"يشترط للاستحقاق 600 يوم اشتراك على الأقل خلال السنوات الثلاث الأخيرة و 120 يومًا من الخدمة المتصلة."},"results":{"grossMonthly":"البدل الشهري الإجمالي","stampDuty":"رسم الطابع المقتطع","netMonthly":"صافي البدل الشهري","benefitDays":"مدة الصرف (أيام)","benefitMonths":"مدة الصرف (أشهر)","totalBenefit":"مجموع البدل الصافي"},"notes":{"benefitConditions":"يتوقف الاستحقاق على انتهاء عقد العمل لأحد الأسباب الواردة في القانون وعلى تقديم الطلب في الميعاد.","benefitCeilingApplied":"تجاوز البدل المحسوب 80% من الحد الأدنى للأجر الإجمالي، فطُبِّق الحد الأعلى."}},"miras-payi":{"name":"حساب أنصبة الميراث","summary":"يحسب الأنصبة القانونية والأنصبة المحفوظة للزوج الباقي والفروع والوالدين والإخوة وفق نظام الطبقات.","intro":"وفق المواد 495 إلى 501 من القانون المدني التركي تُقسَّم التركة بنظام الطبقات. الطبقة الأولى الفروع، والثانية الوالدان وفروعهما، والثالثة الأجداد. ووجود وارث في طبقة أقرب يحجب كل طبقة أبعد. ويرث الزوج الباقي مع أي طبقة تُستدعى بنصيب يزداد كلما بعُدت الطبقة. والأنصبة المحفوظة منظَّمة في المادة 506؛ وقد أُلغي النصيب المحفوظ للإخوة سنة 2007.","fields":{"estateValue":"صافي قيمة التركة","estateValueHint":"صافي التركة بعد تصفية نظام الأموال بين الزوجين وخصم الديون.","spouse":"الزوج الباقي على قيد الحياة","childCount":"عدد الأولاد (الفروع)","parentsAlive":"عدد الوالدين على قيد الحياة","parentsAliveHint":"يُعتدّ به فقط عند انتفاء الفروع. ونصيب الوالد المتوفى ينتقل إلى فروعه، أي إلى الإخوة.","siblingCount":"عدد الإخوة"},"options":{"spouse_yes":"موجود","spouse_no":"غير موجود","parentsAlive_0":"كلاهما متوفى","parentsAlive_1":"أحدهما على قيد الحياة","parentsAlive_2":"كلاهما على قيد الحياة"},"results":{"spouseShare":"نصيب الزوج الباقي","perChildShare":"نصيب كل ولد","childrenTotal":"مجموع نصيب الأولاد","perParentShare":"نصيب كل من الوالدين","parentsTotal":"مجموع نصيب الوالدين","perSiblingShare":"نصيب كل أخ","siblingsTotal":"مجموع نصيب الإخوة","reservedTotal":"مجموع النصيب المحفوظ","disposable":"القدر القابل للتصرف"},"notes":{"inheritanceMaritalRegime":"يجري الحساب على صافي التركة بعد تصفية نظام الأموال بين الزوجين. ويُفرز حق المشاركة للزوج الباقي قبل قسمة التركة، وهو في الغالب أكبر من نصيبه في الميراث.","inheritanceScopeLimits":"لا يشمل الحساب الحرمان من الإرث ولا رد التركة ولا علاقة التبني ولا التبرعات الخاضعة للإنقاص ولا حلول فروع الأخ محلّه.","inheritanceSiblingsNoReserve":"أُلغي النصيب المحفوظ للإخوة بالقانون رقم 5650 سنة 2007.","inheritanceSpouseAloneAssumption":"لانتفاء الفروع والوالدين والإخوة، افتُرض كذلك انتفاء الوارث في الطبقة الثالثة، فآلت التركة بكاملها إلى الزوج الباقي."}}},"contactPage":{"meta":{"title":"اتصل بنا","description":"بيانات التواصل ونموذج طلب موعد أدناه."},"label":"اتصل بنا","title":"طلب موعد","lead":"يمكنكم استخدام النموذج أدناه لطلب موعد بخصوص ملفكم، أو التواصل مع المكتب مباشرة. تُستخدم المعلومات المُرسَلة عبر النموذج فقط لتقييم طلبكم.","formLabel":"نموذج الطلب","requiredNote":"الحقول المؤشَّر عليها بعلامة نجمية إلزامية.","directLabel":"التواصل المباشر","officeLabel":"عنوان المكتب","mapLabel":"الموقع","mapTitle":"موقع المكتب — خرائط جوجل","serviceAreasLabel":"المناطق التي نخدمها","serviceAreasBody":"نقدّم خدماتنا في قانون العمل وقانون التنفيذ وقانون الطلاق والأسرة وقانون الإرث وقانون الإيجار، وذلك بشكل أساسي في {districts} والمناطق المجاورة لها.","reviewsLabel":"تقييمات جوجل","reviewRating":"{rating} من 5 نجوم","form":{"name":"الاسم الكامل","email":"البريد الإلكتروني","phone":"الهاتف (اختياري)","subject":"الموضوع","message":"رسالتكم","consent":"لقد قرأت <link>نص الإعلام بشأن حماية البيانات الشخصية (KVKK)</link> وأوافق على معالجة بياناتي الشخصية على هذا الأساس.","submit":"إرسال","submitting":"جارٍ الإرسال…","success":"تم استلام رسالتكم. سيتم التواصل معكم في أقرب وقت ممكن.","errorGeneric":"تعذّر إرسال رسالتكم. يرجى المحاولة لاحقاً.","errorValidation":"يرجى تعبئة النموذج بالكامل وبشكل صحيح.","errorRateLimit":"عدد محاولات كبير خلال وقت قصير. يرجى المحاولة لاحقاً.","errorConsent":"يجب الموافقة على نص الإعلام بشأن حماية البيانات الشخصية (KVKK) للمتابعة.","errorTooShort":"هذا الحقل قصير جدًا.","errorTooLong":"هذا الحقل طويل جدًا.","errorRequired":"هذا الحقل إلزامي.","errorInvalidEmail":"أدخل بريدًا إلكترونيًا صالحًا."},"hoursLabel":"ساعات العمل","businessProfileLabel":"الملف التجاري على Google"},"legalPages":{"kvkk":{"nav":"نص الإعلام بشأن حماية البيانات الشخصية"},"gizlilik":{"nav":"سياسة الخصوصية"}},"article":{"readingTime":"قراءة {minutes} دقيقة","publishedOn":"تاريخ النشر: {date}","updatedOn":"آخر تحديث: {date}","byAuthor":"الكاتب: {name}","categoryLabel":"التصنيف"},"footer":{"navTitle":"الموقع","officeTitle":"المكتب","contactTitle":"الاتصال","legalTitle":"تنبيه قانوني","barRegistration":"{bar} — رقم القيد: {registryNo}","kvkk":"نص الإعلام بشأن حماية البيانات الشخصية","privacy":"سياسة الخصوصية","rights":"© {year} بوراك أوغور أوزتورك. جميع الحقوق محفوظة.","phone":"الهاتف","email":"البريد الإلكتروني","whatsapp":"واتساب","serviceAreasNote":"نقدّم خدماتنا القانونية في سيليفري وتشاتالجا وبيوك تشكمجة وبيليك دوزو وإسنيورت وأفجلار وكوتشوك تشكمجة والمناطق المجاورة لها، في مجالات قانون العمل وقانون التنفيذ وقانون الطلاق والأسرة وقانون الإرث وقانون الإيجار."},"disclaimer":{"title":"تنبيه قانوني","body":"المحتوى الوارد في هذا الموقع مقدَّم على سبيل الإعلام العام؛ وهو لا يشكّل استشارة قانونية ولا ينشئ علاقة بين المحامي وموكّله. وقبل اتخاذ أي قرار بشأن نزاع أو معاملة بعينها، يتعيّن الحصول على رأي قانوني يخص وضعكم الخاص. ولمّا كانت التشريعات والاجتهاد القضائي عرضة للتغيّر، فإن حداثة المحتوى غير مضمونة."},"cookieConsent":{"label":"تفضيلات ملفات تعريف الارتباط","body":"هل تسمحون لنا باستخدام ملف تعريف ارتباط لتسجيل إحصائيات زيارة أساسية؟ في حال الرفض، لن يتم تسجيل أي بيانات زيارة. للتفاصيل، يمكنكم مراجعة <link>نص الإعلام الخاص بحماية البيانات الشخصية (KVKK)</link>.","accept":"قبول","decline":"رفض","settings":"تفضيلات ملفات الارتباط","bodyGa4":"بموافقتكم نقيس الزيارات وتفاعلات التواصل على خادمنا وباستخدام Google Analytics 4. قد تُنقل إلى Google بيانات الصفحة واللغة والتفاعل وملفات التحليل. لا يعمل التحليل الاختياري عند الرفض. <link>التفاصيل</link>."},"notFound":{"label":"خطأ 404","title":"الصفحة المطلوبة غير موجودة","body":"قد يكون الرابط قد نُقل أو أُزيل. ويمكنكم المتابعة من الصفحة الرئيسية.","home":"العودة إلى الصفحة الرئيسية"},"error":{"label":"خطأ","title":"حدث خطأ غير متوقع","body":"تعذّر إتمام العملية. يمكنكم إعادة تحميل الصفحة.","retry":"إعادة المحاولة"},"admin":{"login":{"meta":{"title":"تسجيل دخول الإدارة"},"eyebrow":"لوحة الإدارة","title":"تسجيل الدخول","email":"البريد الإلكتروني","password":"كلمة المرور","submit":"تسجيل الدخول","submitting":"جارٍ تسجيل الدخ