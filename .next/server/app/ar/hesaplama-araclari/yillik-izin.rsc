29:["$","$L2b",null,{"ref":"$undefined","href":"/ar/hesaplama-araclari/infaz-hesaplama","locale":"$undefined","localeCookie":"$1a:props:localeCookie","className":"group flex h-full flex-col border-t border-rule pt-6","children":[["$","h3",null,{"className":"font-display text-2xl font-normal text-ink transition-colors duration-base ease-out-editorial group-hover:text-gold-800","children":"حساب تنفيذ العقوبة"}],["$","p",null,{"className":"mt-3 flex-1 text-md text-ink-muted","children":"يبيّن مدة الإفراج المشروط ومدة الإفراج تحت المراقبة والمدة التقديرية في السجن، بحسب تاريخ الجريمة ونوعها وحالة العَوْد."}]]}]
2a:["$","$L2b",null,{"ref":"$undefined","href":"/ar/hesaplama-araclari/kira-artis-orani","locale":"$undefined","localeCookie":"$1a:props:localeCookie","className":"group flex h-full flex-col border-t border-rule pt-6","children":[["$","h3",null,{"className":"font-display text-2xl font-normal text-ink transition-colors duration-base ease-out-editorial group-hover:text-gold-800","children":"حساب نسبة زيادة الأجرة"}],["$","p",null,{"className":"mt-3 flex-1 text-md text-ink-muted","children":"يحسب الحد الأقصى القانوني لزيادة الأجرة عند التجديد، استنادًا إلى متوسط التغير في مؤشر أسعار المستهلك لاثني عشر شهرًا."}]]}]
