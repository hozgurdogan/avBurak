12:["$","$L29",null,{"formats":{"dateTime":{"long":{"day":"numeric","month":"long","year":"numeric","numberingSystem":"latn"},"short":{"day":"2-digit","month":"2-digit","year":"numeric","numberingSystem":"latn"}}},"locale":"tr","messages":{"site":{"attorney":"Av. Burak Uğur Öztürk","attorneyShort":"Burak Uğur Öztürk","role":"Avukat","monogramLabel":"Burak Uğur Öztürk — anasayfa"},"nav":{"primary":"Ana menü","home":"Anasayfa","practiceAreas":"Çalışma Alanları","profile":"Profil","articles":"Makaleler","contact":"İletişim","openMenu":"Menüyü aç","closeMenu":"Menüyü kapat","skipToContent":"İçeriğe geç","tools":"Araçlar","faq":"SSS","regions":"Bölgeler","getInTouch":"İletişime Geç","breadcrumb":"Gezinme yolu"},"locale":{"label":"Dil","change":"Dili değiştir","current":"Seçili dil"},"home":{"meta":{"title":"Av. Burak Uğur Öztürk","homeTitle":"Av. Burak Uğur Öztürk | Hukuki Danışmanlık ve Dava Takibi","description":"Esenyurt merkezli; iş, icra, boşanma ve aile, kira, miras ve şirketler hukukunda Türkçe, İngilizce ve Arapça hukuki danışmanlık ve dava takibi."},"hero":{"label":"Esenyurt · Büyükçekmece · Beylikdüzü · Mimaroba","title":"Av. Burak Uğur Öztürk","registrationLabel":"Kayıt","languagesLabel":"Çalışma Dilleri","languages":"Türkçe · İngilizce · Arapça","focusLabel":"Çalışma Alanları","focus":"Esenyurt’ta iş, icra, boşanma ve aile hukuku","regionsLabel":"Hizmet Bölgeleri","lead":"Esenyurt merkezli hukuk büromuz; iş hukuku, icra ve iflas hukuku, aile ve boşanma hukuku, kira hukuku, miras hukuku, tüketici hukuku, kamulaştırma, tazminat hukuku, idare hukuku ve şirketler hukuku alanlarında faaliyet göstermektedir.","contact":"İletişim","appointment":"Randevu talebi","leadSecondary":"Müvekkillerimize Türkçe, İngilizce ve Arapça dillerinde; hukuki danışmanlık, uyuşmazlıkların çözümü ve dava süreçlerinin takibi konularında, hak ve menfaatlerin korunmasını esas alan, titiz, şeffaf ve çözüm odaklı bir hukuki hizmet sunmaktayız."},"practice":{"label":"Çalışma Alanları","title":"Çalışılan hukuk alanları","lead":"Aşağıdaki başlıklar, büronun düzenli olarak çalıştığı alanları göstermektedir.","all":"Tüm çalışma alanları"},"profile":{"label":"Profil","title":"Büro hakkında","body":"Büro, sınırlı sayıda dosya üzerinde doğrudan çalışma esasına dayanır. Her iş, ilgili mevzuatın ve güncel yargı uygulamasının incelenmesiyle başlar; müvekkile aktarılan değerlendirme, seçeneklerin ve bunlara bağlı risklerin açıkça ortaya konulmasını içerir.","link":"Profili görüntüle"},"articles":{"label":"Makaleler","title":"Güncel yazılar","lead":"Mevzuat ve uygulamaya ilişkin genel bilgilendirme amaçlı yazılar.","all":"Tüm makaleler"},"contact":{"label":"İletişim","title":"Görüşme talebi","body":"Dosyanıza ilişkin bir görüşme talep etmek için iletişim sayfasındaki formu kullanabilir veya doğrudan büroya ulaşabilirsiniz.","link":"İletişim sayfası"}},"practiceAreas":{"is-hukuku":{"name":"İş Hukuku","summary":"İşe iade ve fesih uyuşmazlıkları, kıdem ve ihbar tazminatı, fazla mesai ve izin alacakları, iş kazası ve meslek hastalığından doğan tazminat talepleri.","body":["İş sözleşmesinin feshine ilişkin uyuşmazlıklarda işçi ve işveren tarafında dava ve arabuluculuk süreçlerinin yürütülmesi, kıdem ve ihbar tazminatı ile fazla mesai, yıllık izin ve diğer işçilik alacaklarının hesaplanması ve takibi bu alanın kapsamındadır.","İş kazası ve meslek hastalığından doğan maddi ve manevi tazminat talepleri, işe iade davaları ve toplu işçi çıkarma süreçlerinde de destek sağlanmaktadır.","İşçi tarafında iş sözleşmesinin haksız feshi iddiasıyla işe iade talebi için, fesih bildiriminin tebliğinden itibaren kanunda öngörülen süre içinde arabuluculuğa başvurulması zorunludur; arabuluculukta anlaşma sağlanamaması hâlinde dava süreci işletilir. İşveren tarafında ise savunma alma, tutanak düzenleme ve fesih bildirimi gibi usul şartlarına uyulmasına özen gösterilmesi gerekir.","Fazla mesai, yıllık izin ve diğer işçilik alacaklarının ispatında yazılı belgeler, tanık beyanları ve işyeri kayıtları belirleyicidir; alacak miktarının önceden değerlendirilmesi için sitedeki kıdem tazminatı, yıllık izin, fazla mesai ve işsizlik maaşı hesaplama araçlarından yararlanılabilir."]},"icra-hukuku":{"name":"İcra Hukuku","summary":"İlamlı ve ilamsız icra takipleri, itiraz ve itirazın iptali, haciz işlemleri, iflas ve konkordato süreçleri.","body":["Alacaklı ve borçlu taraflar bakımından ilamlı ve ilamsız icra takiplerinin başlatılması, ödeme emrine itiraz, itirazın kaldırılması ve itirazın iptali davaları bu alanın kapsamındadır.","Haciz ve satış işlemlerinin takibi, menfi tespit ve istirdat davaları ile iflas ve konkordato süreçlerinde de çalışılmaktadır.","Borçlu tarafında ödeme emrinin tebliğinden itibaren yasal süre içinde icra dairesine itiraz edilmesi takibi durdurur; alacaklı tarafında ise itirazın kaldırılması (icra mahkemesi) veya itirazın iptali (genel mahkeme) yollarından biri izlenerek takibin devamı sağlanabilir.","Haciz işlemleri kural olarak borçlunun haczedilebilir taşınır ve taşınmaz malları ile alacaklarına uygulanır; kanunda sayılan belirli mal ve haklar haciz dışında tutulmuştur. Sürecin başında alacağın dayanağı olan belgelerin (sözleşme, fatura, çek/senet, ilam vb.) eksiksiz hazırlanması önerilir."]},"bosanma-aile-hukuku":{"name":"Boşanma ve Aile Hukuku","summary":"Anlaşmalı ve çekişmeli boşanma davaları, nafaka ve tazminat talepleri, mal rejiminin tasfiyesi, velayet ve kişisel ilişki düzenlemeleri.","body":["Anlaşmalı ve çekişmeli boşanma davalarının yürütülmesi, boşanma protokolünün hazırlanması, nafaka ve maddi-manevi tazminat taleplerinin ileri sürülmesi bu alanın kapsamındadır.","Mal rejiminin tasfiyesinden doğan katılma alacağı davaları, velayet ve kişisel ilişki tesisi ile nafaka artırım davalarında da destek sağlanmaktadır.","Anlaşmalı boşanmada taraflar arasında velayet, nafaka, tazminat ve mal paylaşımı konularında düzenlenen protokolün mahkemece uygun bulunması aranır; çekişmeli boşanmada ise iddiaların yazılı belge, tanık beyanı ve varsa diğer delillerle desteklenmesi gerekir.","Velayet ve kişisel ilişki düzenlemelerinde çocuğun üstün yararı esas alınır; mal rejiminin tasfiyesinde katılma alacağı hesaplaması evlilik süresince edinilen mallara göre yapılır. Boşanma sürecine özgü vekâletname düzenlenmesi ve süreç akışının önceden planlanması önerilir."]},"miras-hukuku":{"name":"Miras Hukuku","summary":"Mirasçılık belgesi, terekenin tespiti ve taksimi, miras payının tahsili, tenkis ve mirastan çıkarma davaları.","body":["Mirasçılık belgesinin alınması, terekenin tespiti ve taksimi, miras payının diğer mirasçılardan tahsiline ilişkin süreçlerin yürütülmesi bu alanın kapsamındadır.","Tenkis davaları, mirastan çıkarma ve miras sözleşmelerine ilişkin uyuşmazlıklarda da çalışılmaktadır.","Mirasın reddi, mirasçı olduğunu öğrenme tarihinden itibaren üç aylık süre içinde sulh hukuk mahkemesine yapılan başvuruyla mümkündür; bu süre kaçırıldığında miras kural olarak kanuni mirasçılar tarafından kayıtsız şartsız kazanılmış sayılır.","Muris muvazaası (mirastan mal kaçırma) iddiası, tenkis davaları ve mirasçılar arasında ortaklığın giderilmesi (izale-i şüyu) talepleri de bu kapsamda değerlendirilir; görevli mahkeme ve süreler dosyanın somut niteliğine göre belirlenir."]},"kira-hukuku":{"name":"Kira Hukuku","summary":"Kira bedeli tespiti ve artış davaları, tahliye davaları, tahliye taahhüdüne dayalı icra takipleri, kira sözleşmelerinin düzenlenmesi.","body":["Kira bedelinin tespiti ve uyarlanması, kira artış oranına ilişkin uyuşmazlıklar ile kira sözleşmelerinin hazırlanması ve gözden geçirilmesi bu alanın kapsamındadır.","Tahliye taahhüdüne dayalı icra takipleri, temerrüt nedeniyle tahliye ile ihtiyaç ve yeniden inşa nedeniyle açılan tahliye davalarında da destek sağlanmaktadır.","Kiracı temerrüde düşürülerek veya tahliye taahhüdüne dayanılarak icra yoluyla tahliye talep edilebileceği gibi; kiraya verenin veya yakınlarının konut/işyeri ihtiyacı ya da yeniden inşa/imar gereği gibi kanunda sayılan sebeplerle dava yoluyla da tahliye istenebilir. Her sebep için ayrı usul ve süre şartları uygulanır.","Kira bedelinin uyarlanması ve kira tespiti davalarında, önceki dönem TÜFE ortalaması ve sözleşme hükümleri birlikte değerlendirilir; kira artış oranının hesaplanmasında sitedeki kira artış oranı hesaplama aracından yararlanılabilir."]},"tazminat-hukuku":{"name":"Tazminat Hukuku","summary":"Haksız fiil ve sözleşmeye aykırılıktan doğan maddi ve manevi tazminat talepleri, trafik kazası ve cismani zarar davaları.","body":["Bir kişinin hukuka aykırı bir fiil veya sözleşmeye aykırı davranışla zarara uğraması hâlinde, zarar gören taraf 6098 sayılı Türk Borçlar Kanunu'nun haksız fiil ve sözleşmeye aykırılık hükümleri çerçevesinde maddi ve manevi tazminat talep edebilir.","Trafik kazaları, cismani zarar, ölüm nedeniyle destekten yoksun kalma, haksız rekabet ve kişilik haklarına saldırı gibi hâllerde tazminat miktarının belirlenmesi, zarar ile kusur arasındaki bağın ve zararın kapsamının somut delillerle ortaya konmasını gerektirir.","Tazminat davalarında zarar görenin kusuru, müterafık kusur, zararın azaltılması yükümlülüğü ve sigorta kapsamı gibi hususlar tazminat miktarını doğrudan etkiler; bu nedenle talep öncesinde zarar kalemlerinin ayrıntılı biçimde belgelendirilmesi önemlidir.","Tazminat taleplerinde zamanaşımı süreleri olay türüne göre değişmekte olup, hak kaybına uğramamak için süresi içinde başvuru yapılması gerekir; iş kazası kaynaklı tazminat talepleri için sitedeki iş kazası tazminat hesaplama aracından yararlanılabilir."]},"kentsel-donusum-hukuku":{"name":"Kentsel Dönüşüm Hukuku","summary":"6306 sayılı Kanun kapsamında riskli yapı tespiti, kentsel dönüşüm süreçleri ve paydaşlar arası anlaşmazlıkların çözümü.","body":["6306 sayılı Afet Riski Altındaki Alanların Dönüştürülmesi Hakkında Kanun çerçevesinde bir yapının riskli yapı olarak tespit edilmesi, tahliye ve yıkım süreçleri ile kat karşılığı veya hasılat paylaşımı sözleşmelerinin hazırlanması kentsel dönüşüm hukukunun kapsamına girer.","Riskli yapı tespitine itiraz, maliklerin kanunda öngörülen çoğunlukla anlaşma sağlayamaması hâlinde uygulanacak usul ve kira yardımı ile diğer devlet desteklerinden yararlanma şartları sık karşılaşılan uyuşmazlık konuları arasındadır.","Müteahhit ile malikler arasında imzalanan kat karşılığı inşaat sözleşmelerinde payların, teslim tarihinin, cezai şartın ve ek maliyetlerin açık biçimde düzenlenmesi, sürecin ilerleyen aşamalarında ortaya çıkabilecek anlaşmazlıkların önüne geçilmesi açısından önemlidir.","Kentsel dönüşüm sürecinde malik, kiracı veya sınırlı ayni hak sahibi sıfatıyla taraf olan kişilere, tahliye, tapu iptali-tescili ve tazminat talepleri konusunda da destek sağlanmaktadır."]},"tuketici-hukuku":{"name":"Tüketici Hukuku","summary":"Ayıplı mal ve hizmetten doğan talepler, tüketici hakem heyeti ve tüketici mahkemesi süreçleri, abonelik ve mesafeli satış sözleşmeleri.","body":["6502 sayılı Tüketicinin Korunması Hakkında Kanun kapsamında ayıplı mal veya hizmet, mesafeli satış sözleşmelerinden cayma hakkı, abonelik sözleşmelerinin feshi ve haksız şartlar nedeniyle tüketicinin uğradığı zararların tazmini bu alanın kapsamındadır.","Parasal sınırın altında kalan uyuşmazlıklarda başvuru tüketici hakem heyetine yapılır; sınırı aşan veya hakem heyeti kararına itiraz edilen uyuşmazlıklarda görevli mahkeme tüketici mahkemesidir (tüketici mahkemesi bulunmayan yerlerde asliye hukuk mahkemesi bu sıfatla görev yapar).","Ayıplı mal satışında tüketicinin ücretsiz onarım, malın ayıpsız misliyle değişimi, bedel indirimi veya sözleşmeden dönme seçimlik haklarından hangisini kullanacağını belirlemesi; mesafeli satışlarda cayma hakkının süresi ve kullanım şekli uyuşmazlıkların en sık görüldüğü noktalardır.","Başvuru öncesinde sözleşme, fatura, garanti belgesi ve yazışmaların saklanması, hem hakem heyeti hem de mahkeme sürecinde talebin ispatını önemli ölçüde kolaylaştırır."]},"sirketler-hukuku":{"name":"Şirketler Hukuku","summary":"Şirket kuruluşu ve tür değiştirme, esas sözleşme düzenlemeleri, sermaye artırımı, pay devri, ortaklar arası sözleşmeler ve genel kurul süreçleri.","body":["Kuruluş aşamasından itibaren şirketler hukukuna ilişkin işlemlerde çalışılmaktadır; şirket türü seçimi, esas sözleşmenin hazırlanması, sermaye yapısının belirlenmesi ve tescil süreçleri bu kapsamdadır.","Kuruluş sonrasında ise sermaye artırımı ve azaltılması, pay devri, ortaklar arası sözleşmelerin hazırlanması, genel kurul ve yönetim kurulu süreçlerinin yürütülmesi ile tür değiştirme ve birleşme işlemlerinde destek verilmektedir."]},"tahkim-ve-uyusmazlik-cozumu":{"name":"Tahkim ve Uyuşmazlık Çözümü","summary":"Tahkim şartlarının kurulması, kurumsal ve ad hoc tahkim yargılamaları, yabancı hakem kararlarının tenfizi, arabuluculuk ve dava süreçleri.","body":["Sözleşmelere tahkim şartının eklenmesi, tahkim yeri ve dilinin belirlenmesi ile kurumsal veya ad hoc tahkim yargılamalarının takibi bu alanın kapsamındadır.","Yabancı hakem kararlarının Türkiye'de tenfizi, arabuluculuk süreçleri ve dava yoluyla uyuşmazlık çözümü konularında da çalışılmaktadır."]},"kisisel-verilerin-korunmasi":{"name":"Kişisel Verilerin Korunması","summary":"KVKK uyum çalışmaları, aydınlatma ve açık rıza metinleri, veri envanteri, yurt dışına aktarım ve veri ihlali bildirimleri.","body":["6698 sayılı Kanun kapsamında veri sorumlusu yükümlülüklerinin tespiti, veri envanterinin çıkarılması ile aydınlatma ve açık rıza metinlerinin hazırlanması bu alanda yürütülen çalışmalardır.","Yurt dışına veri aktarımı süreçlerinin mevzuata uygun şekilde yapılandırılması ve veri ihlali bildirim süreçlerinde destek sağlanmaktadır."]}},"practiceAreasPage":{"meta":{"title":"Çalışma Alanları","description":"İş hukuku, icra hukuku, boşanma ve aile hukuku, miras hukuku, kira hukuku, şirketler hukuku, tahkim ve uyuşmazlık çözümü ile kişisel verilerin korunması alanlarında çalışılmaktadır."},"label":"Çalışma Alanları","title":"Çalışılan hukuk alanları","lead":"Aşağıdaki başlıklar, büronun düzenli olarak çalıştığı alanları göstermektedir.","cta":"Detayları görüntüle"},"practiceAreaDetail":{"back":"Tüm çalışma alanları","relatedLabel":"İlgili Makaleler","relatedEmpty":"Bu alanda henüz yayımlanmış makale bulunmamaktadır.","relatedToolsLabel":"İlgili Hesaplama Araçları","contactCta":"İletişime geçin"},"serviceRegions":{"esenyurt":{"name":"Esenyurt","pageTitle":"Esenyurt Avukat | Av. Burak Uğur Öztürk","h1":"Esenyurt Avukat Av. Burak Uğur Öztürk","summary":"Esenyurt'ta iş, icra, boşanma, kira ve miras uyuşmazlıklarında hukuki danışmanlık ve dava takibi. Av. Burak Uğur Öztürk.","body":["Esenyurt'ta iş, icra, boşanma ve aile, kira, miras ve şirketler hukuku alanlarında hukuki danışmanlık ve dava takibi hizmeti sunulmaktadır. Her dosya; mevcut belgeler, tarafların talepleri, uygulanacak kurallar ve olası hukuki yollar birlikte değerlendirilerek ele alınır. Görüşmeler Türkçe, İngilizce ve Arapça yapılabilir."],"relatedAreas":["is-hukuku","icra-hukuku","bosanma-aile-hukuku","miras-hukuku","kira-hukuku","tazminat-hukuku","kentsel-donusum-hukuku","tuketici-hukuku","sirketler-hukuku","tahkim-ve-uyusmazlik-cozumu","kisisel-verilerin-korunmasi"],"cardSummary":"İşçilik alacakları, icra ve aile uyuşmazlıkları.","sections":[{"id":"is-icra-aile","title":"İş, icra ve aile hukuku uyuşmazlıkları","paragraphs":["İşçilik alacağı başvurusunda iş sözleşmesi, bordrolar, ödeme kayıtları ve fesih belgeleri birlikte incelenir. Sigortasız çalışma iddiasında çalışma dönemini ve ilişkiyi gösteren kayıtlar değerlendirmeye yardımcı olur.","Ödeme emri, boşanma veya nafaka başvurusunda tebligatın tamamı, tebliğ tarihi, mevcut dosya numarası ve ilgili önceki kararlar hazırlanmalıdır. Başvuru ve itiraz süreleri dosyanın türüne göre ayrı kontrol edilir."]},{"id":"kira-miras-kurumsal","title":"Kira, miras ve kurumsal dosyalar","paragraphs":["Kira dosyalarında sözleşme ve ödeme kayıtları; miras uyuşmazlıklarında tapu ve mirasçılık belgesi; şirket dosyalarında sözleşmeler, sicil kayıtları ve yetki belgeleri uyuşmazlığın çerçevesini belirlemeye yardımcı olur."]},{"id":"belge-hazirligi","title":"Görüşme öncesinde hazırlanacak belgeler","paragraphs":["Tebligat ve tebliğ tarihi, sözleşmeler, ödeme kayıtları, mevcut dosya numarası ve ilgili yazışmaları tarih sırasıyla hazırlayın. İlk değerlendirmede eksik belge ve dosyaya özgü süreler ayrıca belirlenir."]}],"faq":[{"question":"Esenyurt hangi adli yargı çevresindedir?","answer":"Esenyurt, Büyükçekmece Adliyesinin adli yargı çevresindedir. Somut davada görev ve yetki ayrıca incelenir; resmî kaynak ve ayrıntı yukarıdaki adliye bölümündedir."},{"question":"Ödeme emri geldiğinde hangi belgeler gerekir?","answer":"Ödeme emrinin tamamı, tebliğ belgesi veya tebliğ tarihi, varsa dayanak sözleşme ve ödeme kayıtları hazırlanmalıdır. Süre, takip türüne göre dosya üzerinden değerlendirilir."},{"question":"İş uyuşmazlığında ilk değerlendirme nasıl yapılır?","answer":"Çalışma dönemi, sigorta kayıtları, sözleşme, ücret ve fesih belgeleri birlikte incelenir. Sigortasız çalışma hakkında hizmet tespiti rehberini inceleyebilirsiniz.","articleRef":"sigortasiz-calistim-hizmet-tespiti-davasi"}],"guideLink":"Esenyurt Avukat sayfasını inceleyin","jurisdictionTitle":"Esenyurt hangi adli yargı çevresindedir?"},"buyukcekmece":{"name":"Büyükçekmece","pageTitle":"Büyükçekmece Avukat | Av. Burak Uğur Öztürk","h1":"Büyükçekmece Avukat Av. Burak Uğur Öztürk","summary":"Büyükçekmece'de kira, miras, iş ve aile hukuku dosyalarında hukuki danışmanlık, belge değerlendirmesi ve dava takibi.","body":["Büyükçekmece ile ilgili kira, miras, iş ve aile hukuku başvurularında sözleşmeler, tapu kayıtları, ödeme belgeleri ve mevcut dosya evrakı birlikte değerlendirilir. Uyuşmazlığın niteliğine göre danışmanlık ve dava takibi süreci belirlenir."],"relatedAreas":["is-hukuku","icra-hukuku","bosanma-aile-hukuku","kira-hukuku","miras-hukuku"],"cardSummary":"Kira, miras ve aile hukuku süreçleri.","sections":[{"id":"kira-miras","title":"Kira ve miras dosyalarında ilk değerlendirme","paragraphs":["Kira bedeli uyuşmazlığında sözleşme, ödeme geçmişi ve bildirimler; miras dosyasında mirasçılık belgesi, tapu kayıtları ve varsa devir belgeleri hazırlanır. Birden fazla taşınmaz varsa evrakın taşınmaz bazında ayrılması yararlıdır."]},{"id":"aile-is","title":"Aile ve iş hukuku süreçleri","paragraphs":["Aile dosyalarında önceki kararlar, protokoller ve malvarlığına ilişkin kayıtlar; iş dosyalarında çalışma ve ücret belgeleri incelenir. Süreler ve başvuru yolu dosyaya göre ayrıca kontrol edilir."]}],"faq":[{"question":"Kira bedeli uyuşmazlığında hangi kayıtlar önemlidir?","answer":"Kira sözleşmesi, ödeme geçmişi, varsa yenileme anlaşması ve ihtarnameler birlikte değerlendirilir.","articleRef":"tr-makaleler-kira-bedelinin-tespiti-davasi"},{"question":"Mimaroba için ayrı bir konu rehberi var mı?","answer":"Mimaroba bölge rehberinde site yönetimi, kira ve miras dosyalarının belge hazırlığı ayrıca açıklanır. İlgili bölge bağlantısı bu sayfada yer alır."}],"guideLink":"Büyükçekmece Avukat sayfasını inceleyin","jurisdictionTitle":"Büyükçekmece hangi adli yargı çevresindedir?"},"beylikduzu":{"name":"Beylikdüzü","pageTitle":"Beylikdüzü Avukat | Av. Burak Uğur Öztürk","h1":"Beylikdüzü Avukat Av. Burak Uğur Öztürk","summary":"Beylikdüzü'nde kira, iş, icra ve aile hukuku uyuşmazlıklarında hukuki danışmanlık ve dava takibi. Av. Burak Uğur Öztürk.","body":["Beylikdüzü'nde kira, iş, icra, boşanma ve aile hukuku uyuşmazlıklarında hukuki danışmanlık ve dava takibi hizmeti sunulmaktadır. Başvurular; sözleşmeler, tebligatlar, ödeme belgeleri ve dosyaya özgü diğer deliller üzerinden değerlendirilir."],"relatedAreas":["kira-hukuku","is-hukuku","bosanma-aile-hukuku","icra-hukuku"],"cardSummary":"Kira, iş ve site yönetimi dosyalarında belge hazırlığı.","sections":[{"id":"kira-is","title":"Kira ve iş uyuşmazlıkları","paragraphs":["Kiracının erken teslimi, kira bedeli, depozito ve tahliye taleplerinde sözleşme ile teslim ve ödeme kayıtları birlikte değerlendirilir. İş dosyalarında çalışma dönemi, ücret, fesih ve varsa arabuluculuk evrakı incelenir."]},{"id":"site-belgeleri","title":"Site ve apartman dosyalarında belge hazırlığı","paragraphs":["Site veya apartman dosyalarında site adı, blok, bağımsız bölüm ve yönetim yazışmaları; iş uyuşmazlıklarında bordro, sözleşme ve fesih belgeleri birlikte hazırlanmalıdır. Yönetim planı, ilgili karar ve hesap dökümleri talebin dayanağını değerlendirmeye yardımcı olur."]}],"faq":[{"question":"Kiracı erken çıkarsa kalan kiraların tamamını öder mi?","answer":"Sözleşme ve teslim bilgileri incelenmeden kesin tutar söylenemez. Erken tahliyede kira ilişkisinin nasıl değerlendirildiğini ilgili rehberde inceleyebilirsiniz.","articleRef":"kiraci-erken-cikarsa-kalan-kira"},{"question":"Tüketici hakem heyeti kararına itiraz için ne hazırlanmalı?","answer":"Kararın tamamı, tebliğ bilgileri, başvuru dosyası ve işlem belgeleri hazırlanmalıdır. Başvuru yolu ve süre somut dosyaya göre kontrol edilir.","articleRef":"tuketici-hakem-heyeti-kararina-itiraz"}],"guideLink":"Beylikdüzü Avukat sayfasını inceleyin","jurisdictionTitle":"Beylikdüzü hangi adli yargı çevresindedir?"},"avcilar":{"name":"Avcılar","pageTitle":"Avcılar Avukat | Av. Burak Uğur Öztürk","h1":"Avcılar Avukat Av. Burak Uğur Öztürk","summary":"Avcılar'da kentsel dönüşüm, kira, iş ve icra uyuşmazlıklarında sözleşme incelemesi, hukuki danışmanlık ve dava takibi.","body":["Avcılar ile ilgili başvurularda kentsel dönüşüm sözleşmeleri, kira ilişkileri ve bunlarla bağlantılı ödeme veya tahliye uyuşmazlıkları dosyanın belgeleri üzerinden ele alınır. İş ve icra başvuruları da kendi usul ve süreleri bakımından ayrıca değerlendirilir."],"relatedAreas":["is-hukuku","icra-hukuku","bosanma-aile-hukuku","kira-hukuku","miras-hukuku"],"cardSummary":"Kentsel dönüşüm ve kira sözleşmeleri.","sections":[{"id":"donusum-sozlesme","title":"Kentsel dönüşüm ve sözleşme incelemesi","paragraphs":["Tapu ve bağımsız bölüm bilgileri, sözleşmenin tüm ekleri, paydaş kararları ve bildirimler birlikte hazırlanmalıdır. Teslim, ödeme, temsil yetkisi ve tarafların yükümlülükleri sözleşmenin bütünü içinde incelenir."]},{"id":"kira-icra","title":"Kira ve icra dosyaları","paragraphs":["Erken teslim, tahliye taahhüdü veya ödeme emri söz konusuysa ilgili belgenin aslı, tebliğ bilgileri ve ödeme kayıtları önem taşır. Farklı takip ve dava türleri için tek bir süre varsayılmaz."]}],"faq":[{"question":"Dönüşüm sözleşmesinin yalnız imza sayfası yeterli mi?","answer":"Sözleşmenin tamamı, ekleri, tapu bilgileri ve ilgili kararlar birlikte incelenmelidir."},{"question":"Tahliye taahhüdü nasıl değerlendirilir?","answer":"Belgenin düzenlenme ve teslim koşulları, tarihleri ve kira ilişkisi birlikte ele alınır.","articleRef":"tahliye-taahhudu-ne-zaman-gecerlidir"}],"guideLink":"Avcılar Avukat sayfasını inceleyin","jurisdictionTitle":"Avcılar hangi adli yargı çevresindedir?"},"kucukcekmece":{"name":"Küçükçekmece","pageTitle":"Küçükçekmece Avukat | Av. Burak Uğur Öztürk","h1":"Küçükçekmece Avukat Av. Burak Uğur Öztürk","summary":"Küçükçekmece'de konut ve işyeri kirası, tüketici ve icra uyuşmazlıklarında başvuru yolları, hukuki danışmanlık ve dava takibi.","body":["Küçükçekmece ile ilgili konut ve işyeri kiraları, tüketici işlemleri ve icra başvurularında işlem belgeleri, bildirimler ve mevcut kararlar değerlendirilir. Başvuru yolu, görev ve yetki dosyanın niteliğine göre belirlenir."],"relatedAreas":["is-hukuku","icra-hukuku","bosanma-aile-hukuku","kira-hukuku","miras-hukuku"],"cardSummary":"Tüketici, kira ve icra başvuruları.","sections":[{"id":"tuketici","title":"Tüketici işlemleri ve kararlar","paragraphs":["Fatura veya sözleşme, sipariş ve teslim kayıtları, satıcıyla yazışmalar, servis evrakı ve varsa hakem heyeti kararı dosyanın temel belgeleridir. Karar varsa tebliğ bilgileri ayrıca hazırlanmalıdır."]},{"id":"kira-odeme","title":"Kira, depozito ve ödeme kayıtları","paragraphs":["Kira sözleşmesi ile depozito ve kira ödemelerini gösteren kayıtlar, teslim tutanağı ve yazışmalar birlikte incelenir. İcra dosyası açılmışsa takip evrakı ve dosya numarası değerlendirmeye eklenir."]}],"faq":[{"question":"Ayıplı ürün başvurusunda ne hazırlanmalı?","answer":"Satın alma belgesi, teslim bilgileri, ayıbı gösteren kayıtlar ve satıcı veya servisle yazışmalar birlikte hazırlanır.","articleRef":"ayipli-mal-tuketici-haklari"},{"question":"Hakem heyeti kararına itirazda hangi tarih önemlidir?","answer":"Kararın tebliğine ilişkin kayıtlar hazırlanmalıdır; başvuru süresi ve yolu somut karar üzerinden kontrol edilir.","articleRef":"tuketici-hakem-heyeti-kararina-itiraz"}],"guideLink":"Küçükçekmece Avukat sayfasını inceleyin","jurisdictionTitle":"Küçükçekmece hangi adli yargı çevresindedir?"},"silivri":{"name":"Silivri","pageTitle":"Silivri Avukat | Av. Burak Uğur Öztürk","h1":"Silivri Avukat Av. Burak Uğur Öztürk","summary":"Silivri'de miras, paydaşlı taşınmaz, kira ve iş uyuşmazlıklarında belge değerlendirmesi, hukuki danışmanlık ve dava takibi.","body":["Silivri ile ilgili miras ve paydaşlı taşınmaz dosyalarında mülkiyet kayıtları, pay oranları, kullanım durumu ve önceki işlemler birlikte incelenir. Kira ve iş uyuşmazlıklarında ise sözleşme, ödeme ve bildirim belgeleri değerlendirilir."],"relatedAreas":["is-hukuku","icra-hukuku","bosanma-aile-hukuku","kira-hukuku","miras-hukuku"],"cardSummary":"Paydaşlı taşınmaz ve miras paylaşımı.","sections":[{"id":"paydas-tasinmaz","title":"Paydaşlı taşınmazlarda belge düzeni","paragraphs":["Her taşınmaz için tapu bilgileri, paydaş listesi, kullanım veya kira kayıtları ve varsa önceki anlaşmalar ayrı hazırlanmalıdır. Ortaklığın giderilmesi ve kullanım karşılığı talepler farklı koşullara göre değerlendirilir."]},{"id":"miras-paylasim","title":"Miras paylaşımı ve devir kayıtları","paragraphs":["Mirasçılık belgesi, tapu kayıtları ve önceki devir belgeleri incelenir. Bir payın satışı veya taşınmazın tek kişi tarafından kullanılması söz konusuysa buna ilişkin tarih ve bildirimler de dosyaya eklenir."]}],"faq":[{"question":"Birden fazla taşınmazın evrakı nasıl hazırlanmalı?","answer":"Her taşınmazın tapu bilgileri ve kullanım belgeleri ayrı dosyalanmalıdır; mirasçılık belgesi ve ilgili devir kayıtları birlikte sunulabilir.","articleRef":"ortakligin-giderilmesi-davasi"},{"question":"Pay satışı veya tek başına kullanım ayrı değerlendirilir mi?","answer":"Pay satışı, kullanım ve varsa yapılan bildirimler farklı hukuki taleplerle ilgili olabilir; somut işlemler ayrı incelenir.","articleRef":"sufa-onalim-hakki-davasi"}],"guideLink":"Silivri Avukat sayfasını inceleyin","jurisdictionTitle":"Silivri hangi adli yargı çevresindedir?"},"catalca":{"name":"Çatalca","pageTitle":"Çatalca Avukat | Av. Burak Uğur Öztürk","h1":"Çatalca Avukat Av. Burak Uğur Öztürk","summary":"Çatalca'da arazi, miras, kamulaştırma ve kira uyuşmazlıklarında hukuki danışmanlık, dosya değerlendirmesi ve dava takibi.","body":["Çatalca ile ilgili arazi, miras, kamulaştırma ve kira başvurularında taşınmazın ada-parsel bilgileri, mülkiyet geçmişi ve ilgili işlem belgeleri birlikte değerlendirilir. Görevli ve yetkili merci, başvurunun türüne göre ayrıca belirlenir."],"relatedAreas":["is-hukuku","icra-hukuku","bosanma-aile-hukuku","kira-hukuku","miras-hukuku"],"cardSummary":"Arazi, miras ve kamulaştırma dosyaları.","sections":[{"id":"arazi-kamulastirma","title":"Arazi ve kamulaştırma belgeleri","paragraphs":["Güncel tapu bilgileri, ada-parsel kayıtları, varsa idari işlem, karar, tebligat ve fiilî kullanım belgeleri hazırlanmalıdır. İdari işlemle fiilî müdahalenin niteliği aynı kabul edilmeden dosya incelenir."]},{"id":"miras-kira","title":"Miras ve kira bağlantılı başvurular","paragraphs":["Mirasçılık belgesi, pay veya devir kayıtları ve varsa kira sözleşmeleri birlikte değerlendirilir. Farklı yerleşimlerdeki taşınmazlar için belgeleri ada-parsel bazında ayırmak karışıklığı önler."]}],"faq":[{"question":"Arazi için yalnız mahalle adı yeterli mi?","answer":"Taşınmazı ayırt etmek için ada-parsel ve tapu bilgileri ile ilgili işlem belgeleri hazırlanmalıdır."},{"question":"Kamulaştırmasız el atma başvurusunda ne incelenir?","answer":"Mülkiyet kaydı, müdahalenin niteliği, idari belgeler ve kullanım durumu birlikte değerlendirilir; başvuru yolu ve süre dosyaya göre belirlenir.","articleRef":"kamulastirmasiz-el-atma-fiili-hukuki-el-atma"}],"guideLink":"Çatalca Avukat sayfasını inceleyin","jurisdictionTitle":"Çatalca hangi adli yargı çevresindedir?"},"mimaroba":{"name":"Mimaroba","pageTitle":"Mimaroba Avukat | Av. Burak Uğur Öztürk","h1":"Mimaroba Av. Burak Uğur Öztürk","summary":"Mimaroba'da kira, site yönetimi, miras ve aile hukuku uyuşmazlıklarında hukuki danışmanlık ve dava takibi. Av. Burak Uğur Öztürk.","body":["Mimaroba'da avukat desteği arayan kişiler için kira, site yönetimi, miras, iş ve aile hukuku uyuşmazlıklarında hukuki danışmanlık ve dava takibi hizmeti sunulmaktadır. İlk değerlendirmede uyuşmazlığın konusu, mevcut belgeler ve izlenebilecek hukuki yollar birlikte ele alınır."],"relatedAreas":["is-hukuku","icra-hukuku","bosanma-aile-hukuku","kira-hukuku","miras-hukuku"],"cardSummary":"Site yönetimi, kira ve miras uyuşmazlıkları.","sections":[{"id":"site-kira","title":"Mimaroba'da site yönetimi ve kira uyuşmazlıkları","paragraphs":["Aidat ve ortak gider talepleri, yönetim kararları, kira bedeli ve tahliye uyuşmazlıklarında her dosyanın dayanak belgeleri farklıdır. Site yönetimi başvurularında yönetim planı, ilgili karar, hesap dökümü ve ödeme belgeleri; kira dosyalarında sözleşme, dekontlar ve varsa ihtarname birlikte değerlendirilmelidir."]},{"id":"belge-hazirligi","title":"Görüşme öncesinde hangi belgeler hazırlanmalı?","paragraphs":["Site adı, blok ve bağımsız bölüm bilgileri, uyuşmazlıkla ilgili yazışmalar ve tebligatlar hazırlanmalıdır. Miras dosyalarında mirasçılık belgesi ve taşınmaz kayıtları; iş uyuşmazlıklarında sözleşme, bordro ve fesih belgeleri değerlendirmeye yardımcı olur."]}],"faq":[{"question":"Site aidatına ilişkin talep nasıl değerlendirilir?","answer":"Talebin dayanağı, yönetim planı, kararlar ve hesap dökümü birlikte incelenir."},{"question":"Kiracı erken çıkarsa kalan kiraların tamamını öder mi?","answer":"Sözleşme ve teslim bilgileri incelenmeden kesin tutar söylenemez; kiracının erken çıkması rehberi bu konuya ilişkin genel açıklamalar içerir.","articleRef":"kiraci-erken-cikarsa-kalan-kira"},{"question":"Miras kalan taşınmaz için ilk hangi belgeler gerekir?","answer":"Mirasçılık belgesi, tapu bilgileri ve varsa paylaşım veya devir belgeleri hazırlanır.","articleRef":"miras-kalan-ev-ecrimisil-davasi"}],"guideLink":"Mimaroba Avukat sayfasını inceleyin","jurisdictionTitle":"Mimaroba hangi adli yargı çevresindedir?"}},"serviceRegionsPage":{"meta":{"title":"Hizmet Verilen Bölgeler","description":"Esenyurt, Beylikdüzü, Büyükçekmece, Mimaroba, Avcılar, Küçükçekmece, Silivri ve Çatalca için bölge rehberleri, ilgili hukuk alanları ve makaleler."},"label":"Bölgeler","title":"Hizmet Verilen Bölgeler","lead":"Av. Burak Uğur Öztürk; Esenyurt, Beylikdüzü, Büyükçekmece, Mimaroba, Avcılar, Küçükçekmece, Silivri ve Çatalca ile ilgili hukuki uyuşmazlıklarda danışmanlık ve dava takibi hizmeti sunar. Bölge sayfalarında ilgili hukuk alanlarını, hazırlanacak belgeleri ve hukuki süreçlere ilişkin açıklamaları inceleyebilirsiniz."},"serviceRegionDetail":{"back":"Tüm bölgeler","relatedAreasLabel":"İlgili Çalışma Alanları","contactCta":"İletişime geçin","tocLabel":"İçindekiler","faqTitle":"Sık sorulan sorular","articlesTitle":"İlgili makaleler","articlesLead":"Bu bölgedeki başvurularla bağlantılı konular için aşağıdaki mevcut rehberleri inceleyebilirsiniz.","toolsTitle":"İlgili hesaplama araçları","regionsTitle":"İlgili bölge rehberleri","jurisdictionText":"Esenyurt, Büyükçekmece Adliyesinin adli yargı çevresindedir. Büyükçekmece Adliyesinin yargı çevresi Büyükçekmece, Beylikdüzü ve Esenyurt ilçelerini kapsar. Bununla birlikte somut dosyada görevli ve yetkili mahkeme; uyuşmazlığın türü, özel yargı çevresi düzenlemeleri ve kanuni yetki kurallarına göre ayrıca belirlenir.","jurisdictionCaveat":"Bu açıklama, tüm iş, tüketici, ticaret veya ağır ceza dosyalarının mutlaka aynı adliyede görüleceği anlamına gelmez. İlçenin bağlı olduğu yargı çevresi ile belirli bir dava türünün görev ve yetki kuralları birbirinden ayrılmalıdır.","jurisdictionSource":"Resmî kaynak: Bakırköy Adliyesi 2025 Yılı Faaliyet Raporu, Mart 2026, s. 3","mimarobaJurisdictionIntro":"Mimaroba, Büyükçekmece ilçesine bağlı bir mahalledir ve Büyükçekmece Adliyesinin adli yargı çevresi kapsamında yer alır."},"profilePage":{"meta":{"title":"Profil","description":"Av. Burak Uğur Öztürk — İstanbul Barosu'na kayıtlı avukat. Çalışma dilleri Türkçe, İngilizce ve Arapça."},"label":"Profil","title":"Av. Burak Uğur Öztürk","intro":"Av. Burak Uğur Öztürk, İstanbul Barosu'na kayıtlı olarak bağımsız avukat sıfatıyla faaliyet göstermektedir. Çalışma dilleri Türkçe, İngilizce ve Arapçadır; bu sayede yabancı yatırımcılar ve çok uluslu taraflarla doğrudan iletişim kurulabilmektedir.","portraitAlt":"Av. Burak Uğur Öztürk","admissionLabel":"Baro Kaydı","languagesLabel":"Çalışma Dilleri","languages":"Türkçe, İngilizce, Arapça","approachTitle":"Çalışma Yaklaşımı","approachBody":["Her dosya, ilgili mevzuatın ve güncel yargı uygulamasının incelenmesiyle başlar. Müvekkile aktarılan değerlendirme; mevcut seçenekleri, bu seçeneklere bağlı riskleri ve olası süreleri açıkça ortaya koyacak şekilde hazırlanır.","Dosya sayısı, her işe yeterli zaman ayrılabilmesi gözetilerek sınırlı tutulur. Müvekkil ile iletişim, sürecin her aşamasında düzenli bilgilendirme esasına dayanır."],"scopeTitle":"Çalışma Alanları","scopeLinkText":"Çalışma alanlarını görüntüleyin","contactCta":"İletişime geçin"},"articlesPage":{"meta":{"title":"Makaleler","description":"İş, icra, boşanma ve aile, kira, miras, tazminat ve şirketler hukukunda sık sorulan sorulara ilişkin Av. Burak Uğur Öztürk'ün bilgilendirici yazıları."},"label":"Makaleler","title":"Güncel yazılar","lead":"Mevzuat ve uygulamaya ilişkin genel bilgilendirme amaçlı yazılar. Aşağıdaki listeyi kategoriye göre filtreleyebilirsiniz.","filterAll":"Tümü","filterLabel":"Kategori","searchLabel":"Makalelerde ara","searchPlaceholder":"Anahtar kelime","searchSubmit":"Ara","empty":"Bu kritere uygun makale bulunamadı.","prevPage":"Önceki","nextPage":"Sonraki","pageLabel":"Sayfa {page} / {totalPages}"},"articleDetail":{"back":"Tüm makalelere dön","tocLabel":"İçindekiler","relatedLabel":"İlgili Makaleler","authorLabel":"Yazar","authorDescription":"İstanbul Barosu · Sicil No: 84442 · Çalışma dilleri: Türkçe, İngilizce ve Arapça.","sourcesLabel":"Resmî mevzuat kaynakları","regionsLabel":"İlgili bölge rehberleri"},"toolsPage":{"meta":{"title":"Hesaplama Araçları","description":"Kıdem tazminatı, yıllık izin, fazla çalışma, işsizlik ödeneği, kira artışı, nafaka, infaz ve miras payı için bilgilendirme amaçlı hesaplama araçları."},"label":"Araçlar","title":"Hukuki Hesaplama Araçları","lead":"Yürürlükteki mevzuata dayanan, genel bilgilendirme amaçlı hesaplama araçları. Girdiğiniz bilgiler tarayıcınızdan çıkmaz; hiçbir veri kaydedilmez veya iletilmez. Sonuçlar somut olayınızın değerlendirilmesinin yerine geçmez.","back":"Tüm hesaplama araçları","otherToolsLabel":"Diğer Araçlar"},"tools":{"form":{"inputsLabel":"Bilgiler","resultLabel":"Sonuç","submit":"Hesapla","reset":"Temizle","idle":"Alanları doldurup Hesapla düğmesine basın. Girdiğiniz bilgiler tarayıcınızdan çıkmaz.","parametersUnverified":"Bu araçta kullanılan yasal parametreler henüz güncellik denetiminden geçmemiştir. Sonucu esas almadan önce ilgili dönemin resmî tutarlarıyla karşılaştırın.","privacyNote":"Girdiğiniz bilgiler yalnızca tarayıcınızda işlenir; hiçbir veri kaydedilmez veya gönderilmez."},"parameters":{"severanceCeilingPerYear":"Kıdem tazminatı tavanı","minimumWageGrossMonthly":"Brüt asgari ücret","stampDutyRate":"Damga vergisi oranı"},"errors":{"missingFields":"Lütfen zorunlu alanların tümünü doldurun.","invalidAmount":"Girilen tutar veya sayı geçerli değil.","endBeforeStart":"Bitiş tarihi başlangıç tarihinden sonra olmalıdır.","serviceTooShort":"Kıdem tazminatına hak kazanmak için en az bir yıllık hizmet süresi gerekir.","leaveNotYetAccrued":"Yıllık ücretli izne hak kazanmak için en az bir yıllık hizmet süresi gerekir.","invalidContractHours":"Sözleşmedeki haftalık çalışma süresi 1 ile 45 saat arasında olmalıdır.","noOvertime":"Girilen çalışma süresi, sözleşmedeki süreyi aşmıyor. Fazla çalışma ücreti doğmaz.","premiumDaysTooLow":"Son üç yılda en az 600 gün prim ödenmiş olması gerekir.","invalidRatio":"Oran 0 ile 100 arasında olmalıdır.","invalidPeriod":"Girilen süre geçerli değil.","noHeirsInOrder":"Girilen bilgilerle bu zümrede mirasçı bulunmuyor.","estateEscheats":"Mirasçı ve sağ kalan eş bulunmadığında miras Devlete geçer (TMK m.501)."},"kidem-tazminati":{"name":"Kıdem Tazminatı Hesaplama","summary":"İşe giriş-çıkış tarihi ve giydirilmiş brüt ücrete göre kıdem tazminatını, yürürlükteki tavan ve damga vergisiyle birlikte hesaplar.","intro":"Kıdem tazminatı, 1475 sayılı İş Kanunu'nun 4857 sayılı Kanun'un geçici 6. maddesiyle yürürlükte bırakılan 14. maddesine göre hesaplanır. Her tam hizmet yılı için 30 günlük giydirilmiş brüt ücret ödenir; artan süreler oranlanır. Ödeme gelir vergisinden istisnadır, yalnızca damga vergisi kesilir. Hesaplama, iş sözleşmesinin kıdem tazminatına hak kazandıran bir nedenle sona erdiği varsayımına dayanır.","fields":{"startDate":"İşe giriş tarihi","endDate":"İşten çıkış tarihi","grossMonthlyWage":"Aylık brüt ücret","annualBenefits":"Yıllık ek ödemeler toplamı","annualBenefitsHint":"Yol, yemek, yakacak, ikramiye gibi süreklilik gösteren yıllık ödemelerin toplamı. Giydirilmiş ücrete eklenir; yoksa boş bırakın."},"results":{"serviceDuration":"Hizmet süresi (tam yıl / artan gün)","dressedWage":"Giydirilmiş aylık brüt ücret","appliedBase":"Hesaba esas 30 günlük tutar","gross":"Brüt kıdem tazminatı","stampDuty":"Damga vergisi kesintisi","net":"Net kıdem tazminatı"},"notes":{"ceilingApplied":"Giydirilmiş ücretiniz yürürlükteki kıdem tazminatı tavanını aştığı için hesaplama tavan tutar üzerinden yapılmıştır.","incomeTaxExempt":"Kıdem tazminatı gelir vergisinden istisnadır; tavanı aşan ödemeler bu istisnanın dışındadır."}},"infaz-hesaplama":{"name":"İnfaz (Yatar) Hesaplama","summary":"Suç tarihi, suç türü ve tekerrür durumuna göre koşullu salıverilme süresini, denetimli serbestliği ve tahmini infaz süresini gösterir.","intro":"Hesaplama, 5275 sayılı Ceza ve Güvenlik Tedbirlerinin İnfazı Hakkında Kanun'un 105/A ve 107. maddeleri ile tekerrür hâlinde 108. maddesine dayanır. Sonuç yalnızca bir tahmindir: tutuklulukta geçen sürenin mahsubu, cezaların içtimaı, ağırlaştırılmış müebbet ve müebbet hapis, çocuk ve hasta hükümlülere ilişkin özel rejimler ile 3713 sayılı Kanun kapsamındaki suçlar bu araçta modellenmemiştir.","fields":{"sentenceYears":"Ceza — yıl","sentenceMonths":"Ceza — ay","sentenceDays":"Ceza — gün","offencePeriod":"Suç tarihi","offencePeriodHint":"30.03.2020 tarihinden önce işlenen suçlarda denetimli serbestlik süresi geçici 6. madde uyarınca üç yıl olarak uygulanır.","offenceType":"Suç türü","offenceTypeHint":"Kasten öldürme, cinsel dokunulmazlığa karşı suçlar, uyuşturucu ticareti ve benzeri katalog suçlarda koşullu salıverilme oranı üçte ikidir.","repeatOffender":"Tekerrür"},"options":{"offencePeriod_before2020":"30.03.2020 tarihinden önce","offencePeriod_after2020":"30.03.2020 tarihinde veya sonrasında","offenceType_general":"Genel hükümlere tabi suç","offenceType_aggravated":"Katalog suç (2/3 oranına tabi)","repeatOffender_no":"Tekerrür yok","repeatOffender_yes":"Tekerrür var"},"results":{"totalSentence":"Toplam ceza (yıl / ay / gün)","appliedRatio":"Koşullu salıverilme oranı","paroleDuration":"Koşullu salıverilmeye kadar (yıl / ay / gün)","supervisedRelease":"Denetimli serbestlik (yıl)","estimatedTimeServed":"Tahmini cezaevi süresi (yıl / ay / gün)"},"notes":{"paroleScopeLimits":"Cezaların içtimaı, ağırlaştırılmış müebbet ve müebbet hapis, çocuk hükümlüler, 65 yaş üstü ve hasta hükümlülere ilişkin özel rejimler hesaplamaya dâhil değildir.","paroleNoRemandCredit":"Tutuklulukta veya gözaltında geçen sürenin mahsubu dikkate alınmamıştır; bu süre fiilî infaz süresini kısaltır.","paroleSeekCounsel":"İnfaz hesabı, hükmün ve suç tarihinin somut olarak incelenmesini gerektirir. Bu sonuç bir infaz hesabı belgesi değildir."}},"kira-artis-orani":{"name":"Kira Artış Oranı Hesaplama","summary":"Sözleşme yenileme döneminde uygulanabilecek yasal azami kira artışını, TÜFE on iki aylık ortalamasına göre hesaplar.","intro":"Türk Borçlar Kanunu m.344 uyarınca kira bedelindeki artış, bir önceki kira yılında tüketici fiyat endeksindeki on iki aylık ortalamalara göre değişim oranını geçemez. Sözleşmede daha yüksek bir oran kararlaştırılmışsa bu oran, endeksi aşan kısmı bakımından geçersizdir. Konut kiralarına ilişkin yüzde 25 sınırı geçici bir düzenlemeydi ve 1 Temmuz 2024 tarihinde sona ermiştir.","fields":{"currentRent":"Mevcut aylık kira bedeli","cpiRate":"TÜFE on iki aylık ortalama değişim oranı (%)","cpiRateHint":"Sözleşmenin yenilendiği aya ait oranı TÜİK'in yayımladığı resmî seriden alın. Bu değer her ay değiştiği için araca gömülü değildir.","agreedRate":"Sözleşmede kararlaştırılan artış oranı (%)","agreedRateHint":"Sözleşmenizde bir artış oranı varsa girin. Endeksin altındaysa o oran, üstündeyse endeks uygulanır. Yoksa boş bırakın."},"results":{"currentRent":"Mevcut kira","appliedRate":"Uygulanan artış oranı","increase":"Aylık artış tutarı","newRent":"Yeni aylık kira","legalMaximum":"Yasal azami kira","annualDifference":"Yıllık fark"},"notes":{"rentCapBasis":"Hesaplama, TBK m.344 uyarınca TÜFE on iki aylık ortalamasını üst sınır kabul eder. İşyeri kiralarında da aynı sınır uygulanır.","agreedRateCapped":"Sözleşmede kararlaştırılan oran endeksi aştığı için hesaplama endeks oranı üzerinden yapılmıştır."}},"nafaka-artirim":{"name":"Nafaka Artırım Hesaplama","summary":"Mahkeme kararındaki artış kaydına göre güncel nafaka tutarını, aylık artışı ve yıllık farkı hesaplar.","intro":"Mahkeme kararlarında nafakanın her yıl belirli bir oranda artırılmasına hükmedilmesi yaygındır. Artış bileşik işler: her yılın artışı, bir önceki yılın artışıyla ulaşılan tutar üzerinden uygulanır. Kararda oran yerine bir endekse atıf yapılmışsa, ilgili döneme ait resmî oranı girin. Nafakanın koşulların değişmesi nedeniyle yeniden belirlenmesi (TMK m.176/4) ayrı bir dava konusudur ve bu hesaplamanın kapsamı dışındadır.","fields":{"currentAlimony":"Mevcut aylık nafaka","annualRate":"Yıllık artış oranı (%)","annualRateHint":"Kararda yazan oranı girin. Kararda TÜFE veya Yİ-ÜFE'ye atıf yapılmışsa ilgili dönemin resmî oranını kullanın.","years":"Artış uygulanacak yıl sayısı"},"results":{"currentAlimony":"Mevcut nafaka","appliedRate":"Yıllık artış oranı","years":"Yıl sayısı","updatedAlimony":"Güncel aylık nafaka","monthlyIncrease":"Aylık artış tutarı","annualDifference":"Yıllık fark"},"notes":{"alimonyCompounding":"Artış bileşik olarak uygulanmıştır; birden fazla yıl için oran her yıl önceki yılın tutarı üzerinden işletilir."}},"is-kazasi-tazminat":{"name":"İş Kazası Maluliyet Tazminatı Hesaplama","summary":"Sürekli iş göremezlik nedeniyle maddi zararı bilinen, aktif ve pasif dönemlere göre; kusur oranı ve SGK mahsubuyla birlikte hesaplar.","intro":"Sürekli iş göremezlik tazminatı, zararın bilinen dönem (kaza ile hesap tarihi arası), aktif dönem (çalışma yaşamının sonuna kadar) ve pasif dönem (bakiye ömrün sonuna kadar) olarak ayrılmasıyla hesaplanır. Aktif dönemde Yargıtay uygulamasındaki progresif rant yöntemi esas alınır; yüzde 10 artırım ve yüzde 10 iskonto birbirini karşıladığından her aktif yıl bir yıllık kazanca karşılık gelir. Bakiye ömür TRH-2010 yaşam tablosundan alınır ve bu araca elle girilir.","fields":{"monthlyEarning":"Aylık net kazanç","monthlyEarningHint":"Kaza tarihindeki net aylık kazanç. Bilinen ve aktif dönem bu tutar üzerinden hesaplanır.","disabilityRatio":"Sürekli iş göremezlik oranı (%)","disabilityRatioHint":"SGK veya adli tıp raporunda belirlenen maluliyet oranı.","faultRatio":"Zarar görenin kusur oranı (%)","faultRatioHint":"Kusur bilirkişi raporunda zarar görene atfedilen oran. Tazminat bu oran kadar indirilir.","knownPeriodMonths":"Bilinen dönem (ay)","activePeriodYears":"Aktif dönem (yıl)","activePeriodYearsHint":"Hesap tarihinden çalışma yaşamının sonuna kadar kalan yıl sayısı.","passivePeriodYears":"Pasif dönem (yıl)","passivePeriodYearsHint":"Çalışma yaşamının sonundan TRH-2010 tablosundaki bakiye ömrün sonuna kadar kalan yıl sayısı.","sgkCapitalValue":"SGK gelirinin peşin sermaye değeri","sgkCapitalValueHint":"SGK tarafından bağlanan sürekli iş göremezlik gelirinin peşin sermaye değeri tazminattan mahsup edilir. Yoksa boş bırakın."},"results":{"knownLoss":"Bilinen dönem zararı","activeLoss":"Aktif dönem zararı","passiveLoss":"Pasif dönem zararı","grossLoss":"Toplam zarar (kusur indirimi öncesi)","liabilityShare":"Sorumluluk oranı","afterFault":"Kusur indirimi sonrası","sgkDeduction":"SGK mahsubu","net":"Tahmini maddi tazminat"},"notes":{"trh2010Source":"Bakiye ömür TRH-2010 yaşam tablosundan alınır; tablo yaşa ve cinsiyete göre değiştiğinden bu araca gömülü değildir.","progressiveRentMethod":"Aktif dönemde progresif rant yöntemi uygulanmıştır (yüzde 10 artırım, yüzde 10 iskonto).","expertReportRequired":"Bu sonuç bir aktüerya raporu değildir. Yargılamada zarar, mahkemece atanan bilirkişi tarafından hesaplanır."}},"yillik-izin":{"name":"Yıllık İzin Hesaplama","summary":"İşe giriş tarihine göre hak edilen yıllık ücretli izin süresini ve birikmiş izin bakiyesini hesaplar.","intro":"4857 sayılı İş Kanunu m.53 uyarınca yıllık ücretli izin süresi, hizmet süresi bir yıldan beş yıla kadar olanlarda on dört, beş yıldan fazla on beş yıldan az olanlarda yirmi, on beş yıl ve daha fazla olanlarda yirmi altı günden az olamaz. On sekiz yaşından küçük ve elli yaşından büyük işçilerde izin süresi yirmi günün altına düşemez. İzne hak kazanmak için en az bir yıllık hizmet süresi gerekir.","fields":{"startDate":"İşe giriş tarihi","referenceDate":"Hesap tarihi","usedDays":"Kullanılan izin günü","ageGroup":"İşçinin durumu","ageGroupHint":"On sekiz yaşından küçük veya elli yaşından büyük işçilerde yıllık izin yirmi günün altına düşemez."},"options":{"ageGroup_standard":"18-50 yaş arası","ageGroup_protected":"18 yaşından küçük veya 50 yaşından büyük"},"results":{"completedYears":"Tamamlanan hizmet yılı","currentEntitlement":"Bu yıl hak edilen izin (gün)","accrued":"Toplam hak edilen izin (gün)","used":"Kullanılan izin (gün)","balance":"İzin bakiyesi (gün)"},"notes":{"leaveIsMinimum":"Kanundaki süreler asgari sürelerdir; iş sözleşmesi veya toplu iş sözleşmesiyle artırılabilir.","usedExceedsAccrued":"Kullanılan izin, hak edilen izinden fazla görünüyor. Girdiğiniz değerleri kontrol edin."}},"fazla-mesai":{"name":"Fazla Mesai Ücreti Hesaplama","summary":"Haftalık 45 saati aşan çalışmaların yüzde 50, sözleşmedeki süreyi aşan çalışmaların yüzde 25 zamlı brüt karşılığını hesaplar.","intro":"4857 sayılı İş Kanunu m.41 uyarınca haftalık kırk beş saati aşan çalışmalar fazla çalışmadır ve saat ücretinin yüzde elli fazlasıyla ödenir. Haftalık çalışma süresi sözleşmeyle kırk beş saatin altında belirlenmişse, bu süre ile kırk beş saat arasındaki çalışma fazla sürelerle çalışmadır ve yüzde yirmi beş zamlı ödenir. Fazla çalışma süresi yılda iki yüz yetmiş saati aşamaz. Saat ücreti, aylık brüt ücretin 225'e bölünmesiyle bulunur.","fields":{"grossMonthlyWage":"Aylık brüt ücret","contractWeeklyHours":"Sözleşmedeki haftalık çalışma süresi (saat)","contractWeeklyHoursHint":"Sözleşmede kırk beş saatten az bir süre kararlaştırılmışsa girin. Aksi hâlde 45 bırakın.","actualWeeklyHours":"Fiilen çalışılan haftalık süre (saat)","weeks":"Hafta sayısı"},"results":{"hourlyRate":"Saatlik brüt ücret","overtimeHours":"Fazla çalışma (saat)","overtimePay":"Fazla çalışma ücreti (%50 zamlı)","extraTimeHours":"Fazla sürelerle çalışma (saat)","extraTimePay":"Fazla sürelerle çalışma ücreti (%25 zamlı)","total":"Toplam brüt alacak"},"notes":{"grossFigures":"Tutarlar brüttür; vergi ve sigorta kesintileri düşülmemiştir.","overtimeCapExceeded":"Hesaplanan fazla çalışma süresi yıllık iki yüz yetmiş saatlik sınırı aşıyor. Sınırın aşılması ücret hakkını ortadan kaldırmaz."}},"issizlik-maasi":{"name":"İşsizlik Maaşı Hesaplama","summary":"Son dört aylık kazanca ve prim gün sayısına göre aylık işsizlik ödeneğini, tavan ve ödeme süresiyle birlikte hesaplar.","intro":"4447 sayılı İşsizlik Sigortası Kanunu m.50 uyarınca günlük işsizlik ödeneği, sigortalının son dört aylık prime esas kazançları dikkate alınarak hesaplanan günlük ortalama brüt kazancının yüzde kırkıdır. Bu tutar, brüt asgari ücretin yüzde seksenini geçemez. Ödeme süresi son üç yıldaki prim gün sayısına göre 180, 240 veya 300 gündür. Ödenekten yalnızca damga vergisi kesilir.","fields":{"averageGrossMonthly":"Son dört ayın aylık brüt kazanç ortalaması","averageGrossMonthlyHint":"Son dört aya ait prime esas brüt kazançların aylık ortalaması.","premiumDays":"Son üç yıldaki prim gün sayısı","premiumDaysHint":"Ödeneğe hak kazanmak için son üç yılda en az 600 gün prim ve son 120 gün kesintisiz hizmet gerekir."},"results":{"grossMonthly":"Aylık brüt ödenek","stampDuty":"Damga vergisi kesintisi","netMonthly":"Aylık net ödenek","benefitDays":"Ödeme süresi (gün)","benefitMonths":"Ödeme süresi (ay)","totalBenefit":"Toplam net ödenek"},"notes":{"benefitConditions":"Ödeneğe hak kazanmak, hizmet akdinin kanunda sayılan nedenlerle sona ermiş olmasına ve süresinde başvuruya bağlıdır.","benefitCeilingApplied":"Hesaplanan ödenek brüt asgari ücretin yüzde seksenini aştığı için tavan tutar uygulanmıştır."}},"miras-payi":{"name":"Miras Payı Hesaplama","summary":"Sağ kalan eş, altsoy, ana-baba ve kardeşlerin yasal miras paylarını ve saklı payları zümre sistemine göre hesaplar.","intro":"Türk Medeni Kanunu m.495-501 uyarınca miras, zümre sistemine göre paylaşılır. Birinci zümre altsoy, ikinci zümre ana-baba ve onların altsoyu, üçüncü zümre büyük ana-babadır. Yakın zümrede mirasçı varsa uzak zümre mirastan pay alamaz. Sağ kalan eş, çağrılan zümreye göre değişen oranda birlikte mirasçı olur. Saklı pay oranları m.506'da düzenlenmiştir; kardeşlerin saklı payı 2007 yılında kaldırılmıştır.","fields":{"estateValue":"Terekenin net değeri","estateValueHint":"Mal rejiminin tasfiyesinden sonra kalan, borçlar düşülmüş net tereke değeri.","spouse":"Sağ kalan eş","childCount":"Çocuk (altsoy) sayısı","parentsAlive":"Sağ olan ana-baba sayısı","parentsAliveHint":"Yalnızca altsoy yoksa dikkate alınır. Ölmüş olan ananın veya babanın payı kendi altsoyuna, yani kardeşlere geçer.","siblingCount":"Kardeş sayısı"},"options":{"spouse_yes":"Var","spouse_no":"Yok","parentsAlive_0":"İkisi de sağ değil","parentsAlive_1":"Biri sağ","parentsAlive_2":"İkisi de sağ"},"results":{"spouseShare":"Sağ kalan eşin payı","perChildShare":"Çocuk başına pay","childrenTotal":"Çocukların toplam payı","perParentShare":"Ana veya baba başına pay","parentsTotal":"Ana-babanın toplam payı","perSiblingShare":"Kardeş başına pay","siblingsTotal":"Kardeşlerin toplam payı","reservedTotal":"Toplam saklı pay","disposable":"Tasarruf edilebilir kısım"},"notes":{"inheritanceMaritalRegime":"Hesaplama mal rejiminin tasfiyesinden sonraki net tereke üzerinden yapılır. Sağ kalan eşin katılma alacağı mirastan önce ayrılır ve çoğu zaman miras payından büyüktür.","inheritanceScopeLimits":"Mirastan çıkarma, mirasın reddi, evlatlık ilişkisi, tenkise tabi kazandırmalar ve kardeş altsoyunun halefiyeti hesaba dâhil değildir.","inheritanceSiblingsNoReserve":"Kardeşlerin saklı payı 5650 sayılı Kanun'la 2007 yılında kaldırılmıştır.","inheritanceSpouseAloneAssumption":"Altsoy, ana-baba ve kardeş bulunmadığından üçüncü zümrede de mirasçı olmadığı varsayılmış ve tereke tamamen sağ kalan eşe bırakılmıştır."}}},"contactPage":{"meta":{"title":"İletişim","description":"Büroya ulaşmak veya bir görüşme talep etmek için iletişim bilgileri ve form aşağıdadır."},"label":"İletişim","title":"Görüşme Talebi","formLabel":"Talep Formu","requiredNote":"İşaretli alanların doldurulması zorunludur.","lead":"Dosyanıza ilişkin bir görüşme talep etmek için aşağıdaki formu doldurabilir veya doğrudan büroya ulaşabilirsiniz. Form üzerinden gönderilen bilgiler yalnızca talebinizin değerlendirilmesi amacıyla kullanılır.","directLabel":"Doğrudan İletişim","officeLabel":"Büro Adresi","mapLabel":"Konum","mapTitle":"Büro konumu — Google Haritalar","serviceAreasLabel":"Hizmet Verilen Bölgeler","serviceAreasBody":"İş hukuku, icra hukuku, boşanma ve aile hukuku, miras hukuku ile kira hukuku alanlarında; {districts} başta olmak üzere çevre ilçelerde hizmet verilmektedir.","reviewsLabel":"Google Yorumları","reviewRating":"5 üzerinden {rating} yıldız","form":{"name":"Ad Soyad","email":"E-posta","phone":"Telefon (opsiyonel)","subject":"Konu","message":"Mesajınız","consent":"<link>KVKK Aydınlatma Metni'ni</link> okudum, kişisel verilerimin bu kapsamda işlenmesini kabul ediyorum.","submit":"Gönder","submitting":"Gönderiliyor…","success":"Mesajınız alındı. En kısa sürede tarafınızla iletişime geçilecektir.","errorGeneric":"Mesajınız gönderilemedi. Lütfen daha sonra tekrar deneyin.","errorValidation":"Lütfen formu eksiksiz ve doğru şekilde doldurun.","errorRateLimit":"Kısa süre içinde çok fazla deneme yapıldı. Lütfen daha sonra tekrar deneyin.","errorConsent":"Devam etmek için KVKK Aydınlatma Metni'ni onaylamanız gerekmektedir.","errorTooShort":"Bu alan çok kısa.","errorTooLong":"Bu alan çok uzun.","errorRequired":"Bu alan zorunludur.","errorInvalidEmail":"Geçerli bir e-posta adresi girin."},"hoursLabel":"Çalışma saatleri","businessProfileLabel":"Google işletme profili"},"legalPages":{"kvkk":{"nav":"KVKK Aydınlatma Metni"},"gizlilik":{"nav":"Gizlilik Politikası"}},"article":{"readingTime":"{minutes} dk okuma","publishedOn":"Yayın tarihi: {date}","updatedOn":"Güncelleme: {date}","byAuthor":"Yazar: {name}","categoryLabel":"Kategori"},"footer":{"navTitle":"Site","officeTitle":"Büro","contactTitle":"İletişim","legalTitle":"Hukuki Bilgilendirme","barRegistration":"{bar} — Sicil No: {registryNo}","kvkk":"KVKK Aydınlatma Metni","privacy":"Gizlilik Politikası","rights":"© {year} Av. Burak Uğur Öztürk. Tüm hakları saklıdır.","phone":"Telefon","email":"E-posta","whatsapp":"WhatsApp","serviceAreasNote":"Silivri, Çatalca, Büyükçekmece, Beylikdüzü, Esenyurt, Avcılar ve Küçükçekmece başta olmak üzere çevre ilçelerde; iş hukuku, icra hukuku, boşanma ve aile hukuku, miras hukuku ve kira hukuku alanlarında hizmet verilmektedir."},"disclaimer":{"title":"Hukuki Bilgilendirme","body":"Bu sitede yer alan içerik genel bilgilendirme amacı taşır; hukuki tavsiye niteliğinde değildir ve avukat–müvekkil ilişkisi doğurmaz. Somut bir uyuşmazlık veya işlem bakımından karar vermeden önce, kendi durumunuza ilişkin hukuki görüş alınması gerekir. Mevzuat ve yargı uygulaması değişebileceğinden, içeriğin güncelliği garanti edilmez."},"cookieConsent":{"label":"Çerez Tercihi","body":"Ziyaret istatistiklerini tutabilmemiz için bir çerez kullanmamıza izin verir misiniz? Kabul etmezseniz hiçbir ziyaret verisi kaydedilmez. Ayrıntılar için <link>KVKK Aydınlatma Metni'ne</link> bakabilirsiniz.","accept":"Kabul Et","decline":"Reddet","settings":"Çerez tercihleri","bodyGa4":"İzninizle ziyaret ve iletişim etkileşimlerini kendi sunucumuzda ve Google Analytics 4 ile ölçeriz. Google’a sayfa, dil ve etkileşim bilgileri ile analiz çerezleri aktarılabilir. Reddetmeniz hâlinde isteğe bağlı analiz çalışmaz. <link>Ayrıntılar</link>."},"notFound":{"label":"Hata 404","title":"Aradığınız sayfa bulunamadı","body":"Bağlantı taşınmış veya kaldırılmış olabilir. Anasayfadan devam edebilirsiniz.","home":"Anasayfaya dön"},"error":{"label":"Hata","title":"Beklenmeyen bir hata oluştu","body":"İşlem tamamlanamadı. Sayfayı yeniden yüklemeyi deneyebilirsiniz.","retry":"Yeniden dene"},"admin":{"login":{"meta":{"title":"Yönetim Girişi"},"eyebrow":"Yönetim Paneli","title":"Giriş Yap","email":"E-posta","password":"Şifre","submit":"Giriş Yap","submitting":"Giriş yapılıyor…","errorValidation":"Lütfen e-posta ve şifrenizi girin.","errorRateLimit":"Çok fazla deneme yapıldı. Lütfen daha sonra tekrar deneyin.","errorInvalid":"E-posta veya şifre hatalı."},"nav":{"dashboard":"Genel Bakış","messages":"Mesajlar","articles":"Makaleler","analytics":"Ziyaret Analizi","password":"Şifre Değiştir","logout":"Çıkış Yap","viewSite":"Siteyi görüntüle"},"dashboard":{"title":"Genel Bakış","welcome":"Hoş geldiniz, {name}.","messagesStat":"Okunmamış mesaj","articlesStat":"Yayımlanan makale","translationTitle":"Çeviri Durumu","translationLead":"Her makale grubunun hangi dillerde yayımlandığını gösterir.","statusPublished":"Yayımlandı","statusDraft":"Taslak","statusMissing":"Yok","articlesComingSoon":"Makaleleri eklemek, düzenlemek ve silmek için sol menüdeki “Makaleler” sayfasını kullanabilirsiniz."},"articlesPage":{"title":"Makaleler","newArticle":"Yeni Makale","titleColumn":"Başlık","localeColumn":"Dil","statusColumn":"Durum","updatedColumn":"Son Güncelleme","statusPublished":"Yayımlandı","statusDraft":"Taslak","empty":"Henüz makale yok."},"articleForm":{"back":"Tüm makaleler","newTitle":"Yeni Makale","editTitle":"Makaleyi Düzenle","locale":"Dil","status":"Durum","statusDraft":"Taslak","statusPublished":"Yayımlandı","title":"Başlık","slug":"Adres (Slug)","slugHint":"Sayfanın adres çubuğunda görünecek kısım. Türkçe karakterler otomatik düzeltilir (ş→s, ğ→g gibi); Arapça başlıklarda kendiniz İngilizce harflerle yazın.","summary":"Özet","content":"İçerik (Markdown)","contentHint":"Ara başlıklar için ## (H2) veya ### (H3), kalın için **kalın** gibi Markdown biçimlendirmesi kullanabilirsiniz. Tek # (H1) kullanmayın - sayfanın tek H1'i makale başlığıdır ve tek # ile yazılan başlıklar içindekiler tablosunda görünmez.","categories":"Kategoriler","create":"Makaleyi Oluştur","save":"Kaydet","submitting":"Kaydediliyor…","delete":"Makaleyi Sil