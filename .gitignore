# dependencies
node_modules/
/.tools/
.pnp
.pnp.js

# next.js
# `.next/` is deliberately NOT ignored - see the committed copy's own note
# and README section 7. The target host cannot run `next build` at all
# (a hard process/thread cap on the account crashes it), so the build output
# is produced elsewhere and shipped via git instead of built on the server.
/out/
next-env.d.ts

# Next's own build cache (~150MB, next build's incremental-compile cache) -
# never needed at runtime, unlike the rest of .next/ above.
/.next/cache/
/.next/trace
/.next/diagnostics/
# OneDrive conflict copies are not valid deployment artifacts.
/.next/**/*-DESKTOP-*

# production
/build

# database (schema + migrations ARE committed; the data file is not)
*.db
*.db-journal
*.db-wal
*.db-shm
/prisma/dev.db*
/data/

# uploads written at runtime by the admin editor
/public/uploads/*
!/public/uploads/.gitkeep

# env
# Broad on purpose, after `.env.bak.1788525796` (a one-off manual backup
# copy, outside the three specific patterns below) was committed in the
# repo's first commit and sat in this public GitHub repo for weeks before
# being caught (22 Ekim 2026) - see the security note in README section 1.
# `!.env.example` is the one deliberate exception: it is a template with no
# real secrets, meant to be committed.
.env
.env.local
.env.*.local
.env.*
!.env.example

# misc
.DS_Store
Thumbs.db
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vscode/*
!.vscode/extensions.json
.idea/

# typescript
*.tsbuildinfo

# testing / coverage
/coverage
