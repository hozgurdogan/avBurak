# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database -----------------------------------------------------------
# MySQL, as provisioned by cPanel's "MySQL Databases" tool. cPanel prefixes
# both the database name and the database user with your cPanel account name
# (e.g. a database called `hukuk` under account `buoheukuk` becomes
# `buoheukuk_hukuk`) - use the prefixed names here, exactly as shown on the
# "Add User To Database" screen. On the server itself the host is always
# `localhost`; MySQL is not reachable from outside the server unless you
# explicitly allow it under "Remote MySQL".
#   mysql://CPANELUSER_DBUSER:PASSWORD@localhost:3306/CPANELUSER_DBNAME
#
# Shared-hosting MySQL instances often cap total connections in the low tens
# across every app and every cPanel user on the box. Prisma's default pool
# size scales with CPU count, which can be too many on a shared box; pin it
# explicitly with `connection_limit` if you see "too many connections" errors:
#   mysql://user:pass@localhost:3306/dbname?connection_limit=5&pool_timeout=10
DATABASE_URL="mysql://cpaneluser_hukuk:CHANGE_ME@localhost:3306/cpaneluser_hukuk"

# --- Site ------------------------------------------------------------------
# Canonical origin, no trailing slash. Used for canonical URLs, hreflang,
# sitemap.xml, robots.txt and OG image absolute URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Authentication ---------------------------------------------------------
# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="CHANGE_ME_generate_a_long_random_secret"

# Session lifetime in seconds (default 8 hours).
SESSION_MAX_AGE="28800"

# --- Seed admin (read by prisma/seed.ts only) -------------------------------
# The seed script refuses to run with the placeholder password below.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="Burak Ugur Ozturk"
SEED_ADMIN_PASSWORD="CHANGE_ME_before_seeding"

# --- Privacy -----------------------------------------------------------------
# Salt used to hash visitor IPs before storing them (KVKK data minimisation:
# the raw IP is never written to disk). Rotate to invalidate all stored hashes.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT="CHANGE_ME_random_hex_salt"

# --- Practice details shown in the footer / JSON-LD --------------------------
# Placeholders must be replaced with the real registration data before launch.
NEXT_PUBLIC_BAR_ASSOCIATION="Istanbul Barosu"
NEXT_PUBLIC_BAR_REGISTRY_NO="PLACEHOLDER"
NEXT_PUBLIC_OFFICE_PHONE="+902120000000"
NEXT_PUBLIC_OFFICE_WHATSAPP="+905000000000"
NEXT_PUBLIC_OFFICE_EMAIL="info@example.com"

# --- cPanel Node.js App (Passenger) -----------------------------------------
# Passenger sets PORT itself when it starts server.js - you do not set this by
# hand in normal operation. It is documented here only because server.js reads
# it as a fallback for local `node server.js` runs outside Passenger.
# PORT="3000"
